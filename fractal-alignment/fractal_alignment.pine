//@version=6
indicator("Fractal Alignment", shorttitle = "Fractal Alignment", overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500, calc_bars_count = 1000)

//#region [INPUTS]
// Every setting, grouped in display order. Inputs added later sit at the very end of this region (after
// tbl_text_color) and are moved into their group on screen with group / inline.
// TradingView stores settings by position (in_0, in_1 ...): adding or removing an input shifts every later one.

grpAlerts       = 'Alerts Settings'
showAlerts      = input.bool(true, 'Alerts?', group = grpAlerts, tooltip = "Master switch for every alert of this indicator.\n\nTo create one: click the three dots next to the indicator name (or right-click it on the chart) > Add alert > Create. Condition: Any alert() function call. A CISD, Early CISD or SMT alert comes when the chart candle closes through the level, so a wick that comes back does not alert. Alerts keep the settings they were created with; after changing these, create the alert again.")
modelAlerts     = input.bool(true, 'Model Candles?', group = grpAlerts, tooltip = 'A full model: a C2 or C3 closure with its CISD, or its continuation. The alert says Candle 2, Candle 3 or Candle 4.')
earlyCisdAlerts = input.bool(false, 'Early CISD?', group = grpAlerts, tooltip = 'A CISD before the HTF candle has closed. The alert says Potential Candle 2.')
smtAlerts       = input.bool(true, 'SMT Divergence?', group = grpAlerts, tooltip = 'A correlated pair disagrees while a model runs: after C2 closes, the pair goes past its own C2 extreme while price does not.')
protAlerts      = input.bool(true, 'Protected Swings?', group = grpAlerts, tooltip = 'A new protected swing (continuation dot) after the reversal CISD.')

grpWarn  = 'Warnings and Error Messages'
showWarn = input.bool(true, 'Show?', group = grpWarn, tooltip = 'Shows a short message on the chart when something cannot work: the chart timeframe does not fit the selected fractal, or a correlated pair has no data.')

grpModel    = 'General Settings'
showHistory = input.int(1, 'History', minval = 0, maxval = 40, group = grpModel, tooltip = 'How many earlier setups stay drawn next to the latest one. 0 = only the latest.')
modelType   = input.string('Automatic', 'Fractal', options = ['Automatic', 'Custom', '1s-1m', '15s-5m', '1m-15m', '3m-30m', '5m-1H', '15m-4H', '1H-1D', '4H-1W', '1D-1M'], group = grpModel, inline = 'fractal')
showC2      = input.bool(true, 'C2', group = grpModel, inline = 'fractal')
showC3      = input.bool(true, 'C3', group = grpModel, inline = 'fractal')
showC4      = input.bool(true, 'C4', group = grpModel, inline = 'fractal', tooltip = "Fractal: chart timeframe - model HTF. Automatic picks it from the chart (1m - 15m, 5m - 1H, 15m - 4H, 30m - 4H, 1H - 1D, 4H - 1W ...).\n\nC2: C2 closure models (C2 takes C1's high / low and closes back inside). C3: C3 closure models (C2 took C1 without closing back, C3 closes beyond C2's body without taking C2's extreme). C4: the C4 continuation (its T-Spot). A model is only drawn once its CISD confirms.")
customLTF   = input.timeframe('60', 'Custom Fractal', group = grpModel, inline = 'custom', active = modelType == 'Custom')
customHTF   = input.timeframe('1D', '-', group = grpModel, inline = 'custom', active = modelType == 'Custom', tooltip = 'Only used when Fractal is Custom: the entry timeframe and the HTF the model runs on.')
biasFilter  = input.string('Neutral', 'Bias', options = ['Neutral', 'Bullish', 'Bearish', 'Auto Bias 1', 'Auto Bias 2'], group = grpModel, tooltip = 'Neutral: bullish and bearish setups. Bullish / Bearish: only setups of that side are shown.\n\nAuto Bias 1 / 2: follows the fractal model one / two steps higher (on 5m-1H: 15m-4H / 1H-1D). While that model runs (C3 and C4, or C4 for a C3 model, until its extreme is closed through) only setups in its direction are shown; with no higher model no setups are shown.')

grpCandles     = 'HTF Candles'
htfCandleCount = input.int(4, 'HTF Candles', minval = 4, maxval = 40, group = grpCandles, tooltip = 'Candles in the model block (the HTF of the fractal), 4 to 40. At least 4: the model needs C1 to C4. HTF 1 / HTF 2 have their own count.')
htfSize        = input.string('Normal', 'Size', options = ['Small', 'Normal', 'Large'], group = grpCandles, inline = 'size')
hideHtf        = input.bool(false, 'Hide?', group = grpCandles, inline = 'size')
hideSetups     = input.bool(false, 'Hide Setups?', group = grpCandles, inline = 'size', tooltip = 'Hide?: hides the model HTF candles on the right (HTF 1 / HTF 2 stay if they are on).\n\nHide Setups?: no models on the chart (C2 / C3 / C4, CISD, T-Spots, protected swings, chart SMT, projections, formation liquidity, early CISD), and no model alerts. The HTF candles and their lines stay.')
showX1         = input.bool(false, 'HTF 1', group = grpCandles, inline = 'xhtf1')
x1Sel          = input.string('Auto', '', options = ['Auto', '15m', '30m', '1H', '90m', '4H', '6H', '7H', 'D', 'W', 'M'], group = grpCandles, inline = 'xhtf1', active = showX1)
showX2         = input.bool(false, 'HTF 2', group = grpCandles, inline = 'xhtf2')
x2Sel          = input.string('Auto', '', options = ['Auto', '15m', '30m', '1H', '90m', '4H', '6H', '7H', 'D', 'W', 'M'], group = grpCandles, inline = 'xhtf2', active = showX2, tooltip = 'Extra HTF candles to the right of the model HTF candles, with its title (HTF Label / Remaining Time) above and / or below each block.\n\nAuto: HTF 1 = one step above the model HTF, HTF 2 = one step above HTF 1 (1m-15m: 1H / 4H, 5m-1H: 4H / D, 15m-4H: D / W, 1H-1D: W / M). 90m, 6H and 7H are never picked by Auto.\n\nNo model runs on them; they show Previous EQ, Candle 1 Sweep, SMT and PSP like the model block (HTF Open only on the model block), with the same settings. The number next to each: how many candles that block shows (1 to 10).')
candleOffsetIn = input.int(0, 'Offset', minval = 0, maxval = 100, group = grpCandles, tooltip = 'Extra empty bars between the last chart candle and the HTF candles.')
bullBody       = input.color(color.rgb(255, 255, 255), 'Body', group = grpCandles, inline = 'body')
bearBodyIn     = input.color(#000000, '', group = grpCandles, inline = 'body')
borderBullIn   = input.color(#000000, 'Border', group = grpCandles, inline = 'border')
borderBearIn   = input.color(#000000, '', group = grpCandles, inline = 'border')
wickBullIn     = input.color(#000000, 'Wick', group = grpCandles, inline = 'wick')
wickBearIn     = input.color(#000000, '', group = grpCandles, inline = 'wick', tooltip = 'Body, Border, Wick: left bullish, right bearish.')

htfOpenColor = input.color(color.new(#787b86, 20), '', group = grpCandles, inline = 'htfopen')
showHtfOpen  = input.bool(true, 'HTF Open', group = grpCandles, inline = 'htfopen')
htfOpenStyle = input.string('Solid', '', options = ['Solid', 'Dashed', 'Dotted'], group = grpCandles, inline = 'htfopen')
htfOpenWidth = input.int(1, 'Width', minval = 1, group = grpCandles, inline = 'htfopen')

lineColor  = input.color(color.new(#787b86, 75), '', group = grpCandles, inline = 'vline')
showVlines = input.bool(true, 'Vertical Lines', group = grpCandles, inline = 'vline')
lineStyle  = input.string('Solid', '', options = ['Solid', 'Dashed', 'Dotted'], group = grpCandles, inline = 'vline')
lineWidth  = input.int(1, 'Width', minval = 1, group = grpCandles, inline = 'vline')

lhColor = input.color(color.new(#787B86, 40), '', group = grpCandles, inline = 'lh')
showLH  = input.bool(false, 'L/H Lines', group = grpCandles, inline = 'lh')
lhStyle = input.string('Dotted', '', options = ['Solid', 'Dashed', 'Dotted'], group = grpCandles, inline = 'lh')
lhWidth = input.int(1, 'Width', minval = 1, group = grpCandles, inline = 'lh')

prevEqColor = input.color(#787b86, '', group = grpCandles, inline = 'peq')
showPrevEq  = input.bool(true, 'Previous EQ', group = grpCandles, inline = 'peq')
prevEqStyle = input.string('Dotted', '', options = ['Solid', 'Dashed', 'Dotted'], group = grpCandles, inline = 'peq')
prevEqWidth = input.int(1, 'Width', minval = 1, group = grpCandles, inline = 'peq')

drawType = input.string('Both', 'Drawings Type', options = ['On Chart', 'HTF Candle', 'Both'], group = grpCandles, tooltip = "Where HTF Open and Previous EQ are drawn.\n\nOn Chart: from the open of the current HTF candle to the last bar.\nHTF Candle: on the HTF candles on the right.\nBoth: one line from the chart to the HTF candles.\n\nL/H Lines (the high and low of each HTF candle, over its own period) and vertical lines are drawn on the chart when turned on, whatever this setting.")

grpTime       = 'HTF Candles Time Labels'
showHtfStamps = input.bool(true, 'Enable Time Labels?', group = grpTime, tooltip = 'Open time under each HTF candle: the day name for daily, the date for weekly (NOV 2), the month for monthly.')
timeFormat    = input.string('24h', 'Time Format', options = ['24h', '12h'], group = grpTime)
useCustomTz   = input.bool(false, 'Custom Timezone? UTC', group = grpTime, inline = 'tz')
tzHour        = input.int(1, '', minval = -12, maxval = 14, group = grpTime, inline = 'tz', active = useCustomTz)
tzMin         = input.int(0, ':', minval = 0, maxval = 59, group = grpTime, inline = 'tz', active = useCustomTz, tooltip = 'Off: New York time. On: this UTC offset, e.g. 3 : 0 for Turkey.')
showHtfName   = input.bool(true, 'HTF Label', group = grpTime, inline = 'hname')
showHtfTimer  = input.bool(true, 'Remaining Time', group = grpTime, inline = 'hname')
htfNamePos    = input.string('Top', '', options = ['Both', 'Top', 'Bottom'], group = grpTime, inline = 'hname', tooltip = 'Over and / or under each block of HTF candles: its timeframe and the time left until the forming candle closes, e.g. 1H (12:40).')
htfInfoColor  = #787b86   // HTF time labels and time left (mid gray)
htfNameColorL = #2a2e39   // HTF block timeframe name (dark, bold)

grpVisuals      = 'Model Style'
showEarlyCisd   = input.bool(false, 'Show Early C2 CISD', group = grpVisuals, inline = 'early')
earlyCisdStyle  = input.string('Dotted', '', options = ['Solid', 'Dashed', 'Dotted'], group = grpVisuals, inline = 'early', active = showEarlyCisd, tooltip = 'Early CISD: price closes through the CISD level while C2 is still forming, before the C2 candle closes. Drawn in the Bullish / Bearish CISD colors, along with the forming C2 reversal SMT and protected swings (in this line style) until C2 closes. Its alert is Early CISD? in Alerts Settings.')

cisdBullColor = input.color(#2962ff, '', group = grpVisuals, inline = 'bullcisd')
showBullCisd  = input.bool(true, 'Bullish CISD', group = grpVisuals, inline = 'bullcisd')
cisdBullStyle = input.string('Solid', '', options = ['Solid', 'Dashed', 'Dotted'], group = grpVisuals, inline = 'bullcisd', active = showBullCisd)
cisdBullWidth = input.int(2, 'Width', minval = 1, group = grpVisuals, inline = 'bullcisd', active = showBullCisd)

cisdBearColor = input.color(#f23645, '', group = grpVisuals, inline = 'bearcisd')
showBearCisd  = input.bool(true, 'Bearish CISD', group = grpVisuals, inline = 'bearcisd')
cisdBearStyle = input.string('Solid', '', options = ['Solid', 'Dashed', 'Dotted'], group = grpVisuals, inline = 'bearcisd', active = showBearCisd)
cisdBearWidth = input.int(2, 'Width', minval = 1, group = grpVisuals, inline = 'bearcisd', active = showBearCisd)

eqColor = input.color(#787b86, '', group = grpVisuals, inline = 'eq')
showEQ  = input.bool(true, 'Candle Equilibrium', group = grpVisuals, inline = 'eq')
eqStyle = input.string('Dotted', '', options = ['Solid', 'Dashed', 'Dotted'], group = grpVisuals, inline = 'eq')
eqWidth = input.int(1, 'Width', minval = 1, group = grpVisuals, inline = 'eq', tooltip = 'Line inside the T-Spot box: the middle of the previous HTF candle.')

sweepColorIn = input.color(#000000, '', group = grpVisuals, inline = 'sweep')
showSweep    = input.bool(true, 'Candle 1 Sweep', group = grpVisuals, inline = 'sweep')
sweepStyle   = input.string('Solid', '', options = ['Solid', 'Dashed', 'Dotted'], group = grpVisuals, inline = 'sweep')
sweepWidth   = input.int(1, 'Width', minval = 1, group = grpVisuals, inline = 'sweep')
sweepDisplay = input.string('Both', 'C1 Sweep Display', options = ['Both', 'Chart', 'HTF Candles'], group = grpVisuals, tooltip = "Chart: line from the C1 high / low that C2 took, to where C2 closed.\nHTF Candles: the same on the HTF candles, plus a live line while the forming candle has taken the previous one and is back inside its range.\nBoth: both.")

showLabels  = input.bool(true, 'Show Labels?', group = grpVisuals, inline = 'lbl')
labelSize   = input.string('Small', '', options = ['Tiny', 'Small', 'Normal', 'Large', 'Huge'], group = grpVisuals, inline = 'lbl', active = showLabels)
c2c3c4ColorL = #2a2e39   // C2 / C3 / C4 label text

showTSpot      = input.bool(true, 'T-Spot', group = grpVisuals, inline = 'tspot')
tSpotBullColor = input.color(color.new(#787b86, 90), 'Bullish', group = grpVisuals, inline = 'tspot')
tSpotBearColor = input.color(color.new(#787b86, 90), 'Bearish', group = grpVisuals, inline = 'tspot')

grpProt       = 'Protected Swings'
showIcCisd    = input.bool(true, 'Enable Protected Swings?', group = grpProt, inline = 'proton', tooltip = "Continuations after the CISD. A swing is protected when it traded into a fair value gap in the setup's direction or took an earlier untaken swing, and price then closes through the opposite candles that led into it: a dot on the swing, plus a line (Style / Width) at the level that was closed through. A dot turns gray once price trades back through the swing and stays until the setup leaves the history.")
protStyle     = input.string('Solid', 'Style', options = ['Solid', 'Dashed', 'Dotted'], group = grpProt, inline = 'protsty', active = showIcCisd)
protWidth     = input.int(1, 'Width', minval = 1, group = grpProt, inline = 'protsty', active = showIcCisd)
protBullColor = input.color(#2962ff, 'Bullish', group = grpProt, inline = 'protclr', active = showIcCisd)
protBearColor = input.color(#f23645, 'Bearish', group = grpProt, inline = 'protclr', active = showIcCisd)

grpSmt        = 'Asset Correlation'
show_smt      = input.bool(true, 'Enable SMT?', group = grpSmt, inline = 'smt', tooltip = 'SMT = this symbol and a correlated one disagree at the same level: one takes the previous high (or low), the other does not. Its alert is SMT Divergence? in Alerts Settings.')
smtDisplay    = input.string('Both', 'SMT Display', options = ['Both', 'Chart', 'HTF Candles'], group = grpSmt, tooltip = 'Chart: only for setups. The reversal SMT from the C1 to the C2 high / low, and the continuation SMT: after C2 a pair goes beyond the high / low of its own C2 candle while we do not; the line runs from our C2 extreme and its end follows our further highs / lows.\nHTF Candles: between the HTF candles on the right, the forming candle included.')
smtLabels     = input.bool(true, 'Labels?', group = grpSmt, inline = 'smtlbl')
smtLblSize    = input.string('Small', '', options = ['Tiny', 'Small', 'Normal', 'Large'], group = grpSmt, inline = 'smtlbl', active = smtLabels, tooltip = 'On the chart the label names the pair that made the SMT. The HTF candles show the line only.')
pairMode      = input.string('Automatic', 'Correlated Pairs', options = ['Automatic', 'Custom'], group = grpSmt, inline = 'pairs')
useSecondPair = input.bool(true, 'Enable Second Pair?', group = grpSmt, inline = 'pairs', tooltip = "Automatic:\nFutures (micros too): NQ / ES / YM with each other, RTY ↔ YM, GC / SI ↔ the same metal in EUR + GBP, CL / RB / HO with each other, FDAX / FESX / Z (FTSE) with each other, 6E / 6B ↔ each other + DXY (inverse), 6A ↔ 6N, BTC ↔ ETH\nCFD (same broker): US100 / US500 / US30 with each other, GER40 / UK100 / EU50 with each other, XAUUSD / XAGUSD ↔ EUR + GBP, EURUSD / GBPUSD and AUDUSD / NZDUSD ↔ each other + DXY (inverse), USDJPY / USDCHF / USDCAD ↔ DXY, GBPJPY ↔ EURJPY, oil ↔ gasoline + heating oil, BTC ↔ ETH and similar\n\nCustom: the two symbols below.")
pair1In       = input.symbol('CME_MINI:ES1!', '1.', group = grpSmt, inline = 'p1', active = pairMode == 'Custom')
pair1Inv      = input.bool(false, 'Inverse?', group = grpSmt, inline = 'p1', active = pairMode == 'Custom', tooltip = 'Inverse: the pair moves opposite to this symbol (e.g. DXY against EURUSD). Its highs are compared with your lows.')
pair2In       = input.symbol('CME_MINI:NQ1!', '2.', group = grpSmt, inline = 'p2', active = pairMode == 'Custom' and useSecondPair)
pair2Inv      = input.bool(false, 'Inverse?', group = grpSmt, inline = 'p2', active = pairMode == 'Custom' and useSecondPair)
smtBullColor  = input.color(#2962ff, '', group = grpSmt, inline = 'smtln')
smtBearColor  = input.color(#f23645, '', group = grpSmt, inline = 'smtln')
smtStyle      = input.string('Solid', 'SMT Line', options = ['Solid', 'Dashed', 'Dotted'], group = grpSmt, inline = 'smtln')
smtWidth      = input.int(1, 'Width', minval = 1, group = grpSmt, inline = 'smtln', tooltip = 'Left color: bullish SMT (at lows). Right color: bearish SMT (at highs). Used for the lines and the pair names, on the chart and on the HTF candles.')
showPsp       = input.bool(true, 'Enable PSP?', group = grpSmt, inline = 'psp')
pspMode       = input.string('Both', '', options = ['Candle 1', 'Candle 2', 'Both'], group = grpSmt, inline = 'psp', active = showPsp, tooltip = 'PSP (Precision Swing Point): the C1 or C2 candle closes a different color than the same HTF candle on a correlated pair (one bullish, one bearish). The model label then reads C2+PSP or C3+PSP. Dojis are ignored.')

grpStdDev   = 'Standard Deviation Projections'
showStdDev  = input.bool(false, 'Enable Projections?', group = grpStdDev)
stdLabels   = input.bool(true, 'Labels?', group = grpStdDev, inline = 'sdl', active = showStdDev)
stdLblSize  = input.string('Small', '', options = ['Tiny', 'Small', 'Normal', 'Large'], group = grpStdDev, inline = 'sdl', active = showStdDev and stdLabels)
stdDevCalc  = input.string('Wick', 'Type', options = ['Wick', 'Body'], group = grpStdDev, inline = 'sdt', active = showStdDev)
stdDevInput = input.string('-1, -2, -2.5, -4, -4.5', '', group = grpStdDev, inline = 'sdt', active = showStdDev, tooltip = "Levels as multiples of the C2 leg: from the CISD level to the C2 extreme (Wick: its wick, Body: its body). Negative = beyond the CISD, in the setup's direction.")
stdDevColor = input.color(color.new(#787B86, 0), '', group = grpStdDev, inline = 'sdc', active = showStdDev)
stdStyle    = input.string('Solid', '', options = ['Solid', 'Dashed', 'Dotted'], group = grpStdDev, inline = 'sdc', active = showStdDev)
stdWidth    = input.int(1, 'Width', minval = 1, group = grpStdDev, inline = 'sdc', active = showStdDev)

grpFl   = 'Formation Liquidity'
showFl  = input.bool(true, 'Enable Formation Liquidity?', group = grpFl, tooltip = 'Targets of the model: the high (bullish) or low (bearish) of the C1 candle and of the candle before it. A line starts where that high / low printed and stops at the bar that takes it.')
flColor = input.color(#9598a1, '', group = grpFl, inline = 'fl', active = showFl)
flStyle = input.string('Dotted', '', options = ['Solid', 'Dashed', 'Dotted'], group = grpFl, inline = 'fl', active = showFl)
flWidth = input.int(1, 'Width', minval = 1, group = grpFl, inline = 'fl', active = showFl)

grpTimeF      = 'Time Filter'
useTimeFilter = input.bool(false, 'Enable Time Filter?', group = grpTimeF, tooltip = 'New setups only when the model is found inside one of the checked windows (when C3 opens, or C4 for a C3 model). With no window checked, nothing is filtered.')
tfApplyBelow  = input.timeframe('60', 'Apply below', group = grpTimeF, active = useTimeFilter, tooltip = 'Only charts below this timeframe are filtered.')
tfUseTz       = input.bool(false, 'Custom Timezone? UTC', group = grpTimeF, inline = 'tftz', active = useTimeFilter)
tfTzHour      = input.int(1, '', minval = -12, maxval = 14, group = grpTimeF, inline = 'tftz', active = useTimeFilter and tfUseTz)
tfTzMin       = input.int(0, ':', minval = 0, maxval = 59, group = grpTimeF, inline = 'tftz', active = useTimeFilter and tfUseTz, tooltip = 'Off: the windows are New York time.')
f1On          = input.bool(false, 'Filter 1', group = grpTimeF, inline = 'f1', active = useTimeFilter)
f1Sess        = input.session('0200-0500', '', group = grpTimeF, inline = 'f1', active = useTimeFilter)
f2On          = input.bool(false, 'Filter 2', group = grpTimeF, inline = 'f2', active = useTimeFilter)
f2Sess        = input.session('0800-1100', '', group = grpTimeF, inline = 'f2', active = useTimeFilter)
f3On          = input.bool(false, 'Filter 3', group = grpTimeF, inline = 'f3', active = useTimeFilter)
f3Sess        = input.session('1330-1615', '', group = grpTimeF, inline = 'f3', active = useTimeFilter)


// [ADR] average daily range + current daily range, shown in the Info Table
grpAdr       = 'ADR / CDR'
adrShow      = input.bool(true, 'Show in Info Table', group = grpAdr, inline = 'adrtbl')
adrLen       = input.int(14, 'Length', minval = 1, maxval = 100, group = grpAdr, inline = 'adrtbl', tooltip = 'ADR = average high-low of this many completed days (today excluded). CDR = today\'s high-low so far, with its share of ADR. A day starts 18:00 New York (forex 17:00), on every broker. Forex in pips, the rest in price points.')
adrLinesShow = input.bool(false, 'ADR+ / ADR- Lines', group = grpAdr, inline = 'adrln', tooltip = 'ADR+ = today\'s low + ADR, ADR- = today\'s high - ADR: how far the day can still reach if it makes a full average range. Drawn for the current day only.')
adrLineColor = input.color(#b2b5be, '', group = grpAdr, inline = 'adrln')
adrLineStyle = input.string('Dashed', '', options = ['Solid', 'Dashed', 'Dotted'], group = grpAdr, inline = 'adrln')

grpInfo        = 'Info Table'
tbl_show       = input.bool(true, 'Show Info?', group = grpInfo, inline = 'info')
tbl_style      = input.string('Text', '', options = ['Table', 'Text'], group = grpInfo, inline = 'info')
tbl_text_size  = input.string('Tiny', '', options = ['Tiny', 'Small', 'Normal', 'Large'], group = grpInfo, inline = 'info')
tbl_border     = input.bool(false, 'Border?', group = grpInfo, inline = 'info', tooltip = 'Table: with a background. Text: text only. Border?: a frame around it.\n\nRows: symbol (timeframe), model, time to close, bias, time filter (only when it is on), SMT pairs, ADR + CDR %, date.')
tbl_pos_vert   = input.string('Bottom', 'Table Location', options = ['Top', 'Middle', 'Bottom'], group = grpInfo, inline = 'tblpos')
tbl_pos_horiz  = input.string('Right', '', options = ['Left', 'Center', 'Right'], group = grpInfo, inline = 'tblpos')
tbl_asset      = input.bool(true, 'Asset', group = grpInfo, inline = 'r1')
tbl_ctf        = input.bool(true, 'Chart Timeframe', group = grpInfo, inline = 'r1')
tbl_fractal    = input.bool(true, 'Fractal', group = grpInfo, inline = 'r2')
tbl_ttc        = input.bool(true, 'Time to Close', group = grpInfo, inline = 'r2')
tbl_bias       = input.bool(true, 'Bias', group = grpInfo, inline = 'r3')
tbl_tfilter    = input.bool(true, 'Time Filter', group = grpInfo, inline = 'r3')
tbl_smt        = input.bool(true, 'SMT Ticker(s)', group = grpInfo, inline = 'r4')
tbl_date       = input.bool(false, 'Date', group = grpInfo, inline = 'r4')
tbl_bg_colorIn = input.color(#ffffff, 'Colors', group = grpInfo, inline = 'tblclr')
tbl_text_color = input.color(#787b86, '', group = grpInfo, inline = 'tblclr')
// Added later (HTF 1 / HTF 2 candle counts, XC Labels): declared last so the stored settings of every input above keep their position;
// TradingView still shows them on the HTF 1 / HTF 2 lines (same group and inline).
x1Count        = input.int(4, '', minval = 1, maxval = 10, group = grpCandles, inline = 'xhtf1', active = showX1)
x2Count        = input.int(4, '', minval = 1, maxval = 10, group = grpCandles, inline = 'xhtf2', active = showX2)
showXcLbl      = input.bool(true, 'XC Labels', group = grpVisuals, inline = 'lbl', active = showLabels, tooltip = 'XC Labels: off = a failed model (XC2 / XC3 / XC4) leaves no label; everything else stays.')

//#endregion

//#region [CONSTANTS AND STATE]
// Derived settings (colors, candle size, where things are drawn, warm-up), the types, the global state
// (HTF candles, current models, history, dots) and the correlated pair choice.

noColor           = color.new(#000000, 100)

// Colors the drawings use: the inputs as they are (one palette, no separate dark-theme colors)
bearBody      = bearBodyIn
borderBull    = borderBullIn
borderBear    = borderBearIn
wickBull      = wickBullIn
wickBear      = wickBearIn
sweepColor    = sweepColorIn
tbl_bg_color  = tbl_bg_colorIn
htfNameColor  = htfNameColorL
c2c3c4Color   = c2c3c4ColorL
tblHeadColor  = tbl_text_color == #787b86 ? #2a2e39 : tbl_text_color
takenColor    = #b2b5be   // protected swing dot after it is taken
icBackfillMaxBars = 300
icCisdDotSize     = 'Small'

// HTF candle size: half body width and the distance between candle centers, in bars
htfHalf       = htfSize == 'Large' ? 3 : htfSize == 'Normal' ? 2 : 1
candleSpacing = htfHalf * 2 + 1

// where things are drawn
dtChart      = drawType != 'HTF Candle'
dtHtf        = drawType != 'On Chart'
sweepOnChart = showSweep and sweepDisplay != 'HTF Candles'
sweepOnHtf   = showSweep and sweepDisplay != 'Chart'
smtOnChart   = show_smt and smtDisplay != 'HTF Candles'
smtOnHtf     = show_smt and smtDisplay != 'Chart'

// The single 'Calculated bars' setting is TradingView's own (calc_bars_count above, default 1000): the script
// only sees that many bars. The first fifth (at most 500) only warm up the HTF candles; the model runs on the rest.
var int firstBar = bar_index
calcOn = bar_index - firstBar >= math.min(500, (last_bar_index - firstBar + 1) / 5)

// One candle of the model HTF block, built from the chart bars (no HTF request): OHLC, the bars of its high /
// low, its drawings on the right, and the pairs' same candle folded from their chart-timeframe bars.
type HtfCandle
    float o
    float h
    float l
    float c
    int   hBar
    int   lBar
    box   body
    line  wickUp
    line  wickDown
    line  eqLine
    int   midX
    line  sweepLine     = na
    line  sweepLineSell = na
    bool  triggerBuy    = false
    bool  triggerSell   = false
    int   openTime    = na
    label timeLbl     = na
    // [HTF SMT] each pair's extremes over this HTF candle (p = pair 1, q = pair 2) + the lines drawn for it
    float pH          = na
    float pL          = na
    float qH          = na
    float qL          = na
    float pO          = na
    float pC          = na
    float qO          = na
    float qC          = na
    label pspLbl      = na
    line  smtHLine    = na
    line  smtLLine    = na
    // [HTF SMT] role of this candle once it closed (from the raw triggers, so filters, Hide Setups and History
    // do not change it) and whether its model's XC2 / XC4 / C2 wick breach removed the block line ending on it
    // (set by htfSmtKill)
    bool  c2BearClosed = false
    bool  c2BullClosed = false
    bool  c3BearClosed = false
    bool  c3BullClosed = false
    bool  smtBearDead  = false
    bool  smtBullDead  = false
    // [LIVE SWEEP] lines on this candle's high / low while the next (forming) candle trades through them
    line  liveHiLn    = na
    line  liveLoLn    = na

type PeriodState
    float prevHigh        = na
    float prevLow         = na
    bool  prevC2Buy       = false
    bool  prevC2Sell      = false

type StdDevData
    array<label> labels
    array<line>  lines

// One protected swing: the dot at the swing and the line at the level that was closed through.
// taken = price wicked beyond it (gray dot); frozen = its color no longer changes (see icMarkTakenAll).
type ICCisd
    float extremePrice
    bool  taken    = false
    label dotLbl   = na
    bool  isBull   = false
    line  ln       = na
    bool  frozen   = false
    int   swBar    = na
    int   liveHtf  = na   // open time of the HTF candle that was forming when its model stopped (C5 after C4, or the candle of a replacement / XC2); the dot freezes when that candle closes
    int   formNum  = na   // HTF candle count when the dot printed (registerIcCisd); it can grey until the next HTF candle closes
    bool  noEarly  = false // its model's C4 was suppressed: only the liveHtf limit applies

// One model (C2 closure or C3 closure). extreme / c2BarIndex = the C2 extreme (the swing) and its bar.
// phase: 1 = in C3, 2 = in C4 (a C3 model starts here), 0 = finished. dead = XC2 or pushed out of the history.
type C2Setup
    bool  isBull
    float extreme
    int   phase     = 1
    bool  dead      = false
    label c2Lbl
    int   c2BarIndex    = na
    line  c1SweepLn     = na
    box   c3Box     = na
    line  c3Dash    = na
    float cisdLevel     = na
    int   cisdIndex     = na
    bool  cisdConfirmed = false
    line  cisdLine      = na
    int   cisdEndIndex  = na
    StdDevData stdDevData = na
    box   c4Box     = na
    line  c4Dash    = na
    label c4Lbl     = na
    float c4Top     = na
    float c4Bottom  = na
    bool  c4Invalid = false
    bool  c4Suppressed = false   // a newer opposite model's C3 runs in this candle: no C4 box / EQ / label
    int   c4InvBar  = na
    bool  justConfirmed = false
    array<ICCisd> icList = na
    // [SMT] continuation SMT (SMT section): pairs' extreme around our C2 extreme (ref) and since then
    // (run), our own extreme since then (own*), and the line whose end slides with it
    bool         csInit   = false
    int          csStart  = na   // first bar after the C2 candle (C3 model: C3's open)
    float        csRun1   = na
    float        csRun2   = na
    bool         csDiv    = false
    bool         csTook   = false   // our price reached the C2 extreme before any divergence
    bool         csAlerted = false  // the continuation SMT alert went out (also without a chart line)
    float        csOwnPx  = na
    int          csOwnBar = na
    line         csLn     = na
    label        csLb     = na
    float        c2P1     = na   // each pair's own C2 candle low (bullish) / high (bearish)
    float        c2P2     = na
    bool  icPending       = false
    float icLevel         = na
    int   icStartIndex    = na
    float icExtreme       = na
    int   icExtremeIndex  = na
    float c3Extreme = na
    float c3Hi      = na   // C3's range (C4 protected swings inside it need not beat the last dot)
    float c3Lo      = na
    bool  icStopped = false
    // [SMT] chart SMT lines of this setup (reversal at C2, continuations after the CISD)
    array<line>  smtLns  = na
    array<label> smtLbls = na
    bool         smtGone = false   // its SMT lines were removed for good (smtClear: C2 wick breach up to the end of C5, XC4, or a newer model printed)
    int          smtHtf0 = na      // HTF candle count when the setup formed
    int          endBar  = na      // bar on which C4 closed (the model finished)
    HtfCandle    smtC2   = na      // its C2 / C3 candles in the HTF block (their block SMT lines go with the model)
    HtfCandle    smtC3   = na
    // [REVEAL] nothing is drawn until the CISD confirms; what to draw then
    bool   revealed = false
    bool   c3Model  = false
    string tag      = 'C2'
    float  c1Px     = na
    int    c1Bar    = na
    int    sweepEnd = na
    bool   smtHit   = false
    string smtTxt   = ''
    int    c3Start  = na
    float  c3Top    = na
    float  c3Bot    = na
    float  c3Mid    = na
    int    c4Start  = na
    // [LABEL] where the model label prints when it is not the swing (C3 model: C3's extreme)
    int    lblBar   = na
    float  lblPx    = na
    // [C3 LINE] C3 model: dotted line at C3's extreme, from its bar to the end of C4
    int    c3LnBar  = na
    line   c3Ln     = na
    float  c4Mid    = na
    // [FORMATION LIQUIDITY] target-side extremes of C1 (1) and the candle before it (0)
    float  fl1Px    = na
    int    fl1Bar   = na
    float  fl0Px    = na
    int    fl0Bar   = na
    // once a newer revealed model of the same direction replaces it in history, its lines end at the bar that took
    // them or where it formed (C3's open; C4's open for a C3 model), whichever comes first: fixed by flEndNow in newSetup
    int    fl1EndH  = na
    int    fl0EndH  = na
    // [EARLY C2] temporary setup while C2 is still forming (never enters setupRecords or icDots)
    bool   early    = false

type SetupRecord
    C2Setup setup
    int     creationBar

type EarlyCisdRecord
    line  ln
    int   barIndex
    float extreme

var array<HtfCandle>        htfCandles           = array.new<HtfCandle>()
// the last candle dropped off the block (a C3 model's candle before C1)
var float goneH    = na
var float goneL    = na
var int   goneHBar = na
var int   goneLBar = na
var array<int>              htfOpenBars          = array.new<int>()   // open bars of the last HTF candles, newest first
var array<line>             vLines               = array.new<line>()
var PeriodState              state                = PeriodState.new()
var C2Setup                  buySetup             = na
var C2Setup                  sellSetup            = na
var C2Setup                  earlyBuy             = na
var C2Setup                  earlySell            = na
var bool                     earlyBullArmed       = false
var bool                     earlyBearArmed       = false
var bool                     earlyBullSmtAlerted  = false
var bool                     earlyBearSmtAlerted  = false
var array<SetupRecord>       setupRecords         = array.new<SetupRecord>()
// Protected swing dots still watched for greying (icMarkTakenAll), whatever happens to their setup;
// a dot leaves once it is taken or frozen (the drawing stays with its setup)
var array<ICCisd>            icDots               = array.new<ICCisd>()
var array<EarlyCisdRecord>   bullEarlyCisdRecords = array.new<EarlyCisdRecord>()
var array<EarlyCisdRecord>   bearEarlyCisdRecords = array.new<EarlyCisdRecord>()
var int                      htfOpenBar           = na
var line                     htfOpenLn            = na
bool                         cisdBullFiredThisBar = false
bool                         cisdBearFiredThisBar = false

allowBuy  = biasFilter != 'Bearish'
allowSell = biasFilter != 'Bullish'

// [SMT] correlated pairs. Futures -> related continuous contracts; CFDs -> related CFDs at the same broker
// (same session and price feed, so swings line up bar for bar).
smt_ticker = str.upper(syminfo.ticker)

// Futures: [pair 1, pair 2]
f_fut_pairs(string t) =>
    string f1 = ''
    string f2 = ''
    if str.startswith(t, 'MES')
        f1 := 'MNQ1!'
        f2 := 'MYM1!'
    else if str.startswith(t, 'MNQ')
        f1 := 'MES1!'
        f2 := 'MYM1!'
    else if str.startswith(t, 'MYM')
        f1 := 'MES1!'
        f2 := 'MNQ1!'
    else if str.startswith(t, 'M2K')
        // the Russell pairs with the Dow only
        f1 := 'MYM1!'
    else if str.startswith(t, 'MGC')
        f1 := 'OANDA:XAUEUR'
        f2 := 'OANDA:XAUGBP'
    else if str.startswith(t, 'SIL')
        f1 := 'OANDA:XAGEUR'
        f2 := 'OANDA:XAGGBP'
    else if str.startswith(t, 'ES')
        f1 := 'NQ1!'
        f2 := 'YM1!'
    else if str.startswith(t, 'NQ')
        f1 := 'ES1!'
        f2 := 'YM1!'
    else if str.startswith(t, 'YM')
        f1 := 'ES1!'
        f2 := 'NQ1!'
    else if str.startswith(t, 'RTY')
        f1 := 'YM1!'
    else if str.startswith(t, 'GC')
        // a metal pairs with the same metal in euro and pound
        f1 := 'OANDA:XAUEUR'
        f2 := 'OANDA:XAUGBP'
    else if str.startswith(t, 'SI')
        f1 := 'OANDA:XAGEUR'
        f2 := 'OANDA:XAGGBP'
    else if str.startswith(t, 'CL') or str.startswith(t, 'MCL')
        f1 := 'RB1!'
        f2 := 'HO1!'
    else if str.startswith(t, 'HO')
        f1 := 'CL1!'
        f2 := 'RB1!'
    else if str.startswith(t, 'RB')
        f1 := 'CL1!'
        f2 := 'HO1!'
    else if str.startswith(t, 'FDAX') or str.startswith(t, 'FDXM')
        // DAX <-> Euro Stoxx 50 + FTSE 100, like the GER40 CFD
        f1 := 'EUREX:FESX1!'
        f2 := 'ICEEUR:Z1!'
    else if str.startswith(t, 'FESX')
        f1 := 'EUREX:FDAX1!'
        f2 := 'ICEEUR:Z1!'
    else if str.startswith(syminfo.prefix, 'ICEEUR') and (t == 'Z1!' or t == 'Z2!' or str.match(t, '^Z[FGHJKMNQUVXZ][0-9]{4}$') != '')
        f1 := 'EUREX:FDAX1!'
        f2 := 'EUREX:FESX1!'
    else if str.startswith(syminfo.prefix, 'CME') and (str.startswith(t, '6E') or str.startswith(t, 'M6E'))
        f1 := 'CME:6B1!'
        f2 := 'TVC:DXY'
    else if str.startswith(syminfo.prefix, 'CME') and (str.startswith(t, '6B') or str.startswith(t, 'M6B'))
        f1 := 'CME:6E1!'
        f2 := 'TVC:DXY'
    else if str.startswith(syminfo.prefix, 'CME') and (str.startswith(t, '6A') or str.startswith(t, 'M6A'))
        f1 := 'CME:6N1!'
    else if str.startswith(syminfo.prefix, 'CME') and str.startswith(t, '6N')
        f1 := 'CME:6A1!'
    // 6J / 6S / 6C (yen, franc, Canadian dollar) have no automatic pair
    else if str.startswith(t, 'BTC')
        f1 := 'ETH1!'
    else if str.startswith(t, 'ETH')
        f1 := 'BTC1!'
    [f1, f2]

// Automatic pairs: [pair 1, pair 1 fallback, pair 2, pair 2 fallback]. Brokers name the same CFD
// differently (US500 / SPX500), so the fallback name is requested too and whichever has data is used.
f_smt_pairs(string t) =>
    [a1, b1, a2, b2] = switch t
        'US100'  => ['US500', 'SPX500', 'US30', '']
        'NAS100' => ['SPX500', 'US500', 'US30', '']
        'USTEC'  => ['US500', 'SPX500', 'US30', '']
        'US500'  => ['US100', 'NAS100', 'US30', '']
        'SPX500' => ['US100', 'NAS100', 'US30', '']
        'US30'   => ['US500', 'SPX500', 'US100', 'NAS100']
        'XAUUSD' => ['XAUEUR', 'OANDA:XAUEUR', 'XAUGBP', 'OANDA:XAUGBP']
        'GOLD'   => ['XAUEUR', 'OANDA:XAUEUR', 'XAUGBP', 'OANDA:XAUGBP']
        'XAGUSD' => ['XAGEUR', 'OANDA:XAGEUR', 'XAGGBP', 'OANDA:XAGGBP']
        'SILVER' => ['XAGEUR', 'OANDA:XAGEUR', 'XAGGBP', 'OANDA:XAGGBP']
        'EURUSD' => ['GBPUSD', '', 'TVC:DXY', '']
        'GBPUSD' => ['EURUSD', '', 'TVC:DXY', '']
        'AUDUSD' => ['NZDUSD', '', 'TVC:DXY', '']
        'NZDUSD' => ['AUDUSD', '', 'TVC:DXY', '']
        // dollar-first pairs move with the dollar index: DXY only, not inverted
        'USDJPY' => ['TVC:DXY', '', '', '']
        'USDCHF' => ['TVC:DXY', '', '', '']
        'USDCAD' => ['TVC:DXY', '', '', '']
        'GBPJPY' => ['EURJPY', '', '', '']
        'EURJPY' => ['GBPJPY', '', '', '']
        // European indices: DAX <-> FTSE 100 + Euro Stoxx 50
        'GER40'   => ['UK100', '', 'EU50', 'EUSTX50']
        'DE40'    => ['UK100', '', 'EU50', 'EUSTX50']
        'GER30'   => ['UK100', '', 'EU50', 'EUSTX50']
        'UK100'   => ['GER40', 'DE40', 'EU50', 'EUSTX50']
        'EU50'    => ['GER40', 'DE40', 'UK100', '']
        'EUSTX50' => ['GER40', 'DE40', 'UK100', '']
        'STOXX50' => ['GER40', 'DE40', 'UK100', '']
        'EURO50'  => ['GER40', 'DE40', 'UK100', '']
        'DE30EUR'  => ['UK100GBP', '', 'EU50EUR', '']
        'UK100GBP' => ['DE30EUR', '', 'EU50EUR', '']
        'EU50EUR'  => ['DE30EUR', '', 'UK100GBP', '']
        // FXCM energy CFDs, like CL1! <-> RB1! + HO1!
        'USOIL'       => ['GASOLINEF', '', 'HEATINGOILF', '']
        'GASOLINEF'   => ['USOIL', '', 'HEATINGOILF', '']
        'HEATINGOILF' => ['USOIL', '', 'GASOLINEF', '']
        // Crypto: BTC <-> ETH on the same exchange
        'BTCUSDT'   => ['ETHUSDT', '', '', '']
        'ETHUSDT'   => ['BTCUSDT', '', '', '']
        'BTCUSDT.P' => ['ETHUSDT.P', '', '', '']
        'ETHUSDT.P' => ['BTCUSDT.P', '', '', '']
        'BTCUSD'    => ['ETHUSD', '', '', '']
        'ETHUSD'    => ['BTCUSD', '', '', '']
        => ['', '', '', '']
    // GASOLINEF / HEATINGOILF exist on FXCM (FX:) only
    if (t == 'USOIL' or t == 'GASOLINEF' or t == 'HEATINGOILF') and syminfo.prefix != 'FX'
        a1 := ''
        b1 := ''
        a2 := ''
        b2 := ''
    // Brokers whose index names are known (TradingView symbol search, 9 Nov 2026): only that name is
    // requested, no fallback request (each one costs a full 5000-bar request).
    [kNq, kSp, kDj] = switch syminfo.prefix
        'FX'            => ['NAS100', 'SPX500', 'US30']
        'PEPPERSTONE'   => ['NAS100', 'US500', 'US30']
        'CAPITALCOM'    => ['NAS100', 'SPX500', 'US30']
        'FOREXCOM'      => ['NAS100', 'SPX500', 'US30']
        'FPMARKETS'     => ['US100', 'US500', 'US30']
        'TICKMILL'      => ['USTEC', 'US500', 'US30']
        'FUSIONMARKETS' => ['NAS100', 'US500', 'US30']
        'SKILLING'      => ['US100', 'SPX500', 'US30']
        => ['', '', '']
    bool tNq = t == 'US100' or t == 'NAS100' or t == 'USTEC'
    bool tSp = t == 'US500' or t == 'SPX500'
    if kNq != '' and (tNq or tSp or t == 'US30')
        a1 := tSp ? kNq : kSp
        b1 := ''
        a2 := t == 'US30' ? kNq : kDj
        b2 := ''
    // European index names per broker (TradingView symbol search, 21 Nov 2026)
    [kDe, kUk, kEu] = switch syminfo.prefix
        'FX'            => ['GER30', 'UK100', 'EUSTX50']
        'PEPPERSTONE'   => ['GER40', 'UK100', 'EUSTX50']
        'CAPITALCOM'    => ['GER40', 'UK100', 'EU50']
        'FOREXCOM'      => ['GER40', 'UK100', 'EU50']
        'FPMARKETS'     => ['GER40', 'UK100', 'EURO50']
        'TICKMILL'      => ['DE40', 'UK100', 'STOXX50']
        'FUSIONMARKETS' => ['GER40', 'UK100', 'EUSTX50']
        'SKILLING'      => ['DE40', 'UK100', 'EUSTX50']
        'EIGHTCAP'      => ['GER40', 'UK100', 'EUSTX50']
        'VANTAGE'       => ['GER40', 'UK100', 'EU50']
        'IC'            => ['DE40', 'UK100', 'STOXX50']
        => ['', '', '']
    if kDe != '' and (t == kDe or t == kUk or t == kEu)
        a1 := t == kDe ? kUk : kDe
        b1 := ''
        a2 := t == kEu ? kUk : kEu
        b2 := ''
    // FXCM has no XAUEUR / XAUGBP / XAGEUR / XAGGBP: the OANDA names directly
    if syminfo.prefix == 'FX' and str.startswith(b1, 'OANDA:')
        a1 := b1
        b1 := ''
        a2 := b2
        b2 := ''
    string pre = syminfo.prefix + ':'
    // a name with its own exchange ('OANDA:XAUEUR') is used as it is
    string p1a = a1 != '' ? (str.contains(a1, ':') ? a1 : pre + a1) : ''
    string p1b = b1 != '' ? (str.contains(b1, ':') ? b1 : pre + b1) : ''
    string p2a = a2 != '' ? (str.contains(a2, ':') ? a2 : pre + a2) : ''
    string p2b = b2 != '' ? (str.contains(b2, ':') ? b2 : pre + b2) : ''
    if p1b == p1a
        p1b := ''
    if p2b == p2a
        p2b := ''
    if p1a == '' and syminfo.type == 'futures'
        [f1, f2] = f_fut_pairs(t)
        // a dated contract (NQZ2026) pairs with the same contract of the other future (ESZ2026);
        // the continuous chart (NQ1!) keeps the continuous pairs
        string sfx = str.match(t, '[FGHJKMNQUVXZ][0-9]{4}$')
        if sfx != ''
            f1 := str.endswith(f1, '1!') ? str.replace(f1, '1!', sfx) : f1
            f2 := str.endswith(f2, '1!') ? str.replace(f2, '1!', sfx) : f2
        p1a := f1
        p2a := f2
    [p1a, p1b, p2a, p2b]

var string smtA1 = ''
var string smtB1 = ''
var string smtA2 = ''
var string smtB2 = ''
if barstate.isfirst
    [_a1, _b1, _a2, _b2] = f_smt_pairs(smt_ticker)
    smtA1 := _a1
    smtB1 := _b1
    smtA2 := _a2
    smtB2 := _b2
bool   smtCustom  = pairMode == 'Custom'
var string pair1A     = ''
var string pair1B     = ''
var string pair2A     = ''
var string pair2B     = ''
var bool   dxyInv     = false
var bool   pair1InvOn = false
var bool   pair2InvOn = false
if barstate.isfirst
    string stdTicker = ticker.standard(syminfo.tickerid)
    pair1A     := smtCustom ? (pair1In == stdTicker ? '' : pair1In) : smtA1
    pair1B     := smtCustom ? '' : smtB1
    pair2A     := not useSecondPair ? '' : smtCustom ? (pair2In == stdTicker ? '' : pair2In) : smtA2
    pair2B     := not useSecondPair or smtCustom ? '' : smtB2
    // DXY runs against a symbol quoted in dollars (EURUSD, 6E) and with a dollar-first one (USDJPY)
    dxyInv     := not str.startswith(smt_ticker, 'USD')
    pair1InvOn := smtCustom ? pair1Inv : pair1A == 'TVC:DXY' and dxyInv
    pair2InvOn := smtCustom ? pair2Inv : pair2A == 'TVC:DXY' and dxyInv

// running count of model HTF candles (incremented in [LOGIC] on each new candle); declared here so functions can
// stamp it (a protected swing dot records the candle it printed in)
var int htfNum = 0

//#endregion

//#region [FUNCTIONS]
// Helpers and the model machinery, in this order: text / size helpers, fractal timeframes, HTF candle drawing,
// early CISD, CISD + SD projections, protected swings, history, Auto Bias, Time Filter, NY day + ADR request,
// pair requests, HTF 1 / HTF 2 data, PSP, T-Spot geometry, setup SMT, early C2, the model life cycle
// (reveal, newSetup, advanceToC4, finish, extendAndCheck, checkC4Invalid, checkCisdConfirm, processSetup).

// A drawing's left end is never moved further back than the time buffer allows
xAnchor(int x) =>
    na(x) ? na : math.max(x, bar_index - 4900)

// Timeframe code -> short text ('60' -> 1H, '15' -> 15m); tfLabel falls back to this for other minute counts
customTfLabel(string tf) =>
    float  mins   = str.tonumber(tf)
    string result = tf
    if not na(mins)
        if mins >= 60 and mins % 60 == 0
            result := str.tostring(int(mins / 60)) + 'H'
        else
            result := str.tostring(int(mins)) + 'm'
    result

tfLabel(string tf) =>
    switch tf
        '1S'  => '1s'
        '15S' => '15s'
        '1'   => '1m'
        '2'   => '2m'
        '3'   => '3m'
        '5'   => '5m'
        '15'  => '15m'
        '30'  => '30m'
        '60'  => '1H'
        '120' => '2H'
        '180' => '3H'
        '240' => '4H'
        '360' => '6H'
        '480' => '8H'
        '720' => '12H'
        '1D'  => '1D'
        'D'   => '1D'
        '2D'  => '2D'
        '3D'  => '3D'
        '1W'  => '1W'
        'W'   => '1W'
        '2W'  => '2W'
        '3W'  => '3W'
        '1M'  => '1M'
        'M'   => '1M'
        '2M'  => '2M'
        '3M'  => '3M'
        '6M'  => '6M'
        '9M'  => '9M'
        '12M' => '12M'
        =>       customTfLabel(tf)

// The chart timeframe as the codes above use it (1D / 1W / 1M instead of D / W / M)
curTfCode() =>
    timeframe.isdaily and timeframe.multiplier == 1 ? '1D' : timeframe.isweekly and timeframe.multiplier == 1 ? '1W' : timeframe.ismonthly and timeframe.multiplier == 1 ? '1M' : timeframe.period

tablePosition(string vert, string horz) =>
    switch vert + '-' + horz
        'Top-Left'      => position.top_left
        'Top-Center'    => position.top_center
        'Top-Right'     => position.top_right
        'Middle-Left'   => position.middle_left
        'Middle-Center' => position.middle_center
        'Middle-Right'  => position.middle_right
        'Bottom-Left'   => position.bottom_left
        'Bottom-Center' => position.bottom_center
        'Bottom-Right'  => position.bottom_right
        =>                 position.top_right

lineStyleFromStr(string s) =>
    switch s
        'Solid'  => line.style_solid
        'Dashed' => line.style_dashed
        'Dotted' => line.style_dotted
        =>          line.style_dashed

textSize(string s) =>
    switch s
        'Tiny'   => size.tiny
        'Small'  => size.small
        'Normal' => size.normal
        'Large'  => size.large
        =>          size.huge

directionalLabel(int xBar, float yPrice, string txt, bool bullish, color txtColor = na) =>
    color useColor = na(txtColor) ? c2c3c4Color : txtColor
    label.new(xBar, yPrice, text = txt, xloc = xloc.bar_index, yloc = yloc.price, style = bullish ? label.style_label_up : label.style_label_down, color = na, textcolor = useColor, size = textSize(labelSize), text_font_family = font.family_default)

// One step smaller than a size setting (used for the HTF time stamps)
smallerSize(string s) =>
    switch s
        'Huge'   => size.large
        'Large'  => size.normal
        'Normal' => size.small
        =>          size.tiny

pad2(int v) =>
    v < 10 ? '0' + str.tostring(v) : str.tostring(v)

// 01:00:00 style countdown for the info table (hours always shown)
formatHms(int ms) =>
    if na(ms)
        '--:--:--'
    else
        totalSec = int(math.max(ms, 0) / 1000)
        dd = int(totalSec / 86400)
        hh = int((totalSec % 86400) / 3600)
        mm = int((totalSec % 3600) / 60)
        ss = int(totalSec % 60)
        (dd > 0 ? str.tostring(dd) + 'd ' : '') + pad2(hh) + ':' + pad2(mm) + ':' + pad2(ss)

biggerSize(string s) =>
    switch s
        'Tiny'   => size.small
        'Small'  => size.normal
        'Normal' => size.large
        =>          size.huge

// HTF block timer: 14:39 under an hour, 3:14:39 under a day, 2d 03:14 above
formatRemaining(int ms) =>
    if na(ms)
        '--:--'
    else
        totalSec = int(math.max(ms, 0) / 1000)
        dd = int(totalSec / 86400)
        hh = int((totalSec % 86400) / 3600)
        mm = int((totalSec % 3600) / 60)
        ss = int(totalSec % 60)
        dd > 0 ? str.tostring(dd) + 'd ' + pad2(hh) + ':' + pad2(mm) : hh > 0 ? str.tostring(hh) + ':' + pad2(mm) + ':' + pad2(ss) : pad2(mm) + ':' + pad2(ss)

// UTC offset as a Pine timezone string, e.g. GMT+0300
gmtString(int h, int m) =>
    'GMT' + (h < 0 ? '-' : '+') + pad2(math.abs(h)) + pad2(m)

stampTz  = useCustomTz ? gmtString(tzHour, tzMin) : 'America/New_York'
filterTz = tfUseTz ? gmtString(tfTzHour, tfTzMin) : 'America/New_York'

// Symbol without its exchange prefix (CBOT_MINI:YM1! -> YM1!)
statusSym(string sym) =>
    str.contains(sym, ':') ? array.get(str.split(sym, ':'), 1) : sym

// Model HTF for the Automatic fractal; '' = this chart timeframe has no model
autoHTF() =>
    switch timeframe.period
        '1S'  => '1'
        '15S' => '5'
        '1'   => '15'
        '3'   => '30'
        '5'   => '60'
        '15'  => '240'
        '30'  => '240'
        '60'  => '1D'
        '240' => '1W'
        '1D'  => '1M'
        'D'   => '1M'
        '1W'  => '3M'
        'W'   => '3M'
        '1M'  => '12M'
        'M'   => '12M'
        =>       ''

ltfCode() =>
    switch modelType
        '1s-1m'  => '1S'
        '15s-5m' => '15S'
        '1m-15m' => '1'
        '3m-30m' => '3'
        '5m-1H'  => '5'
        '15m-4H' => '15'
        '1H-1D'  => '60'
        '4H-1W'  => '240'
        '1D-1M'  => '1D'
        'Custom' => customLTF
        =>          curTfCode()

// Model HTF of the selected fractal
autoTf = switch modelType
    '1s-1m'  => '1'
    '15s-5m' => '5'
    '1m-15m' => '15'
    '3m-30m' => '30'
    '5m-1H'  => '60'
    '15m-4H' => '240'
    '1H-1D'  => '1D'
    '4H-1W'  => '1W'
    '1D-1M'  => '1M'
    'Custom' => customHTF
    =>          autoHTF() == '' ? '1M' : autoHTF()

// '5m-1H': the fractal as text; every alert ends with it
modelText() =>
    tfLabel(ltfCode()) + '-' + tfLabel(autoTf)

// The label only carries PSP (C2 / C2+PSP); SMT shows as its own line and pair name
c2TagText(bool psp) =>
    'C2' + (psp ? '+PSP' : '')

// SMT color by direction: bearish at highs, bullish at lows
smtColorFor(bool isHigh) =>
    isHigh ? smtBearColor : smtBullColor

// [HTF SMT] Creates / updates / removes one divergence segment.
smtHtfSeg(line ln, bool active, int x1, float y1, int x2, float y2, bool isHigh) =>
    line l = ln
    if active
        if na(l)
            l := line.new(x1, y1, x2, y2, xloc = xloc.bar_index, color = smtColorFor(isHigh), style = lineStyleFromStr(smtStyle), width = smtWidth)
        else
            line.set_xy1(l, x1, y1)
            line.set_xy2(l, x2, y2)
            line.set_color(l, smtColorFor(isHigh))
            line.set_style(l, lineStyleFromStr(smtStyle))
            line.set_width(l, smtWidth)
    else if not na(l)
        line.delete(l)
        l := na
    l

// [LIVE SWEEP] Creates / updates / removes one live sweep line.
liveSweepLine(line ln, bool on, int x1, int x2, float y) =>
    line l = ln
    if on
        if na(l)
            l := line.new(x1, y, x2, y, color = sweepColor, style = lineStyleFromStr(sweepStyle), width = sweepWidth)
        line.set_xy1(l, x1, y)
        line.set_xy2(l, x2, y)
        line.set_color(l, sweepColor)
        line.set_style(l, lineStyleFromStr(sweepStyle))
        line.set_width(l, sweepWidth)
    else if not na(l)
        line.delete(l)
        l := na
    l

// [LIVE SWEEP] The forming candle (index 0) taking the previous candle's high or low and trading back inside its range draws the sweep
// line right away, before it closes. Older candles never keep a live line.
// Must be called AFTER the block's candles have been drawn (it needs each candle's midX).
updateLiveSweeps(array<HtfCandle> cs, bool okBuy, bool okSell) =>
    int n = cs.size()
    if n > 2
        for i = 2 to n - 1
            HtfCandle old = cs.get(i)
            old.liveHiLn := liveSweepLine(old.liveHiLn, false, 0, 0, na)
            old.liveLoLn := liveSweepLine(old.liveLoLn, false, 0, 0, na)
    if n > 0
        HtfCandle cur = cs.get(0)
        cur.liveHiLn := liveSweepLine(cur.liveHiLn, false, 0, 0, na)
        cur.liveLoLn := liveSweepLine(cur.liveLoLn, false, 0, 0, na)
    if n > 1
        HtfCandle cur = cs.get(0)
        HtfCandle prv = cs.get(1)
        // only while price is back inside the previous candle's range (swept and reclaimed)
        bool liveBear = sweepOnHtf and okSell and cur.h > prv.h and cur.c < prv.h
        bool liveBull = sweepOnHtf and okBuy and cur.l < prv.l and cur.c > prv.l
        prv.liveHiLn := liveSweepLine(prv.liveHiLn, liveBear, prv.midX, cur.midX + htfHalf * 2 + 2, prv.h)
        prv.liveLoLn := liveSweepLine(prv.liveLoLn, liveBull, prv.midX, cur.midX + htfHalf * 2 + 2, prv.l)

method delete(HtfCandle c) =>
    box.delete(c.body)
    line.delete(c.wickUp)
    line.delete(c.wickDown)
    line.delete(c.eqLine)
    line.delete(c.sweepLine)
    line.delete(c.sweepLineSell)
    label.delete(c.timeLbl)
    line.delete(c.smtHLine)
    line.delete(c.smtLLine)
    line.delete(c.liveHiLn)
    line.delete(c.liveLoLn)
    label.delete(c.pspLbl)

method update(HtfCandle c, float curH, float curL, float curC, int curBar) =>
    if curH > c.h
        c.h    := curH
        c.hBar := curBar
    if curL < c.l
        c.l    := curL
        c.lBar := curBar
    c.c := curC
    c


// Time label text under an HTF candle: month, week's date (NOV 2), day name (daily) or the open time
htfStampText(int t, string tf) =>
    tf == '12M' ? str.format_time(t + 12 * 60 * 60 * 1000, 'yyyy', stampTz) : str.endswith(tf, 'M') ? str.upper(str.format_time(t + 12 * 60 * 60 * 1000, 'MMM', stampTz)) : str.endswith(tf, 'W') ? str.upper(str.format_time(t + 12 * 60 * 60 * 1000, 'MMM d', stampTz)) : timeframe.in_seconds(tf) >= 86400 ?str.upper(str.format_time(t + 12 * 60 * 60 * 1000, 'EEE', stampTz)) : str.format_time(t, timeFormat == '12h' ? 'h:mma' : 'HH:mm', stampTz)

// Draws one HTF candle centered on bar midX; drawings are created lazily on the last bar
method draw(HtfCandle c, int midX, string tf) =>
    bool  isBull = c.c >= c.o
    float eqPx   = (c.h + c.l) / 2
    float bTop   = math.max(c.o, c.c)
    float bBot   = math.min(c.o, c.c)
    if na(c.body)
        c.body := box.new(midX - htfHalf, bTop, midX + htfHalf, bBot, border_color = isBull ? borderBull : borderBear, border_width = 1, bgcolor = isBull ? bullBody : bearBody)
    else
        box.set_left(c.body, midX - htfHalf)
        box.set_right(c.body, midX + htfHalf)
        box.set_top(c.body, bTop)
        box.set_bottom(c.body, bBot)
        box.set_bgcolor(c.body, isBull ? bullBody : bearBody)
        box.set_border_color(c.body, isBull ? borderBull : borderBear)
    if na(c.wickUp)
        c.wickUp := line.new(midX, c.h, midX, bTop, color = isBull ? wickBull : wickBear)
    else
        line.set_xy1(c.wickUp, midX, c.h)
        line.set_xy2(c.wickUp, midX, bTop)
        line.set_color(c.wickUp, isBull ? wickBull : wickBear)
    if na(c.wickDown)
        c.wickDown := line.new(midX, c.l, midX, bBot, color = isBull ? wickBull : wickBear)
    else
        line.set_xy1(c.wickDown, midX, c.l)
        line.set_xy2(c.wickDown, midX, bBot)
        line.set_color(c.wickDown, isBull ? wickBull : wickBear)
    // Previous EQ on the HTF candles: from this candle's middle to the next candle
    color eqClr = showPrevEq and dtHtf ? prevEqColor : noColor
    if na(c.eqLine)
        c.eqLine := line.new(midX, eqPx, midX, eqPx, color = eqClr, style = lineStyleFromStr(prevEqStyle), width = prevEqWidth)
    else
        line.set_xy1(c.eqLine, midX, eqPx)
        line.set_xy2(c.eqLine, midX, eqPx)
        line.set_color(c.eqLine, eqClr)
        line.set_style(c.eqLine, lineStyleFromStr(prevEqStyle))
        line.set_width(c.eqLine, prevEqWidth)
    c.midX := midX

    string timeText = htfStampText(c.openTime, tf)

    if showHtfStamps
        if na(c.timeLbl)
            c.timeLbl := label.new(midX, c.l, timeText, xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_up, color = na, textcolor = htfInfoColor, size = smallerSize(labelSize), text_font_family = font.family_default)
        else
            label.set_xy(c.timeLbl, midX, c.l)
            label.set_text(c.timeLbl, timeText)
            label.set_textcolor(c.timeLbl, htfInfoColor)
            label.set_size(c.timeLbl, smallerSize(labelSize))
    else if not na(c.timeLbl)
        label.delete(c.timeLbl)
        c.timeLbl := na
    c

// A new HTF candle opening on this bar; its drawings are created lazily by draw() on the last bar
newHtfCandle(int openT = na) =>
    HtfCandle.new(open, high, low, close, bar_index, bar_index,
         na, na, na, na,
         na, openTime = nz(openT, time))

// Close time of the forming HTF candle. time_close() came back stale for 30m / 1H on lower charts,
// so intraday timeframes use their open time + length; daily and above keep time_close().
// Weekly on a Friday trading day: time_close('W') is Sunday's open on futures / forex, so the week ends at
// the day's close instead (crypto trades through the weekend).
htfCloseTime(string tf) =>
    int sec = timeframe.in_seconds(tf)
    int t   = sec < 86400 ? time(tf) + sec * 1000 : time_close(tf)
    if sec == 604800 and syminfo.type != 'crypto' and timeframe.in_seconds() <= 86400 and dayofweek(time_tradingday, 'UTC') == dayofweek.friday
        int dClose = time_close('D')
        if not na(dClose) and not na(t)
            t := math.min(t, dClose)
    t


// [EARLY CISD] the forming candle swept the previous one and a chart bar closed through the CISD level: a line from
// the level's bar (idx) and the 'Potential Candle 2' alert. extreme = the sweep's low / high: price beyond it
// removes the line (invalidateEarlyCisd).
drawEarlyCisd(bool isBull, float level, int idx, int confirmBar, float extreme) =>
    array<EarlyCisdRecord> target = isBull ? bullEarlyCisdRecords : bearEarlyCisdRecords
    color clr = isBull ? cisdBullColor : cisdBearColor
    if showEarlyCisd and calcOn and not hideSetups
        // line only, ending one candle after the candle that closed through the level
        ln = line.new(xAnchor(idx), level, confirmBar + 1, level, color = clr, style = lineStyleFromStr(earlyCisdStyle), width = 1)
        target.push(EarlyCisdRecord.new(ln, confirmBar, extreme))
        while target.size() > 80
            line.delete(target.shift().ln)
    if showAlerts and earlyCisdAlerts and calcOn and not hideSetups
        alert((isBull ? 'Bullish' : 'Bearish') + ' Potential Candle 2 on ' + syminfo.ticker + ', ' + modelText(), alert.freq_once_per_bar_close)

// removes early CISD lines whose sweep extreme price has traded beyond (every bar)
invalidateEarlyCisd(array<EarlyCisdRecord> recs, bool isBull) =>
    if recs.size() > 0
        for i = recs.size() - 1 to 0
            rec = recs.get(i)
            if not na(rec.extreme) and (isBull ? low < rec.extreme : high > rec.extreme)
                line.delete(rec.ln)
                recs.remove(i)

// removes early CISD lines older than the oldest model in the history (called from registerRecord)
pruneEarlyCisd(array<EarlyCisdRecord> recs, int thresholdBar) =>
    if not na(thresholdBar)
        while recs.size() > 0 and recs.first().barIndex < thresholdBar
            line.delete(recs.shift().ln)

// only the line drawn for this reclaim (the newest one may belong to an earlier reclaim)
consumeLastEarlyCisd(array<EarlyCisdRecord> recs, int reclaimBar) =>
    if recs.size() > 0 and not na(reclaimBar) and recs.last().barIndex == reclaimBar
        line.delete(recs.pop().ln)

// Lowest and highest candle-body edges across the bar range [idxA, idxB]
cisdBodyBounds(int idxA, int idxB) =>
    float bLo = na
    float bHi = na
    if not na(idxA) and not na(idxB)
        int o0 = bar_index - math.min(idxA, idxB)
        int o1 = bar_index - math.max(idxA, idxB)
        if o1 >= 0 and o1 <= 1499
            for k = o1 to math.min(o0, 1499)
                float cHi = math.max(open[k], close[k])
                float cLo = math.min(open[k], close[k])
                bHi := na(bHi) ? cHi : math.max(bHi, cHi)
                bLo := na(bLo) ? cLo : math.min(bLo, cLo)
    [bLo, bHi]

parseFloats(string src) =>
    var out = array.new<float>()
    array.clear(out)
    for part in str.split(str.replace_all(src, ' ', ''), ',')
        v = str.tonumber(part)
        if not na(v)
            out.push(v)
    out


// SD projections: a short tick and a label on its left per level, at the swing bar
createStdDevProjections(C2Setup s) =>
    if showStdDev
        devs = parseFloats(stdDevInput)
        if devs.size() > 0
            level0 = s.cisdLevel
            level1 = s.extreme
            if stdDevCalc != 'Wick'
                [bLo, bHi] = cisdBodyBounds(s.cisdIndex, s.c2BarIndex)
                float bExt = s.isBull ? bLo : bHi
                if not na(bExt)
                    level1 := bExt
            int   leftBar    = xAnchor(s.c2BarIndex)
            float priceRange = s.isBull ? level0 - level1 : level1 - level0
            lbs = array.new<label>()
            lns = array.new<line>()
            for dev in devs
                devPrice = s.isBull ? level0 - priceRange * dev : level0 + priceRange * dev
                lns.push(line.new(leftBar, devPrice, leftBar + 3, devPrice, xloc = xloc.bar_index, color = stdDevColor, style = lineStyleFromStr(stdStyle), width = stdWidth))
                if stdLabels
                    lbs.push(label.new(leftBar, devPrice, str.tostring(dev), xloc = xloc.bar_index, style = label.style_label_right, color = na, textcolor = stdDevColor, size = textSize(stdLblSize), text_font_family = font.family_default))
            s.stdDevData := StdDevData.new(lbs, lns)

// Marks the setup's CISD confirmed on confirmBar and draws its CISD line + SD projections.
// live = false when it was confirmed in the past (inside C2): no CISD alert flag then.
confirmCisd(C2Setup s, int confirmBar, bool live = true) =>
    s.cisdConfirmed := true
    if live
        s.justConfirmed := true
    s.cisdEndIndex  := confirmBar
    showLine = s.isBull ? showBullCisd : showBearCisd
    clr      = s.isBull ? cisdBullColor : cisdBearColor
    lnStyle  = s.isBull ? cisdBullStyle : cisdBearStyle
    lnWidth  = s.isBull ? cisdBullWidth : cisdBearWidth
    if showLine
        // line only, ending one candle after the candle that closed through the level
        s.cisdLine := line.new(xAnchor(s.cisdIndex), s.cisdLevel, confirmBar + 1, s.cisdLevel, color = clr, style = lineStyleFromStr(lnStyle), width = lnWidth)
    createStdDevProjections(s)

// [PROTECTED SWINGS] (icStep below is the state machine). Drops the swing being watched.
icClearPending(C2Setup s) =>
    s.icPending      := false
    s.icLevel        := na
    s.icStartIndex   := na
    s.icExtreme      := na
    s.icExtremeIndex := na
    s

// Walks back from the extreme bar through consecutive opposing candles; returns [the open of the oldest one, its bar]
// (na when none within ~500 bars). bias: 1 = bullish candles (bearish setups), -1 = bearish candles (bullish setups)
icFindCisdLevel(int extremeBarIdx, int bias) =>
    int   offset     = bar_index - extremeBarIdx
    float cisdPrice  = na
    int   cisdIdx    = na
    bool  foundFirst = false
    if offset <= 1499
        for i = offset to math.min(offset + 500, bar_index, 1499)
            float cOpen  = open[i]
            float cClose = close[i]
            int   att    = cClose > cOpen ? 1 : cClose < cOpen ? -1 : 0
            if att == 0
                continue
            if not foundFirst
                if att == bias
                    foundFirst := true
                    cisdPrice  := cOpen
                    cisdIdx    := bar_index - i
            else
                if att != bias
                    break
                cisdPrice := cOpen
                cisdIdx   := bar_index - i
    [cisdPrice, cisdIdx]

// Re-anchor the IC level on the opposing run that leads into the current extreme
icRetrace(C2Setup s) =>
    [lvl, lvlIdx] = icFindCisdLevel(s.icExtremeIndex, s.isBull ? -1 : 1)
    if not na(lvl)
        s.icLevel      := lvl
        s.icStartIndex := lvlIdx
    s

// Greys out any protected swing once price has wicked beyond its extreme on bar m
icMarkTaken(C2Setup s, int m) =>
    if not na(s) and not na(s.icList) and s.icList.size() > 0
        int off = bar_index - m
        if off >= 0
            for ic in s.icList
                if not ic.taken and not ic.frozen and not na(ic.extremePrice)
                    bool sweep = s.isBull ? low[off] < ic.extremePrice : high[off] > ic.extremePrice
                    if sweep
                        ic.taken := true
                        if not na(ic.dotLbl)
                            label.set_textcolor(ic.dotLbl, takenColor)
    s

// The C4 label and the protected swing dots: when a dot sits where the C4 label prints (a few bars, about
// the same price) the label moves to the right of that dot so both stay readable
float lblDodgeTol = ta.atr(14)
c4LabelDodge(C2Setup s) =>
    if not na(s) and not na(s.c4Lbl) and not na(s.icList) and s.icList.size() > 0
        int   x  = label.get_x(s.c4Lbl)
        float y  = label.get_y(s.c4Lbl)
        int   nx = x
        for ic in s.icList
            if not na(ic.dotLbl)
                int dx = label.get_x(ic.dotLbl)
                if dx >= nx - 1 and dx <= nx + 4 and math.abs(ic.extremePrice - y) <= nz(lblDodgeTol)
                    nx := dx + 2
        if nx != x
            label.set_x(s.c4Lbl, nx)

// A confirmed protected swing at swPx / swIdx (brokeBar = the bar that closed through the level): dot + level line,
// added to the setup's list and (not for an early C2 setup) to icDots
registerIcCisd(C2Setup s, float swPx, int swIdx, int brokeBar) =>
    color  clr     = s.isBull ? protBullColor : protBearColor
    string lnStyle = s.early ? earlyCisdStyle : protStyle
    // an early C2 setup kept only for its alerts (Show Early C2 CISD off) draws nothing
    bool   drawIc  = not s.early or showEarlyCisd
    label  dotLbl  = not drawIc ? na : label.new(xAnchor(swIdx), swPx, '●', xloc = xloc.bar_index, style = s.isBull ? label.style_label_up : label.style_label_down, color = na, textcolor = clr, size = textSize(icCisdDotSize), text_font_family = font.family_default)
    // the level price closed through to confirm the swing; like the CISD line it ends one candle after that close
    line   lvlLn   = drawIc and not na(s.icLevel) and not na(s.icStartIndex) ? line.new(xAnchor(s.icStartIndex), s.icLevel, brokeBar + 1, s.icLevel, xloc = xloc.bar_index, color = clr, style = lineStyleFromStr(lnStyle), width = protWidth) : na
    ic = ICCisd.new(swPx, dotLbl = dotLbl, isBull = s.isBull, ln = lvlLn, swBar = swIdx, formNum = htfNum)
    if na(s.icList)
        s.icList := array.new<ICCisd>()
    s.icList.push(ic)
    // global list: survives setup eviction (early C2 swings are temporary and cleaned up on C2 close / breach)
    if not s.early
        icDots.push(ic)
    c4LabelDodge(s)

// Once per bar, before new dots can form: greys a dot when price wicks beyond its extreme. A dot can grey during
// the HTF candle it printed in and the next one (formNum; a dot printed in C3 keeps its color from C5 on), and
// never after its model's liveHtf candle (C5) closes; noEarly (C4 suppressed) keeps only the liveHtf limit, and a
// C3 model's dots freeze when its C4 closes (finish). A taken or frozen dot leaves this list; its drawing stays
// until its setup leaves the history.
icMarkTakenAll(int htfOpenT, int hNum) =>
    if icDots.size() > 0
        for i = icDots.size() - 1 to 0
            ic = icDots.get(i)
            if na(ic.formNum)
                ic.formNum := hNum
            if not ic.frozen and not na(ic.liveHtf) and htfOpenT != ic.liveHtf
                ic.frozen := true
            if not ic.frozen and not ic.noEarly and hNum > ic.formNum + 1
                ic.frozen := true
            if not ic.taken and not ic.frozen and not na(ic.extremePrice)
                bool sweep = ic.isBull ? low < ic.extremePrice : high > ic.extremePrice
                if sweep
                    ic.taken := true
                    if not na(ic.dotLbl)
                        label.set_textcolor(ic.dotLbl, takenColor)
            if ic.taken or ic.frozen
                icDots.remove(i)

// [POI] A continuation only counts when its swing reached a point of interest formed since the C2 extreme
// (not only since the last protected swing): a same-direction fair value gap (bullish gap: low of a candle above
// the high two candles back), or an earlier swing low / high that was still untaken (the swing sweeps it).
// The swing has to go into the gap: only touching its edge is not enough.
icPoiStart(C2Setup s, int swIdx) =>
    math.max(na(s.c2BarIndex) ? swIdx - 150 : s.c2BarIndex, swIdx - 150)

icInFvg(C2Setup s, float swPx, int swIdx) =>
    bool  hit    = false
    int   first  = math.max(icPoiStart(s, swIdx) + 2, bar_index - 1497)
    int   lastSw = not na(s.icList) and s.icList.size() > 0 ? s.icList.last().swBar : na
    // a gap already traded completely through by the previous protected swing's bar is spent
    float run    = na
    if first < swIdx
        for b = swIdx - 1 to first
            int off = bar_index - b
            if not na(lastSw) and lastSw < swIdx and b < lastSw
                float nx = s.isBull ? low[off - 1] : high[off - 1]
                run := na(run) ? nx : s.isBull ? math.min(run, nx) : math.max(run, nx)
            bool spent = not na(run) and (s.isBull ? run < high[off + 2] : run > low[off + 2])
            if not spent and (s.isBull ? (low[off] > high[off + 2] and swPx < low[off]) : (high[off] < low[off + 2] and swPx > high[off]))
                hit := true
                break
    hit

icSweepsSwing(C2Setup s, float swPx, int swIdx) =>
    bool  hit   = false
    int   first = math.max(icPoiStart(s, swIdx), 1, bar_index - 1497)
    // extreme of the candles between a candidate swing and our swing: an untaken swing is never beyond it
    float run   = na
    if swIdx - 2 >= first
        for p = swIdx - 2 to first
            int off = bar_index - p
            float nx = s.isBull ? low[off - 1] : high[off - 1]
            run := na(run) ? nx : s.isBull ? math.min(run, nx) : math.max(run, nx)
            if s.isBull
                if low[off] <= low[off + 1] and low[off] <= low[off - 1] and swPx < low[off] and run >= low[off]
                    hit := true
                    break
            else
                if high[off] >= high[off + 1] and high[off] >= high[off - 1] and swPx > high[off] and run <= high[off]
                    hit := true
                    break
    hit

// One step of the IC state machine for bar m (m == bar_index live, m < bar_index when replaying).
icStep(C2Setup s, int m, bool live) =>
    int   off   = bar_index - m
    float o_m   = open[off]
    float c_m   = close[off]
    float h_m   = high[off]
    float l_m   = low[off]
    bool  oppBar = s.isBull ? c_m < o_m : c_m > o_m

    // a swing that is not confirmed within one HTF candle's worth of bars is dropped
    int htfLen = htfOpenBars.size() > 1 ? htfOpenBars.get(0) - htfOpenBars.get(1) : na
    if s.icPending and not na(htfLen) and not na(s.icExtremeIndex) and m - s.icExtremeIndex > htfLen
        icClearPending(s)

    if s.icPending
        // New extreme: dot moves and the level re-anchors on the opposing run into it
        bool newExt = s.isBull ? l_m < s.icExtreme : h_m > s.icExtreme
        if newExt
            s.icExtreme      := s.isBull ? l_m : h_m
            s.icExtremeIndex := m
            icRetrace(s)
        // Body break through the current level; it may be the extreme bar itself (the swing candle closes back
        // over the series it ran into)
        if m >= s.icExtremeIndex and not na(s.icLevel)
            bool broke = s.isBull ? c_m > s.icLevel : c_m < s.icLevel
            if broke
                // the swing is the run's extreme
                float swPx  = s.icExtreme
                int   swIdx = s.icExtremeIndex
                // in C4 a new protected swing has to go beyond the setup's last one from C3 on
                bool c4Ok = true
                if not na(s.c4Start) and swIdx >= s.c4Start and not na(s.icList) and s.icList.size() > 0
                    ICCisd lastIc = s.icList.last()
                    if lastIc.swBar >= nz(s.c3Start, 0)
                        c4Ok := s.isBull ? swPx < lastIc.extremePrice : swPx > lastIc.extremePrice
                        // ... unless it is the swing that made C4's own low / high so far (its wick)
                        if not c4Ok
                            bool isExt = swIdx >= bar_index - 1499
                            if isExt
                                for kb = math.min(math.max(s.c4Start, bar_index - 1499), swIdx) to swIdx
                                    int o2 = bar_index - kb
                                    if s.isBull ? low[o2] < swPx : high[o2] > swPx
                                        isExt := false
                                        break
                            c4Ok := isExt
                        // ... or it is still inside C3's range, or (C2 model) beyond C3 on the trend side
                        if not c4Ok and not na(s.c3Hi) and not na(s.c3Lo)
                            c4Ok := swPx >= s.c3Lo and swPx <= s.c3Hi
                            if not c4Ok and not s.c3Model
                                c4Ok := s.isBull ? swPx >= s.c3Hi : swPx <= s.c3Lo
                if c4Ok and (icInFvg(s, swPx, swIdx) or icSweepsSwing(s, swPx, swIdx))
                    registerIcCisd(s, swPx, swIdx, m)
                    if live and barstate.isconfirmed and showAlerts and protAlerts and (not s.early or earlyCisdAlerts)
                        alert((s.isBull ? 'Bullish' : 'Bearish') + ' Protected Swing on ' + syminfo.ticker + ', ' + modelText(), alert.freq_once_per_bar_close)
                icClearPending(s)
    else if oppBar
        s.icPending      := true
        s.icLevel        := o_m
        s.icStartIndex   := m
        s.icExtreme      := s.isBull ? l_m : h_m
        s.icExtremeIndex := m
        icRetrace(s)
    s

// Replays the same step function over bars that already happened (CISD confirmed inside C2,
// before the setup object existed). Covers cisdEndIndex + 1 .. lastBar.
method replayIc(C2Setup s, int lastBar) =>
    if showIcCisd and s.cisdConfirmed and not na(s.cisdEndIndex)
        int icFirstBar = math.max(s.cisdEndIndex + 1, bar_index - icBackfillMaxBars)
        if lastBar >= icFirstBar
            for m = icFirstBar to lastBar
                icMarkTaken(s, m)
                icStep(s, m, false)
    s

// Wick beyond the C3 extreme during C4 stops IC detection.
icCheckC4Wick(C2Setup s) =>
    if not s.icStopped and s.phase == 2 and not na(s.c3Extreme)
        if s.isBull ? low < s.c3Extreme : high > s.c3Extreme
            s.icStopped := true
    s

// no more protected swings for this setup: dead (XC2 / history), finished, XC4 or C3's opposite extreme wicked in C4
icHardStop(C2Setup s) =>
    s.dead or s.phase == 0 or s.c4Invalid or s.icStopped

// Every bar for the current buy / sell setups and the early C2 setups: greys their dots, then one icStep on a
// closed bar after the CISD (or clears the pending swing once detection has stopped)
method updateIc(C2Setup s) =>
    if not na(s)
        if not s.icStopped and s.phase == 2
            icCheckC4Wick(s)
        // non-early dots are already checked globally by icMarkTakenAll before updateIc runs
        if s.early
            icMarkTaken(s, bar_index)
        if icHardStop(s) or not showIcCisd or not s.cisdConfirmed or na(s.cisdEndIndex)
            if s.icPending
                icClearPending(s)
        else
            // Only ever arm / move / break on a closed candle, and only after the CISD confirm bar
            if barstate.isconfirmed and bar_index > s.cisdEndIndex
                icStep(s, bar_index, true)
    s

// Deletes every drawing of a setup (label, CISD, sweep, SMT, T-Spots, SD, dots). Used for setups pushed out of
// the history and for the temporary early C2 setups. Formation liquidity is redrawn on the last bar from the history.
deleteSetupVisuals(C2Setup s) =>
    if not na(s)
        label.delete(s.c2Lbl)
        line.delete(s.cisdLine)
        line.delete(s.c1SweepLn)
        line.delete(s.c3Ln)
        if not na(s.smtLns)
            for ln in s.smtLns
                line.delete(ln)
            for lb in s.smtLbls
                label.delete(lb)
        box.delete(s.c3Box)
        line.delete(s.c3Dash)
        box.delete(s.c4Box)
        line.delete(s.c4Dash)
        label.delete(s.c4Lbl)
        if not na(s.stdDevData)
            for lb in s.stdDevData.labels
                label.delete(lb)
            for ln in s.stdDevData.lines
                line.delete(ln)
        // its protected swings go with it (icMarkTakenAll() drops them from its list)
        if not na(s.icList)
            for ic in s.icList
                label.delete(ic.dotLbl)
                line.delete(ic.ln)
                ic.dotLbl := na
                ic.ln     := na
                ic.taken  := true

// [HISTORY] Called by reveal: keeps the latest History + 1 models (both directions together); an older one is
// marked dead and its drawings deleted. Early CISD lines older than the oldest kept model go too.
registerRecord(C2Setup s) =>
    setupRecords.push(SetupRecord.new(s, bar_index))
    while setupRecords.size() > showHistory + 1
        // keep opposite-direction models that printed on the same bar even when History = 0
        if showHistory == 0 and setupRecords.size() == 2 and setupRecords.first().creationBar == setupRecords.last().creationBar
            break
        evicted = setupRecords.shift()
        // stop the evicted setup from ever drawing again (buySetup/sellSetup may still point to it)
        evicted.setup.dead      := true
        evicted.setup.phase     := 0
        evicted.setup.icStopped := true
        deleteSetupVisuals(evicted.setup)
    earliestVisibleBar = setupRecords.size() > 0 ? setupRecords.first().creationBar : na
    pruneEarlyCisd(bullEarlyCisdRecords, earliestVisibleBar)
    pruneEarlyCisd(bearEarlyCisdRecords, earliestVisibleBar)

// The chart must match the fractal's entry timeframe, and be below the model HTF
validTf = (modelType == 'Automatic' ? autoHTF() != '' : timeframe.in_seconds() == timeframe.in_seconds(ltfCode())) and timeframe.in_seconds(autoTf) > timeframe.in_seconds()

// [AUTO BIAS] the fractal model 1 / 2 steps above (on 5m-1H: Auto Bias 1 = 15m-4H, Auto Bias 2 = 1H-1D;
// a bearish 1H-1D model -> only bearish setups that day).
// The ladder of model HTFs: 15m, 1H, 4H, 1D, 1W, 1M, 3M, 12M; each with its entry timeframe.
abNextHtf(simple string tf) =>
    int s = timeframe.in_seconds(tf)
    s < timeframe.in_seconds('15') ? '15' : s < timeframe.in_seconds('60') ? '60' : s < timeframe.in_seconds('240') ? '240' : s < timeframe.in_seconds('1D') ? '1D' : s < timeframe.in_seconds('1W') ? '1W' : s < timeframe.in_seconds('1M') ? '1M' : s < timeframe.in_seconds('3M') ? '3M' : '12M'
abLtfOf(simple string htf) =>
    switch htf
        '15'  => '1'
        '60'  => '5'
        '240' => '15'
        '1D'  => '60'
        '1W'  => '240'
        '1M'  => '1D'
        '3M'  => '1W'
        =>       '1M'
// Inverse of abLtfOf, evaluated inside request.security(..., abLtf, abDir()): passing abHtf as an
// argument would re-evaluate autoTf in the abLtf context and shift the HTF up by 1-2 ladder steps.
abHtfOf() =>
    int s = timeframe.in_seconds()
    s <= 60 ? '15' : s <= 300 ? '60' : s <= 900 ? '240' : s <= 3600 ? '1D' : s <= 14400 ? '1W' : s <= 86400 ? '1M' : s <= 604800 ? '3M' : '12M'

// Direction of the higher model, run on its own entry timeframe: C2 or C3 closure + CISD (close through
// the open of the run into the extreme). C2 holds through C3 and C4, C3 through C4; ends when that window
// closes or a close goes beyond the extreme (XC2 / XC3). A newer model replaces an older one.
// +1 bullish, -1 bearish, 0 none.
abDir() =>
    string htf = abHtfOf()
    // reads open / close up to ~1500 bars back below; one fixed deep read sizes this context's buffers up front
    float bufWarm = close[1499] + open[1499]
    var float c2H  = na
    var float c2L  = na
    var float c1O  = na
    var float c1H  = na
    var float c1L  = na
    var float c1C  = na
    var int   c1Hb = na
    var int   c1Lb = na
    var float cO   = na
    var float cH   = na
    var float cL   = na
    var int   cHb  = na
    var int   cLb  = na
    var int   dir  = 0
    var int   want = 0      // C2 / C3 closed, CISD not yet confirmed: +1 / -1
    var float ext  = na
    var float lvl  = na
    var int   left = 0
    // evaluate the just-closed bar (close[1]) before any new HTF candle opens so dir depends only on closed bars
    if left > 0 and not na(close[1])
        if want != 0 and not na(lvl) and (want < 0 ? close[1] < lvl : close[1] > lvl)
            dir  := want
            want := 0
        if not na(ext) and (dir < 0 or want < 0 ? close[1] > ext : dir > 0 or want > 0 ? close[1] < ext : false)
            dir  := 0
            want := 0
            left := 0
    if timeframe.change(htf)
        if left > 0
            left -= 1
            if left == 0
                dir  := 0
                want := 0
        float cc     = close[1]
        bool  bearC2 = not na(c1H) and cH > c1H and cc < c1H
        bool  bullC2 = not na(c1L) and cL < c1L and cc > c1L
        bool  bearC3 = not bearC2 and not na(c2H) and not na(c1H) and c1H > c2H and c1C >= c2H and cH <= c1H and cc < math.min(c1O, c1C)
        bool  bullC3 = not bullC2 and not na(c2L) and not na(c1L) and c1L < c2L and c1C <= c2L and cL >= c1L and cc > math.max(c1O, c1C)
        bool  isC2   = bearC2 or bullC2
        bool  isC3   = not isC2 and (bearC3 or bullC3)
        if isC2 or isC3
            bool isBear = isC2 ? (bearC2 and (not bullC2 or cHb > cLb)) : (bearC3 and (not bullC3 or c1Hb > c1Lb))
            int  eb     = isC2 ? (isBear ? cHb : cLb) : (isBear ? c1Hb : c1Lb)
            ext  := isC2 ? (isBear ? cH : cL) : (isBear ? c1H : c1L)
            // CISD level: open of the run of opposite candles that led into the extreme
            int   bias  = isBear ? 1 : -1
            float lv    = na
            bool  found = false
            int   off0  = bar_index - eb
            if not na(eb) and off0 >= 1 and off0 <= 1499
                for i = off0 to math.min(off0 + 300, bar_index, 1499)
                    int att = close[i] > open[i] ? 1 : close[i] < open[i] ? -1 : 0
                    if att == 0
                        continue
                    if not found
                        if att == bias
                            found := true
                            lv    := open[i]
                    else
                        if att != bias
                            break
                        lv := open[i]
            lvl  := lv
            left := isC2 ? 2 : 1
            dir  := 0
            want := isBear ? -1 : 1
            // the CISD may already have closed through inside C2 / C3, on or after the extreme bar
            if not na(lvl) and not na(eb) and off0 >= 1 and off0 <= 1499
                for i = 1 to off0
                    if (isBear and close[i] < lvl) or (not isBear and close[i] > lvl)
                        dir  := want
                        want := 0
                        break
        c2H  := c1H
        c2L  := c1L
        c1O  := cO
        c1H  := cH
        c1L  := cL
        c1C  := cc
        c1Hb := cHb
        c1Lb := cLb
        cO   := open
        cH   := high
        cL   := low
        cHb  := bar_index
        cLb  := bar_index
    else
        if na(cO)
            cO := open
        if na(cH) or high > cH
            cH  := high
            cHb := bar_index
        if na(cL) or low < cL
            cL  := low
            cLb := bar_index
    bar_index < 0 and not na(bufWarm) ? 0 : dir

int    abSteps  = biasFilter == 'Auto Bias 1' ? 1 : biasFilter == 'Auto Bias 2' ? 2 : 0
string abHtf    = abSteps == 2 ? abNextHtf(abNextHtf(autoTf)) : abNextHtf(autoTf)
string abLtfRaw = abLtfOf(abHtf)
string abLtf    = timeframe.in_seconds(abLtfRaw) < timeframe.in_seconds() ? timeframe.period : abLtfRaw
bool   abValid  = abSteps > 0 and validTf and abHtf != autoTf
int    abBias   = 0
if abValid
    abBias := request.security(ticker.modify(syminfo.tickerid, settlement_as_close = settlement_as_close.off), abLtf, abDir(), lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true, calc_bars_count = 1000)
// the bias the setups follow: Bullish / Bearish / Neutral (or None when Auto Bias has no higher model)
string biasNow    = abSteps == 0 ? biasFilter : abBias > 0 ? 'Bullish' : abBias < 0 ? 'Bearish' : 'None'
bool   biasBuyOk  = abSteps == 0 ? allowBuy  : abBias > 0
bool   biasSellOk = abSteps == 0 ? allowSell : abBias < 0

// [TIME FILTER] new setups only inside the checked windows, on charts below 'Apply below'
inWindow(string sess) =>
    not na(time(timeframe.period, sess, filterTz))

timeFilterActive = useTimeFilter and (f1On or f2On or f3On) and timeframe.in_seconds() < timeframe.in_seconds(tfApplyBelow)
inTimeFilter     = not timeFilterActive or (f1On and inWindow(f1Sess)) or (f2On and inWindow(f2Sess)) or (f3On and inWindow(f3Sess))

// Symbol kind. Used for the ADR / CDR unit (forex in pips, the rest in price points)
// and for the trading day.
adrTicker = str.upper(syminfo.ticker)
adrIsMetal = str.startswith(adrTicker, 'XAU') or str.startswith(adrTicker, 'XAG') or str.startswith(adrTicker, 'XPT') or str.startswith(adrTicker, 'XPD')
adrHasDigit = str.contains(adrTicker, '0') or str.contains(adrTicker, '1') or str.contains(adrTicker, '2') or str.contains(adrTicker, '3') or str.contains(adrTicker, '4') or str.contains(adrTicker, '5') or str.contains(adrTicker, '6') or str.contains(adrTicker, '7') or str.contains(adrTicker, '8') or str.contains(adrTicker, '9')
// 6-letter CFD = forex only when both halves are currencies (SILVER, NATGAS, COPPER are not)
adrCcy = 'USD EUR GBP JPY CHF AUD NZD CAD SEK NOK DKK SGD HKD MXN ZAR TRY PLN HUF CZK CNH CNY ILS THB INR KRW'
adrIsFx = not adrIsMetal and (syminfo.type == 'forex' or (syminfo.type == 'cfd' and str.length(adrTicker) == 6 and not adrHasDigit and str.contains(adrCcy, str.substring(adrTicker, 0, 3)) and str.contains(adrCcy, str.substring(adrTicker, 3, 6))))
adrPip = str.contains(adrTicker, 'JPY') ? 0.01 : 0.0001


// [NY DAY] Trading day in New York time, the same on every broker: forex starts 17:00, indices,
// metals and the rest 18:00. Crypto trades 24/7 and keeps the symbol's own daily candle.
dayIsCrypto = syminfo.type == 'crypto'
dayStartH   = adrIsFx ? 17 : 18

nyNewDay(simple int h, simple bool crypto) =>
    int off = (24 - h) * 3600000
    var int prevDay = na
    int curDay = crypto ? na : dayofmonth(time + off, 'America/New_York')
    bool chg = crypto ? timeframe.change('1D') : not na(prevDay) and curDay != prevDay
    prevDay := curDay
    chg

// [ADR] ADR / CDR table and ADR+ / ADR- lines on the NY trading day (see [NY DAY]).
// Built from 1H bars so it does not depend on chart history: ADR = average high-low of the last
// len completed days (today excluded), plus today's high / low so far.
adrReq(simple int len, simple int h, simple bool crypto) =>
    var float   dH     = na
    var float   dL     = na
    var float[] ranges = array.new_float()
    if nyNewDay(h, crypto)
        if not na(dH)
            ranges.push(dH - dL)
            if ranges.size() > len
                ranges.shift()
        dH := high
        dL := low
    else
        dH := na(dH) ? high : math.max(dH, high)
        dL := na(dL) ? low : math.min(dL, low)
    float adr = barstate.islast and ranges.size() == len ? ranges.avg() : na
    [adr, dH, dL]


// [1H REQUEST] ADR comes from 1H bars. It is only read on the last bar, so the request needs just the last
// ADR days, and it is skipped when neither the Info Table row nor the ADR+ / ADR- lines use it.
// Above 1H the request is a lower timeframe one: lookahead on would return the chart bar's first hour (CDR on
// a 1D chart = the day's first hour), so it is off there (the last hour so far).
float adrVal  = na
float adrDayH = na
float adrDayL = na
if (adrShow and tbl_show) or adrLinesShow
    [rAdr, rDayH, rDayL] = request.security(syminfo.tickerid, '60', adrReq(adrLen, dayStartH, dayIsCrypto), lookahead = timeframe.in_seconds() > 3600 ? barmerge.lookahead_off : barmerge.lookahead_on, calc_bars_count = (adrLen + 3) * 24)
    adrVal  := rAdr
    adrDayH := rDayH
    adrDayL := rDayL


// [SMT / PSP] One request per pair, at the chart timeframe: the pair's bar as a plain tuple (avoids UDT
// allocations on thousands of bars). Folded into our own HTF candles (pO / pH / pL / pC, qO / ...) inside our
// candle's limits; htfT (the pair's own HTF open) only tells a stale bar apart.

// True when a pair bar holds a new chart bar belonging to the current HTF candle (skips stale carried-forward bars)
pairFresh(float h, int barT, int htfT, int prevBarT, int prevHtfT, int openT, bool changed) =>
    not na(h) and not na(barT) and (na(prevBarT) ? (not na(openT) and barT >= openT) : barT != prevBarT and (not changed or (not na(openT) and barT >= openT) or (not na(htfT) and not na(prevHtfT) and htfT != prevHtfT)))

bool needPairs = show_smt or showPsp
// The chart-timeframe pair bars feed the model (chart SMT, PSP) and the model block; without a fractal on this
// chart, or with both hidden, nothing reads them (HTF 1 / HTF 2 request the pairs on their own timeframe).
bool pairBarsOn = needPairs and validTf and not (hideHtf and hideSetups)
float p1aH = na, float p1aL = na, float p1aO = na, float p1aC = na, int p1aBT = na, int p1aHT = na
if pairBarsOn and pair1A != ''
    [_h, _l, _o, _c, _bt, _ht] = request.security(pair1A, timeframe.period, [high, low, open, close, time, time(autoTf)], ignore_invalid_symbol = true, calc_bars_count = 1200)
    p1aH := _h, p1aL := _l, p1aO := _o, p1aC := _c, p1aBT := _bt, p1aHT := _ht
float p1bH = na, float p1bL = na, float p1bO = na, float p1bC = na, int p1bBT = na, int p1bHT = na
if pairBarsOn and pair1B != ''
    [_h, _l, _o, _c, _bt, _ht] = request.security(pair1B, timeframe.period, [high, low, open, close, time, time(autoTf)], ignore_invalid_symbol = true, calc_bars_count = 1200)
    p1bH := _h, p1bL := _l, p1bO := _o, p1bC := _c, p1bBT := _bt, p1bHT := _ht
float p2aH = na, float p2aL = na, float p2aO = na, float p2aC = na, int p2aBT = na, int p2aHT = na
if pairBarsOn and pair2A != ''
    [_h, _l, _o, _c, _bt, _ht] = request.security(pair2A, timeframe.period, [high, low, open, close, time, time(autoTf)], ignore_invalid_symbol = true, calc_bars_count = 1200)
    p2aH := _h, p2aL := _l, p2aO := _o, p2aC := _c, p2aBT := _bt, p2aHT := _ht
float p2bH = na, float p2bL = na, float p2bO = na, float p2bC = na, int p2bBT = na, int p2bHT = na
if pairBarsOn and pair2B != ''
    [_h, _l, _o, _c, _bt, _ht] = request.security(pair2B, timeframe.period, [high, low, open, close, time, time(autoTf)], ignore_invalid_symbol = true, calc_bars_count = 1200)
    p2bH := _h, p2bL := _l, p2bO := _o, p2bC := _c, p2bBT := _bt, p2bHT := _ht

// The fallback name is used only when the first choice never had data
var bool seen1a = false
var bool seen1b = false
var bool seen2a = false
var bool seen2b = false
seen1a := seen1a or not na(p1aH)
seen1b := seen1b or not na(p1bH)
seen2a := seen2a or not na(p2aH)
seen2b := seen2b or not na(p2bH)
bool use1b = not seen1a and seen1b
bool use2b = not seen2a and seen2b

float r1H   = use1b ? p1bH  : p1aH
float r1L   = use1b ? p1bL  : p1aL
float r1O   = use1b ? p1bO  : p1aO
float r1C   = use1b ? p1bC  : p1aC
int   p1BT  = use1b ? p1bBT : p1aBT
int   p1HT  = use1b ? p1bHT : p1aHT
float p1H   = pair1InvOn ? -r1L : r1H
float p1L   = pair1InvOn ? -r1H : r1L
float p1O   = pair1InvOn ? -r1O : r1O
float p1C   = pair1InvOn ? -r1C : r1C

float r2H   = use2b ? p2bH  : p2aH
float r2L   = use2b ? p2bL  : p2aL
float r2O   = use2b ? p2bO  : p2aO
float r2C   = use2b ? p2bC  : p2aC
int   p2BT  = use2b ? p2bBT : p2aBT
int   p2HT  = use2b ? p2bHT : p2aHT
float p2H   = pair2InvOn ? -r2L : r2H
float p2L   = pair2InvOn ? -r2H : r2L
float p2O   = pair2InvOn ? -r2O : r2O
float p2C   = pair2InvOn ? -r2C : r2C

string   pair1Base = pair1A == '' ? '' : use1b ? pair1B : pair1A
string   pair2Base = pair2A == '' ? '' : use2b ? pair2B : pair2A

// [EXTRA HTF] HTF 1 / HTF 2: higher timeframe candle blocks right of the model block.
// No model runs on them. Each block is requested on its own timeframe (a 1m chart's 2000 bars cannot
// build daily candles); each pair the same way (above 1H: from its 1H bars, see xSub), so SMT / PSP reach the older candles too.
xSelTf(simple string s) =>
    switch s
        '15m' => '15'
        '30m' => '30'
        '1H'  => '60'
        '90m' => '90'
        '4H'  => '240'
        '6H'  => '360'
        '7H'  => '420'
        'D'   => '1D'
        'W'   => '1W'
        'M'   => '1M'
        =>       ''

// HTF 1 / HTF 2 do not need the model: Auto counts from the model HTF, or from the chart when it has no fractal (7H chart: D / W)
string xBase0 = validTf ? autoTf : timeframe.period
string x1Auto = abNextHtf(xBase0)
string x1Tf   = x1Sel == 'Auto' ? x1Auto : xSelTf(x1Sel)
bool   x1On   = showX1 and timeframe.in_seconds(x1Tf) > timeframe.in_seconds() and (x1Sel != 'Auto' or timeframe.in_seconds(x1Tf) > timeframe.in_seconds(xBase0))
string x2Base = x1On ? x1Tf : x1Auto
string x2Tf   = x2Sel == 'Auto' ? abNextHtf(x2Base) : xSelTf(x2Sel)
bool   x2On   = showX2 and timeframe.in_seconds(x2Tf) > timeframe.in_seconds() and (x2Sel != 'Auto' or timeframe.in_seconds(x2Tf) > timeframe.in_seconds(x2Base))

type XData
    array<float> o
    array<float> h
    array<float> l
    array<float> c
    array<int>   t

// The last n candles, newest first. Only filled on the last bar (the blocks are drawn there).
xReq(simple int n) =>
    // one fixed deep read sizes this security context's buffers up front for live bar closes on short histories
    float _w = open[n - 1] + high[n - 1] + low[n - 1] + close[n - 1] + time[n - 1]
    array<float> ao = na
    array<float> ah = na
    array<float> al = na
    array<float> ac = na
    array<int>   at = na
    if barstate.islast and (bar_index >= 0 or not na(_w))
        ao := array.new<float>()
        ah := array.new<float>()
        al := array.new<float>()
        ac := array.new<float>()
        at := array.new<int>()
        for k = 0 to n - 1
            if na(time[k])
                break
            ao.push(open[k])
            ah.push(high[k])
            al.push(low[k])
            ac.push(close[k])
            at.push(time[k])
    [ao, ah, al, ac, at]

// A timeframe that is not a whole number of chart bars (90m on 1H, 6H on 4H): with lookahead on, the forming chart
// bar would map to the HTF candle it opened in, not the newest one, and the block would vanish half the time.
// Futures D / W / M candles close at the last trade, not the settlement, like the model block.
xFetch(string sym, simple string tf, simple int n) =>
    simple bool whole = timeframe.in_seconds(tf) % timeframe.in_seconds() == 0
    [o, h, l, c, t] = request.security(ticker.modify(sym, settlement_as_close = settlement_as_close.off), tf, xReq(n),lookahead = whole ? barmerge.lookahead_on : barmerge.lookahead_off, ignore_invalid_symbol = true, calc_bars_count = math.max(100, n + 10))
    XData.new(o, h, l, c, t)

xHasData(XData d) =>
    not na(d) and not na(d.t) and d.t.size() > 0

// Intraday blocks above 1H and the daily block: the pair's candles are rebuilt from its 1H bars (90m: 30m) inside
// our own candles, counting only the hours our symbol trades too, like the model block (a pair with another
// session, like spot gold against futures gold or DXY against a currency, gets our candle's open and close
// times). '' = the pair's own candles (W / M, 15m-1H, or a chart timeframe that does not divide the hour).
xSub(simple string tf) =>
    simple int s  = timeframe.in_seconds(tf)
    simple int cs = timeframe.in_seconds()
    s <= 86400 and s > 3600 and s % 3600 == 0 and 3600 % cs == 0 ? '60' : s < 86400 and s > 1800 and s % 1800 == 0 and 1800 % cs == 0 ? '30' : ''

// Sub-bars per candle
xRatio(simple string tf, simple string sub) =>
    sub == '' ? 1 : int(math.round(timeframe.in_seconds(tf) / timeframe.in_seconds(sub)))

// raw = the pair's sub-bars, own = our sub-bars, d = our candles (all newest first); returns the pair's candles
// with d's open times. A candle holds the sub-bars from its open to the next candle's open.
xFold(XData raw, XData own, XData d) =>
    XData res = na
    if xHasData(raw) and xHasData(own) and xHasData(d)
        int n = d.t.size()
        array<float> fo = array.new<float>(n, na)
        array<float> fh = array.new<float>(n, na)
        array<float> fl = array.new<float>(n, na)
        array<float> fc = array.new<float>(n, na)
        int i = 0
        for k = 0 to own.t.size() - 1
            int s = own.t.get(k)
            while i < n - 1 and s < d.t.get(i)
                i += 1
            if s < d.t.get(i)
                break
            int j = raw.t.indexof(s)
            if j >= 0
                float h = raw.h.get(j)
                float l = raw.l.get(j)
                if na(fc.get(i))
                    fc.set(i, raw.c.get(j))
                fo.set(i, raw.o.get(j))
                fh.set(i, na(fh.get(i)) ? h : math.max(fh.get(i), h))
                fl.set(i, na(fl.get(i)) ? l : math.min(fl.get(i), l))
        res := XData.new(fo, fh, fl, fc, d.t.copy())
    res

// The pair's candles for one block (sub = xSub(tf), own = our sub-bars, d = our candles)
xPairFetch(string sym, simple string tf, simple string sub, simple int n, XData own, XData d) =>
    XData res = na
    if sub == ''
        res := xFetch(sym, tf, n)
    else
        res := xFold(xFetch(sym, sub, n * xRatio(tf, sub) * 2 + 72), own, d)
    res

XData x1D  = na
XData x1P  = na
XData x1Q  = na
XData x1Pb = na
XData x1Qb = na
XData x2D  = na
XData x2P  = na
XData x2Q  = na
XData x2Pb = na
XData x2Qb = na
// xBlock reads the pairs only for its SMT lines and PSP labels
bool xPairsOn = smtOnHtf or showPsp
bool xNeed1b  = not pairBarsOn and xPairsOn and pair1B != ''
bool xNeed2b  = not pairBarsOn and xPairsOn and pair2B != ''
string x1Sub  = xSub(x1Tf)
string x2Sub  = xSub(x2Tf)
XData  x1S    = na
XData  x2S    = na
if x1On
    x1D := xFetch(syminfo.tickerid, x1Tf, x1Count)
    if xPairsOn and x1Sub != '' and (pair1Base != '' or pair2Base != '')
        x1S := xFetch(syminfo.tickerid, x1Sub, x1Count * xRatio(x1Tf, x1Sub))
    if xPairsOn and pair1Base != ''
        x1P := xPairFetch(pair1Base, x1Tf, x1Sub, x1Count, x1S, x1D)
    if xNeed1b
        x1Pb := xPairFetch(pair1B, x1Tf, x1Sub, x1Count, x1S, x1D)
    if xPairsOn and pair2Base != ''
        x1Q := xPairFetch(pair2Base, x1Tf, x1Sub, x1Count, x1S, x1D)
    if xNeed2b
        x1Qb := xPairFetch(pair2B, x1Tf, x1Sub, x1Count, x1S, x1D)
if x2On
    x2D := xFetch(syminfo.tickerid, x2Tf, x2Count)
    if xPairsOn and x2Sub != '' and (pair1Base != '' or pair2Base != '')
        x2S := xFetch(syminfo.tickerid, x2Sub, x2Count * xRatio(x2Tf, x2Sub))
    if xPairsOn and pair1Base != ''
        x2P := xPairFetch(pair1Base, x2Tf, x2Sub, x2Count, x2S, x2D)
    if xNeed1b
        x2Pb := xPairFetch(pair1B, x2Tf, x2Sub, x2Count, x2S, x2D)
    if xPairsOn and pair2Base != ''
        x2Q := xPairFetch(pair2Base, x2Tf, x2Sub, x2Count, x2S, x2D)
    if xNeed2b
        x2Qb := xPairFetch(pair2B, x2Tf, x2Sub, x2Count, x2S, x2D)

bool xHas1a = xHasData(x1P) or xHasData(x2P)
bool xHas1b = xHasData(x1Pb) or xHasData(x2Pb)
bool xUse1b = xNeed1b and not xHas1a and xHas1b
if xUse1b
    x1P := x1Pb
    x2P := x2Pb

bool xHas2a = xHasData(x1Q) or xHasData(x2Q)
bool xHas2b = xHasData(x1Qb) or xHasData(x2Qb)
bool xUse2b = xNeed2b and not xHas2a and xHas2b
if xUse2b
    x1Q := x1Qb
    x2Q := x2Qb

bool   xRequested = not pairBarsOn and xPairsOn and (x1On or x2On)
string pair1Name  = xUse1b ? pair1B : pair1Base
string pair2Name  = xUse2b ? pair2B : pair2Base
// not requested = nothing to report as missing
bool   pair1Seen  = pairBarsOn ? (seen1a or seen1b) : (not xRequested or pair1Base == '' or xHas1a or xHas1b)
bool   pair2Seen  = pairBarsOn ? (seen2a or seen2b) : (not xRequested or pair2Base == '' or xHas2a or xHas2b)

// PSP: own candle and the pair's same candle close in different colors (dojis ignored)
pspDiff(float o, float c, float po, float pc) =>
    not na(o) and not na(c) and not na(po) and not na(pc) and (c - o) * (pc - po) < 0
// PSP on two model candles (own1 = C1, own2 = C2) against both pairs' same candles. The pair candles are built
// from the pair's chart bars inside our HTF candle's limits (a pair with another session, like spot gold against
// futures gold, still gets our candle's open and close times).
htfPsp(HtfCandle own1, HtfCandle own2) =>
    bool chk1 = pspMode != 'Candle 2'
    bool chk2 = pspMode != 'Candle 1'
    bool p1 = chk1 and not na(own1) and (pspDiff(own1.o, own1.c, own1.pO, own1.pC) or pspDiff(own1.o, own1.c, own1.qO, own1.qC))
    bool p2 = chk2 and not na(own2) and (pspDiff(own2.o, own2.c, own2.pO, own2.pC) or pspDiff(own2.o, own2.c, own2.qO, own2.qC))
    p1 or p2

// SMT label text: the pair(s) that diverged
smtNames(bool d1, bool d2) =>
    string s = ''
    if smtLabels
        if d1
            s := statusSym(pair1Name)
        if d2
            s := s == '' ? statusSym(pair2Name) : s + '/' + statusSym(pair2Name)
    s

// The model HTF: open time of the forming candle, true on the first chart bar of a new one, and a running
// candle count (models and dots measure their HTF windows with it)
int htfOpenT  = time(autoTf)
periodChanged = htfOpenT != htfOpenT[1]
if periodChanged
    htfNum += 1


// T-Spot geometry at the current bar: between the previous HTF candle's EQ and this candle's open
// EQ rule: a C2 that closed against the setup (bullish setup, bearish C2; doji too) or on the
// wrong side of its own middle uses its close -> wick extreme; otherwise, and always for C3,
// the full range.
phaseGeom(bool isBull, bool c2Ref) =>
    float mid = (state.prevHigh + state.prevLow) / 2
    if c2Ref and htfCandles.size() > 1
        HtfCandle c = htfCandles.get(1)
        if isBull ? (c.c <= c.o or c.c < mid) : (c.c >= c.o or c.c > mid)
            mid := isBull ? (c.c + c.l) / 2 : (c.c + c.h) / 2
    [math.max(open, mid), math.min(open, mid), mid]

// T-Spot box + EQ of one stage, drawn from bar x0 to the current bar. The C3 box has no
// label; 'C4' sits at the start of the C4 box, on the C3 EQ line.
drawPhaseAt(bool isBull, int stage, int x0, float top, float bot, float mid, bool withLbl = true) =>
    int   ax0   = xAnchor(x0)
    color bxCol = isBull ? tSpotBullColor : tSpotBearColor
    box   bx    = showTSpot ? box.new(ax0, top, bar_index + 1, bot, border_color = na, bgcolor = bxCol) : na
    line  dash  = showEQ ? line.new(ax0, mid, bar_index + 1, mid, color = eqColor, width = eqWidth, style = lineStyleFromStr(eqStyle)) : na
    label lbl   = na
    if stage == 4 and withLbl and showLabels and validTf
        lbl := label.new(ax0, mid, 'C4', xloc = xloc.bar_index, yloc = yloc.price, style = isBull ? label.style_label_upper_left : label.style_label_lower_left, color = na, textcolor = c2c3c4Color, size = textSize(labelSize), text_font_family = font.family_default)
    [bx, dash, lbl]

// [SMT] one chart SMT line (+ pair name label at its middle) owned by a setup
smtDrawOn(C2Setup s, int x1, float y1, int x2, float y2, bool isHigh, string txt) =>
    if na(s.smtLns)
        s.smtLns  := array.new<line>()
        s.smtLbls := array.new<label>()
    int ax1 = xAnchor(x1)
    int ax2 = xAnchor(x2)
    s.smtLns.push(line.new(ax1, y1, ax2, y2, xloc = xloc.bar_index, color = smtColorFor(isHigh), style = lineStyleFromStr(smtStyle), width = smtWidth))
    if txt != ''
        s.smtLbls.push(label.new(int(math.round((ax1 + ax2) / 2.0)), (y1 + y2) / 2, txt, xloc = xloc.bar_index, yloc = yloc.price, style = isHigh ? label.style_label_down : label.style_label_up, color = na, textcolor = smtColorFor(isHigh), size = textSize(smtLblSize), text_font_family = font.family_default))

// [HTF SMT] the model's block lines (ending on its C2 / C3 candle) go with it, only while it is in C3 / C4
// (later its candles have left the model part of the block anyway)
htfSmtKill(C2Setup s) =>
    if not na(s) and not na(s.smtHtf0) and htfNum - s.smtHtf0 < (s.c3Model ? 1 : 2)
        if not na(s.smtC2)
            if s.isBull
                s.smtC2.smtBullDead := true
            else
                s.smtC2.smtBearDead := true
        if not na(s.smtC3)
            if s.isBull
                s.smtC3.smtBullDead := true
            else
                s.smtC3.smtBearDead := true

// [SMT] removes all SMT lines of a setup for good (reversal and continuation); the model label stays
smtClear(C2Setup s) =>
    htfSmtKill(s)
    s.smtGone := true
    if not na(s.smtLns)
        for ln in s.smtLns
            line.delete(ln)
        for lb in s.smtLbls
            label.delete(lb)
        s.smtLns.clear()
        s.smtLbls.clear()
    s.csLn := na
    s.csLb := na

// bar on which the last bullish / bearish model printed (its label appeared)
var array<int> printBar = array.from(-1, -1)

// [EARLY C2] temporary setup while C2 is still forming: carries C1/C2 anchors for live reversal SMT and
// feeds icStep() for early protected swings. Cleaned up on periodChanged or when C2's extreme is breached.
newEarlySetup(bool isBull, HtfCandle cur, HtfCandle prev, float cisdLevel, int cisdIndex, int confirmBar) =>
    C2Setup s = C2Setup.new(isBull = isBull, extreme = isBull ? cur.l : cur.h, phase = 1, dead = false, c2Lbl = na)
    s.early         := true
    s.c2BarIndex    := isBull ? cur.lBar : cur.hBar
    s.c1Px          := isBull ? prev.l : prev.h
    s.c1Bar         := isBull ? prev.lBar : prev.hBar
    s.cisdLevel     := cisdLevel
    s.cisdIndex     := cisdIndex
    s.cisdConfirmed := true
    s.cisdEndIndex  := confirmBar
    s

// Live reversal SMT while C2 is forming: our symbol swept C1, a pair has not swept its own C1 yet
earlySmtFlags(bool isBull, HtfCandle cur, HtfCandle prev) =>
    bool d1 = false
    bool d2 = false
    if show_smt and not na(cur) and not na(prev)
        if not na(cur.pL) and not na(prev.pL) and not na(cur.pH) and not na(prev.pH)
            d1 := isBull ? cur.pL > prev.pL : cur.pH < prev.pH
        if not na(cur.qL) and not na(prev.qL) and not na(cur.qH) and not na(prev.qH)
            d2 := isBull ? cur.qL > prev.qL : cur.qH < prev.qH
    [d1, d2]

// Keeps the early reversal SMT line / pair label in sync on confirmed bars; drops it if pairs sweep their C1
updateEarlySmt(C2Setup s, HtfCandle cur, HtfCandle prev) =>
    if not na(s) and barstate.isconfirmed
        [d1, d2] = earlySmtFlags(s.isBull, cur, prev)
        bool active = showEarlyCisd and smtOnChart and (d1 or d2) and not na(s.c1Bar) and not na(s.c1Px) and not na(s.c2BarIndex)
        if active
            string txt = smtNames(d1, d2)
            if na(s.smtLns) or s.smtLns.size() == 0
                smtDrawOn(s, s.c1Bar, s.c1Px, s.c2BarIndex, s.extreme, not s.isBull, txt)
            else if txt != ''
                if s.smtLbls.size() > 0
                    label.set_text(s.smtLbls.get(0), txt)
                else
                    int ax1 = xAnchor(s.c1Bar)
                    int ax2 = xAnchor(s.c2BarIndex)
                    s.smtLbls.push(label.new(int(math.round((ax1 + ax2) / 2.0)), (s.c1Px + s.extreme) / 2, txt, xloc = xloc.bar_index, yloc = yloc.price, style = not s.isBull ? label.style_label_down : label.style_label_up, color = na, textcolor = smtColorFor(not s.isBull), size = textSize(smtLblSize), text_font_family = font.family_default))
            else if s.smtLbls.size() > 0
                for lb in s.smtLbls
                    label.delete(lb)
                s.smtLbls.clear()
        else if not na(s.smtLns) and s.smtLns.size() > 0
            for ln in s.smtLns
                line.delete(ln)
            for lb in s.smtLbls
                label.delete(lb)
            s.smtLns.clear()
            s.smtLbls.clear()

// [REVEAL] A model is only drawn once its LTF CISD confirms. Everything that already happened is drawn then.
method reveal(C2Setup s, bool onClose = false) =>
    if not s.revealed
        s.revealed := true
        if showLabels and validTf
            s.c2Lbl := directionalLabel(xAnchor(nz(s.lblBar, s.c2BarIndex)), nz(s.lblPx, s.extreme), s.tag, s.isBull)
        // [C1 SWEEP] on the chart: from the C1 high / low that was taken to the end of C2
        if sweepOnChart and validTf and not na(s.c1Bar) and not na(s.c1Px)
            s.c1SweepLn := line.new(xAnchor(s.c1Bar), s.c1Px, xAnchor(s.sweepEnd), s.c1Px, xloc = xloc.bar_index, color = sweepColor, style = lineStyleFromStr(sweepStyle), width = sweepWidth)
        if s.c3Model and showLabels and validTf and not na(s.c3LnBar) and not na(s.lblPx)
            s.c3Ln := line.new(xAnchor(s.c3LnBar), s.lblPx, bar_index + 1, s.lblPx, xloc = xloc.bar_index, color = sweepColor, style = line.style_dotted, width = 1)
        // [REVERSAL SMT] C2 took C1's high / low but a pair did not: line from the C1 extreme to the C2 extreme
        if smtOnChart and s.smtHit and not s.smtGone and validTf and not na(s.c1Bar) and not na(s.c1Px)
            smtDrawOn(s, s.c1Bar, s.c1Px, s.c2BarIndex, s.extreme, not s.isBull, s.smtTxt)
        if not s.c3Model and not na(s.c3Start)
            [bx, dash, _] = drawPhaseAt(s.isBull, 3, s.c3Start, s.c3Top, s.c3Bot, s.c3Mid)
            s.c3Box  := bx
            s.c3Dash := dash
            if s.phase == 2
                if not na(s.c3Box)
                    box.set_right(s.c3Box, xAnchor(s.c4Start))
                if not na(s.c3Dash)
                    line.set_x2(s.c3Dash, xAnchor(s.c4Start))
        if s.phase == 2 and showC4 and not s.c4Suppressed and not na(s.c4Start)
            [bx4, dash4, lbl4] = drawPhaseAt(s.isBull, 4, s.c4Start, s.c4Top, s.c4Bottom, s.c4Mid, not s.c3Model)
            s.c4Box  := bx4
            s.c4Dash := dash4
            s.c4Lbl  := lbl4
            c4LabelDodge(s)
            if s.c4Invalid
                box.delete(s.c4Box)
                s.c4Box := na
                if not na(s.c4Dash)
                    line.set_color(s.c4Dash, cisdBearColor)
                    if not na(s.c4InvBar)
                        line.set_x2(s.c4Dash, xAnchor(s.c4InvBar))
                if not na(s.c4Lbl) and showXcLbl
                    label.set_text(s.c4Lbl, 'XC4')
                    label.set_textcolor(s.c4Lbl, cisdBearColor)
                else if not na(s.c4Lbl)
                    label.delete(s.c4Lbl)
                    s.c4Lbl := na
        registerRecord(s)
        printBar.set(s.isBull ? 0 : 1, bar_index)
        if showAlerts and modelAlerts
            string msg = (s.isBull ? 'Bullish ' : 'Bearish ') + (s.c3Model ? 'Candle 3' : 'Candle 2') + ' (' + s.tag + ') on ' + syminfo.ticker + ', ' + modelText()
            // a CISD inside the bar alerts on the bar's close; a model that closes already confirmed alerts at once
            if onClose
                alert(msg, alert.freq_once_per_bar_close)
            else
                alert(msg, alert.freq_once_per_bar)
    s

// [FORMATION LIQUIDITY] first bar from the level's own bar up to now that trades through it (now if none)
flEndNow(float px, int b, bool isBull) =>
    int endB = bar_index
    if not na(px) and not na(b) and b < bar_index
        int maxBack = math.min(bar_index - b, 1500)
        for off = maxBack - 1 to 0
            if isBull ? high[off] > px : low[off] < px
                endB := bar_index - off
                break
    endB

// A new model; returns it. C2 model: created when C3 opens. C3 model (C3 closure): created when C4 opens, so it
// starts in C4. Takes the swing (extreme / extremeBar), label tag, C1 sweep, the early CISD state of the closed
// candle (level, bar, already confirmed + bar), reversal SMT and the formation liquidity targets. Stores the
// T-Spot, the block candles (smtC2 / smtC3) and the formation liquidity ends. Nothing is drawn until the CISD
// confirms (see reveal); when it already confirmed inside C2 it reveals at once and replays the protected swings.
newSetup(bool isBull, bool c3Model, float extreme, int extremeBar, string tag, float c1Px, int c1Bar, int sweepEnd, float cisdLevel, int cisdIndex, bool cisdAlreadyConfirmed, int cisdConfirmBar, bool smtHit, string smtTxt, float fl1Px, int fl1Bar, float fl0Px, int fl0Bar) =>
    C2Setup s = C2Setup.new(isBull = isBull, extreme = extreme, phase = 1, dead = false, c2Lbl = na)
    s.smtHtf0    := htfNum
    s.c3Model    := c3Model
    s.c2BarIndex := extremeBar
    s.tag        := tag
    s.c1Px       := c1Px
    s.c1Bar      := c1Bar
    s.sweepEnd   := sweepEnd
    s.smtHit     := smtHit
    s.smtTxt     := smtTxt
    s.fl1Px      := fl1Px
    s.fl1Bar     := fl1Bar
    s.fl0Px      := fl0Px
    s.fl0Bar     := fl0Bar
    s.fl1EndH    := showFl ? flEndNow(fl1Px, fl1Bar, isBull) : na
    s.fl0EndH    := showFl ? flEndNow(fl0Px, fl0Bar, isBull) : na
    s.cisdLevel  := cisdLevel
    s.cisdIndex  := cisdIndex
    [top, bot, mid] = phaseGeom(isBull, not c3Model)
    if c3Model
        if htfCandles.size() > 1
            s.c3Extreme := isBull ? htfCandles.get(1).l : htfCandles.get(1).h
            s.c3Hi      := htfCandles.get(1).h
            s.c3Lo      := htfCandles.get(1).l
            // the 'C3' label sits at C3's low / high, in the middle of the C3 period
            s.lblPx     := s.c3Extreme
            s.lblBar    := na(sweepEnd) ? na : int(math.round((sweepEnd + bar_index - 1) / 2.0))
            s.c3LnBar   := isBull ? htfCandles.get(1).lBar : htfCandles.get(1).hBar
            s.smtC3     := htfCandles.get(1)
        if htfCandles.size() > 2
            s.smtC2 := htfCandles.get(2)
        s.phase    := 2
        s.c3Start  := sweepEnd
        s.c4Start  := bar_index
        s.c4Top    := top
        s.c4Bottom := bot
        s.c4Mid    := mid
    else
        // The C3 T-Spot is the part of the EQ zone (EQ <-> open) that overlaps the CISD zone: the CISD level
        // <-> the middle of the bodies of the run that made it (from the CISD candle to the extreme). No overlap
        // leaves EQ <-> open.
        if not na(cisdLevel) and not na(cisdIndex) and not na(extremeBar)
            [bLo, bHi] = cisdBodyBounds(cisdIndex, extremeBar)
            float c50  = na(bHi) ? cisdLevel : (bHi + bLo) / 2
            float oTop = math.min(top, math.max(cisdLevel, c50))
            float oBot = math.max(bot, math.min(cisdLevel, c50))
            if oTop > oBot
                top := oTop
                bot := oBot
        if htfCandles.size() > 1
            s.smtC2 := htfCandles.get(1)
        s.c3Start := bar_index
        s.c3Top   := top
        s.c3Bot   := bot
        s.c3Mid   := mid
    if cisdAlreadyConfirmed and not na(cisdLevel) and not na(cisdIndex) and not na(cisdConfirmBar)
        s.reveal()
        confirmCisd(s, cisdConfirmBar, false)
        s.replayIc(bar_index - 1)
    s

// C2 model, when C4 opens: closes the C3 T-Spot, keeps C3's range (XC4, protected swings), opens the C4
// T-Spot and sends the 'Candle 4' alert
method advanceToC4(C2Setup s) =>
    if htfCandles.size() > 1
        c3 = htfCandles.get(1)
        s.smtC3     := c3
        s.c3Extreme := s.isBull ? c3.l : c3.h
        s.c3Hi      := c3.h
        s.c3Lo      := c3.l
    if not na(s.c3Box)
        box.set_right(s.c3Box, bar_index)
    if not na(s.c3Dash)
        line.set_x2(s.c3Dash, bar_index)
    [top, bot, mid] = phaseGeom(s.isBull, false)
    s.c4Start   := bar_index
    s.c4Top     := top
    s.c4Bottom  := bot
    s.c4Mid     := mid
    s.phase     := 2
    s.c4Invalid := false
    if s.revealed and showC4
        [bx, dash, lbl] = drawPhaseAt(s.isBull, 4, bar_index, top, bot, mid, not s.c3Model)
        s.c4Box  := bx
        s.c4Dash := dash
        s.c4Lbl  := lbl
        c4LabelDodge(s)
    s

// The setup stops (finished, replaced by a newer model of its direction, or XC2): its dots can still grey until
// the HTF candle forming now closes (C5 for a finished model), then keep their color (icMarkTakenAll).
icFreeze(C2Setup s) =>
    if not na(s) and not na(s.icList)
        for ic in s.icList
            ic.liveHtf := htfOpenT

// When the candle after C4 (C5) opens: the model is finished (phase 0, endBar), its boxes / lines stop here
method finish(C2Setup s) =>
    icFreeze(s)
    // a C3 model's dots keep their color from C5 on
    if s.c3Model and not na(s.icList)
        for ic in s.icList
            ic.frozen := true
    if not na(s.c4Box)
        box.set_right(s.c4Box, bar_index)
    if not na(s.c4Dash) and not s.c4Invalid and not s.c4Suppressed
        line.set_x2(s.c4Dash, bar_index)
    if not na(s.c3Ln)
        line.set_x2(s.c3Ln, bar_index)
    s.phase  := 0
    s.endBar := bar_index
    s

method deleteStdDev(C2Setup s) =>
    if not na(s.stdDevData)
        for lb in s.stdDevData.labels
            label.delete(lb)
        for ln in s.stdDevData.lines
            line.delete(ln)
        s.stdDevData := na
    s

// Every bar for a running model: grows its T-Spot box / EQ, and checks XC2 (a close beyond the C2 extreme kills
// the model: label XC2, everything else of it deleted, block SMT lines killed, dots frozen)
method extendAndCheck(C2Setup s) =>
    if not na(s) and not s.dead and s.phase != 0
        // T-Spot box and EQ grow with price, one bar past the current bar, so a new box shows
        // on its first bar (the C4 EQ stops at an XC4)
        if s.phase == 1
            if not na(s.c3Box)
                box.set_right(s.c3Box, bar_index + 1)
            if not na(s.c3Dash)
                line.set_x2(s.c3Dash, bar_index + 1)
        else if not s.c4Invalid and not s.c4Suppressed
            if not na(s.c4Box)
                box.set_right(s.c4Box, bar_index + 1)
            if not na(s.c4Dash)
                line.set_x2(s.c4Dash, bar_index + 1)
        if s.phase == 2 and not na(s.c3Ln)
            line.set_x2(s.c3Ln, bar_index + 1)

        // XC2: price closes back beyond the swing (the C2 extreme). Label in the bearish CISD color in C3, orange in C4.
        c2Breach = s.isBull ? close < s.extreme : close > s.extreme
        if c2Breach
            if not na(s.c2Lbl) and showXcLbl
                label.set_text(s.c2Lbl, 'X' + s.tag)
                label.set_textcolor(s.c2Lbl, s.phase == 2 ? color.orange : cisdBearColor)
            else if not na(s.c2Lbl)
                label.delete(s.c2Lbl)
                s.c2Lbl := na
            box.delete(s.c3Box)
            s.c3Box := na
            line.delete(s.c3Dash)
            s.c3Dash := na
            box.delete(s.c4Box)
            s.c4Box := na
            line.delete(s.c4Dash)
            s.c4Dash := na
            label.delete(s.c4Lbl)
            s.c4Lbl := na
            line.delete(s.c1SweepLn)
            s.c1SweepLn := na
            line.delete(s.c3Ln)
            s.c3Ln := na
            // its SMT lines go too
            if not na(s.smtLns)
                for ln in s.smtLns
                    line.delete(ln)
                for lb in s.smtLbls
                    label.delete(lb)
                s.smtLns.clear()
                s.smtLbls.clear()
            s.csLn := na
            s.csLb := na
            s.smtGone := true
            s.deleteStdDev()
            htfSmtKill(s)
            icFreeze(s)
            icClearPending(s)
            s.icStopped := true
            s.dead  := true
            s.phase := 0
    s

// XC4: during C4 price trades through C3's opposite extreme (wick; bullish: below C3's low), the same event
// that stops protected swings. The box goes away and the EQ line turns red and stops there. A close beyond
// the C4 box / C3 EQ is not enough. C2 models only: a C3 model keeps its C4 box.
method checkC4Invalid(C2Setup s) =>
    if not na(s) and not s.dead and s.phase == 2 and not s.c3Model and not s.c4Invalid and not s.c4Suppressed and not na(s.c3Extreme)
        invalid = s.isBull ? low < s.c3Extreme : high > s.c3Extreme
        if invalid
            s.c4Invalid := true
            s.c4InvBar  := bar_index
            if not na(s.c4Lbl) and showXcLbl
                label.set_text(s.c4Lbl, 'XC4')
                label.set_textcolor(s.c4Lbl, cisdBearColor)
            else if not na(s.c4Lbl)
                label.delete(s.c4Lbl)
                s.c4Lbl := na
            if not na(s.c4Dash)
                line.set_color(s.c4Dash, cisdBearColor)
                line.set_x2(s.c4Dash, bar_index)
            box.delete(s.c4Box)
            s.c4Box := na
            // its SMT lines go too
            smtClear(s)
    s

// A newer opposite model in its C3 owns this HTF candle: the older model's C4 box, EQ and C4 / XC4 label are not
// drawn; its protected swings and continuation SMT go on
suppressOverlappedC4(C2Setup older, C2Setup newer) =>
    if not na(older) and not older.dead and not older.c3Model and older.phase == 2 and not older.c4Suppressed
        if not na(newer) and not newer.dead and newer.revealed and newer.phase == 1
            older.c4Suppressed := true
            box.delete(older.c4Box)
            older.c4Box := na
            line.delete(older.c4Dash)
            older.c4Dash := na
            label.delete(older.c4Lbl)
            older.c4Lbl := na
            if not na(older.icList)
                for ic in older.icList
                    ic.noEarly := true
    older

// A model still waiting for its CISD: a closed chart bar beyond the level reveals it and draws the CISD
method checkCisdConfirm(C2Setup s) =>
    if barstate.isconfirmed and not na(s) and not s.dead and not s.cisdConfirmed and s.phase != 0 and not na(s.cisdLevel) and not na(s.cisdIndex)
        confirmed = s.isBull ? close > s.cisdLevel : close < s.cisdLevel
        if confirmed
            s.reveal(true)
            confirmCisd(s, bar_index)
    s

// Called every bar for each direction; returns the current model of that direction. On a trigger: the old one
// stops (icFreeze) and a new model replaces it. Otherwise, on each new HTF candle: C3 -> C4 -> finished.
processSetup(C2Setup existing, bool trigger, bool isBull, bool c3Model, float extreme, int extremeBar, string tag, float c1Px, int c1Bar, int sweepEnd, float cisdLevel, int cisdIndex, bool cisdDone, int cisdBar, bool smtHit, string smtTxt, float fl1Px, int fl1Bar, float fl0Px, int fl0Bar) =>
    C2Setup result = existing
    if trigger
        if not na(existing) and not existing.dead and existing.phase != 0
            icFreeze(existing)
            if existing.c3Model and existing.phase == 2 and not na(existing.icList)
                for ic in existing.icList
                    ic.frozen := true
        result := newSetup(isBull, c3Model, extreme, extremeBar, tag, c1Px, c1Bar, sweepEnd, cisdLevel, cisdIndex, cisdDone, cisdBar, smtHit, smtTxt, fl1Px, fl1Bar, fl0Px, fl0Bar)
    else if periodChanged and not na(existing) and not existing.dead
        result := existing.phase == 1 ? existing.advanceToC4() : existing.phase == 2 ? existing.finish() : existing
    result

// Flags the C1 candle (idx in the block) of a model for the block's C1 sweep line and PSP
markTrigger(bool trigger, int idx, bool isBuy) =>
    if trigger and htfCandles.size() > idx
        c = htfCandles.get(idx)
        if isBuy
            c.triggerBuy := true
        else
            c.triggerSell := true

//#endregion

//#region [LOGIC]
// Runs on every bar, in this order: HTF highs / lows, early CISD levels, the HTF candle block, pair folding,
// C2 / C3 closure triggers, new models (processSetup), per-bar model checks (XC2, XC4, CISD, C4 overlap),
// SMT removal on a new print, dot greying, protected swings, early C2, alert conditions, vertical lines.

// high / low of the forming HTF candle (h0 / l0) and of the previous one (h1 / l1), from the chart bars
var float h0 = high
var float l0 = low
var float h1 = high
var float l1 = low

if periodChanged
    h1 := h0[1]
    l1 := l0[1]
    h0 := high
    l0 := low

if high >= h0
    h0 := high
if low <= l0
    l0 := low

bool up = close > open
bool dw = close < open
bool eq = close == open

// [EARLY CISD] When a closed bar makes a new low of the forming HTF candle below the previous candle's low, the
// bullish CISD level is the open of the run of bearish candles into it (bearish: mirrored). A later close through
// it is the reclaim (bullReclaimed): an early CISD while the candle forms, and at the HTF close the model's
// already-confirmed CISD (newSetup reads the [1] values).
var float bullLevelFixed = na
var int   bullIndexFixed = na
var float bearLevelFixed = na
var int   bearIndexFixed = na
var bool  bullReclaimed  = false
var int   bullReclaimBar = na
var bool  bearReclaimed  = false
var int   bearReclaimBar = na

if barstate.isconfirmed and low == l0 and low < l1 and (periodChanged or low < l0[1] or not bullReclaimed or na(bullLevelFixed))
    if periodChanged or low < l0[1]
        bullReclaimed  := false
        bullReclaimBar := na
    bullLevelFixed := na
    bullIndexFixed := na
    bool foundBull = false
    for i = 0 to math.min(300, bar_index)
        int att = close[i] > open[i] ? 1 : close[i] < open[i] ? -1 : 0
        if att == 0
            continue
        if not foundBull
            if att == -1
                foundBull      := true
                bullLevelFixed := open[i]
                bullIndexFixed := bar_index - i
        else
            if att != -1
                break
            if open[i] > bullLevelFixed
                bullLevelFixed := open[i]
                bullIndexFixed := bar_index - i

if barstate.isconfirmed and high == h0 and high > h1 and (periodChanged or high > h0[1] or not bearReclaimed or na(bearLevelFixed))
    if periodChanged or high > h0[1]
        bearReclaimed  := false
        bearReclaimBar := na
    bearLevelFixed := na
    bearIndexFixed := na
    bool foundBear = false
    for i = 0 to math.min(300, bar_index)
        int att = close[i] > open[i] ? 1 : close[i] < open[i] ? -1 : 0
        if att == 0
            continue
        if not foundBear
            if att == 1
                foundBear      := true
                bearLevelFixed := open[i]
                bearIndexFixed := bar_index - i
        else
            if att != 1
                break
            if open[i] < bearLevelFixed
                bearLevelFixed := open[i]
                bearIndexFixed := bar_index - i

bullEarlyCisdFiredThisBar = false
bearEarlyCisdFiredThisBar = false

invalidateEarlyCisd(bullEarlyCisdRecords, true)
invalidateEarlyCisd(bearEarlyCisdRecords, false)

bullPeriodSweep = l0 < l1
bearPeriodSweep = h0 > h1

newBullLevel = not na(bullIndexFixed) and (na(bullIndexFixed[1]) or bullIndexFixed != bullIndexFixed[1])
if newBullLevel or na(bullLevelFixed)
    bullReclaimed  := false
    bullReclaimBar := na
if barstate.isconfirmed and not na(bullLevelFixed) and not bullReclaimed and close > bullLevelFixed
    bullReclaimed  := true
    bullReclaimBar := bar_index
    if showC2 and bullPeriodSweep and validTf and inTimeFilter and biasBuyOk
        drawEarlyCisd(true, bullLevelFixed, bullIndexFixed, bar_index, l0)
        bullEarlyCisdFiredThisBar := true

newBearLevel = not na(bearIndexFixed) and (na(bearIndexFixed[1]) or bearIndexFixed != bearIndexFixed[1])
if newBearLevel or na(bearLevelFixed)
    bearReclaimed  := false
    bearReclaimBar := na
if barstate.isconfirmed and not na(bearLevelFixed) and not bearReclaimed and close < bearLevelFixed
    bearReclaimed  := true
    bearReclaimBar := bar_index
    if showC2 and bearPeriodSweep and validTf and inTimeFilter and biasSellOk
        drawEarlyCisd(false, bearLevelFixed, bearIndexFixed, bar_index, h0)
        bearEarlyCisdFiredThisBar := true


candleOffset = candleOffsetIn + 10

// [HTF CANDLES] a new HTF candle on periodChanged (the oldest one beyond HTF Candles is dropped and kept in
// gone*), otherwise the forming one follows the chart bar
if validTf
    if periodChanged
        if htfCandles.size() > 0
            newest             = htfCandles.first()
            state.prevHigh    := newest.h
            state.prevLow     := newest.l
        htfCandles.unshift(newHtfCandle(htfOpenT))
        while htfCandles.size() > htfCandleCount
            HtfCandle gone = htfCandles.pop()
            goneH    := gone.h
            goneL    := gone.l
            goneHBar := gone.hBar
            goneLBar := gone.lBar
            gone.delete()
        htfOpenBar := bar_index
        htfOpenBars.unshift(bar_index)
        if htfOpenBars.size() > 5
            htfOpenBars.pop()
    else if htfCandles.size() > 0
        htfCandles.set(0, htfCandles.first().update(high, low, close, bar_index))

var int prevP1BarT = na
var int prevP1HtfT = na
var int prevP2BarT = na
var int prevP2HtfT = na

// a new pair bar on this chart bar (a pair with another session, like DXY, repeats its last bar while it is closed)
bool p1Fresh = pairBarsOn and pairFresh(p1H, p1BT, p1HT, prevP1BarT, prevP1HtfT, htfOpenT, periodChanged)
bool p2Fresh = pairBarsOn and pairFresh(p2H, p2BT, p2HT, prevP2BarT, prevP2HtfT, htfOpenT, periodChanged)

// [HTF SMT / PSP] fold this bar's pair high / low / open / close into the forming HTF candle
if validTf and (show_smt or showPsp) and htfCandles.size() > 0
    HtfCandle htfNow = htfCandles.first()
    if p1Fresh
        htfNow.pH := na(htfNow.pH) ? p1H : math.max(htfNow.pH, p1H)
        htfNow.pL := na(htfNow.pL) ? p1L : math.min(htfNow.pL, p1L)
        htfNow.pO := na(htfNow.pO) ? p1O : htfNow.pO
        htfNow.pC := p1C
    if p2Fresh
        htfNow.qH := na(htfNow.qH) ? p2H : math.max(htfNow.qH, p2H)
        htfNow.qL := na(htfNow.qL) ? p2L : math.min(htfNow.qL, p2L)
        htfNow.qO := na(htfNow.qO) ? p2O : htfNow.qO
        htfNow.qC := p2C

// C2 closure, read when the next HTF candle opens: the candle that just closed took the previous candle's
// low / high and its last trade (the chart's close, not a futures settlement) is back inside. The HTF highs /
// lows are the ones built from the chart bars (h0 / l0 / h1 / l1), like the HTF candles on the right.
bool c2Buy  = l0 < l1 and close > l1
bool c2Sell = h0 > h1 and close < h1
if periodChanged
    state.prevC2Buy  := c2Buy[1]
    state.prevC2Sell := c2Sell[1]

c2BuyTrigger  = periodChanged and state.prevC2Buy
c2SellTrigger = periodChanged and state.prevC2Sell

// [PSP] the new candle was just added: get(1) = C2, get(2) = C1
bool pspHit = false
if showPsp and periodChanged and htfCandles.size() > 2
    HtfCandle own2 = htfCandles.get(1)
    HtfCandle own1 = htfCandles.get(2)
    pspHit := htfPsp(own1, own2)

bool setupOk = calcOn and validTf and inTimeFilter and not hideSetups
bool buyOk   = biasBuyOk and setupOk
bool sellOk  = biasSellOk and setupOk

// [C3 CLOSURE] when C4 opens: C2 (get(2)) took C1's low (get(3)) without closing back inside (so no C2
// model), then C3 (get(1)) stayed above C2's low and closed above C2's body. Bearish: the mirror.
bool c3BuyTrigger  = false
bool c3SellTrigger = false
if periodChanged and htfCandles.size() > 3
    HtfCandle k3 = htfCandles.get(1)
    HtfCandle k2 = htfCandles.get(2)
    HtfCandle k1 = htfCandles.get(3)
    c3BuyTrigger  := k2.l < k1.l and k2.c <= k1.l and k3.l >= k2.l and k3.c > math.max(k2.o, k2.c)
    c3SellTrigger := k2.h > k1.h and k2.c >= k1.h and k3.h <= k2.h and k3.c < math.min(k2.o, k2.c)

// [HTF SMT] the candle that just closed: was it a C2 or the C3 of a C3 closure (block SMT lines follow these roles)
if periodChanged and htfCandles.size() > 1
    HtfCandle closedC = htfCandles.get(1)
    closedC.c2BullClosed := state.prevC2Buy
    closedC.c2BearClosed := state.prevC2Sell
    closedC.c3BullClosed := c3BuyTrigger
    closedC.c3BearClosed := c3SellTrigger

// the C2 / C3 checkboxes choose the model types (C4 = the C4 continuation)
bool c2BuyGo  = c2BuyTrigger and buyOk and showC2
bool c2SellGo = c2SellTrigger and sellOk and showC2
bool c3BuyGo  = c3BuyTrigger and buyOk and showC3 and not c2BuyGo
bool c3SellGo = c3SellTrigger and sellOk and showC3 and not c2SellGo

// Clear temporary early-C2 drawings before new setups allocate drawings on the HTF close
if periodChanged
    deleteSetupVisuals(earlyBuy)
    earlyBuy  := na
    deleteSetupVisuals(earlySell)
    earlySell := na
    earlyBullArmed      := false
    earlyBearArmed      := false
    earlyBullSmtAlerted := false
    earlyBearSmtAlerted := false

if (c2BuyGo or c3BuyGo) and bullReclaimed[1]
    consumeLastEarlyCisd(bullEarlyCisdRecords, bullReclaimBar[1])
if (c2SellGo or c3SellGo) and bearReclaimed[1]
    consumeLastEarlyCisd(bearEarlyCisdRecords, bearReclaimBar[1])

htfAt(int idx) =>
    htfCandles.size() > idx ? htfCandles.get(idx) : na
openBarAt(int idx) =>
    htfOpenBars.size() > idx ? htfOpenBars.get(idx) : na
// [FORMATION LIQUIDITY] target side of one HTF candle (bullish: its high)
flPick(int idx, bool isBull) =>
    HtfCandle c = htfAt(idx)
    bool gonePick = na(c) and idx == htfCandles.size()
    [gonePick ? (isBull ? goneH : goneL) : na(c) ? na : isBull ? c.h : c.l, gonePick ? (isBull ? goneHBar : goneLBar) : na(c) ? na : isBull ? c.hBar : c.lBar]

// [PSP] for a C3 model: its C1 (get(3)) and C2 (get(2)) against the pair's same candles
bool psp3Hit = false
if showPsp and (c3BuyGo or c3SellGo) and htfCandles.size() > 3
    psp3Hit := htfPsp(htfCandles.get(3), htfCandles.get(2))
string c3Tag = c3BuyGo or c3SellGo ? 'C3' + (psp3Hit ? '+PSP' : '') : ''

// [NEW MODELS] C2 model: C2 = get(1), C1 = get(2). C3 model: C2 = get(2), C1 = get(3).
// Only runs on periodChanged (triggers and phase transitions only ever happen when a new HTF candle opens).
if periodChanged
    // Reversal SMT of a C2 model: our symbol swept C1 (that is what makes it a C2), a pair did not sweep its own C1
    [c2SmtB1, c2SmtB2] = earlySmtFlags(true, htfAt(1), htfAt(2))
    [c2SmtS1, c2SmtS2] = earlySmtFlags(false, htfAt(1), htfAt(2))
    if c2BuyGo or c3BuyGo or not na(buySetup)
        int       bI1 = c3BuyGo ? 3 : 2
        HtfCandle bK1 = (c2BuyGo or c3BuyGo) ? htfAt(bI1) : na
        HtfCandle bK2 = (c2BuyGo or c3BuyGo) ? htfAt(bI1 - 1) : na
        float bF1p = na, int bF1b = na, float bF0p = na, int bF0b = na
        if c2BuyGo or c3BuyGo
            [_p1, _b1] = flPick(bI1, true)
            [_p0, _b0] = flPick(bI1 + 1, true)
            bF1p := _p1, bF1b := _b1, bF0p := _p0, bF0b := _b0
        buySetup := processSetup(buySetup, c2BuyGo or c3BuyGo, true, c3BuyGo, na(bK2) ? na : bK2.l, na(bK2) ? na : bK2.lBar, not (c2BuyGo or c3BuyGo) ? '' : c3BuyGo ? c3Tag : c2TagText(pspHit), na(bK1) ? na : bK1.l, na(bK1) ? na : bK1.lBar, c3BuyGo ? openBarAt(1) : bar_index, bullLevelFixed[1], bullIndexFixed[1], bullReclaimed[1], bullReclaimBar[1], c2BuyGo and (c2SmtB1 or c2SmtB2), c2BuyGo or c3BuyGo ? smtNames(c2SmtB1, c2SmtB2) : '', bF1p, bF1b, bF0p, bF0b)
        if (c2BuyGo or c3BuyGo) and not na(buySetup) and not na(bK2)
            buySetup.c2P1 := bK2.pL
            buySetup.c2P2 := bK2.qL
            buySetup.csStart := c3BuyGo ? openBarAt(1) : bar_index

    if c2SellGo or c3SellGo or not na(sellSetup)
        int       sI1 = c3SellGo ? 3 : 2
        HtfCandle sK1 = (c2SellGo or c3SellGo) ? htfAt(sI1) : na
        HtfCandle sK2 = (c2SellGo or c3SellGo) ? htfAt(sI1 - 1) : na
        float sF1p = na, int sF1b = na, float sF0p = na, int sF0b = na
        if c2SellGo or c3SellGo
            [_p1, _b1] = flPick(sI1, false)
            [_p0, _b0] = flPick(sI1 + 1, false)
            sF1p := _p1, sF1b := _b1, sF0p := _p0, sF0b := _b0
        sellSetup := processSetup(sellSetup, c2SellGo or c3SellGo, false, c3SellGo, na(sK2) ? na : sK2.h, na(sK2) ? na : sK2.hBar, not (c2SellGo or c3SellGo) ? '' : c3SellGo ? c3Tag : c2TagText(pspHit), na(sK1) ? na : sK1.h, na(sK1) ? na : sK1.hBar, c3SellGo ? openBarAt(1) : bar_index, bearLevelFixed[1], bearIndexFixed[1], bearReclaimed[1], bearReclaimBar[1], c2SellGo and (c2SmtS1 or c2SmtS2), c2SellGo or c3SellGo ? smtNames(c2SmtS1, c2SmtS2) : '', sF1p, sF1b, sF0p, sF0b)
        if (c2SellGo or c3SellGo) and not na(sellSetup) and not na(sK2)
            sellSetup.c2P1 := sK2.pH
            sellSetup.c2P2 := sK2.qH
            sellSetup.csStart := c3SellGo ? openBarAt(1) : bar_index

if not na(p1H)
    prevP1BarT := p1BT
    prevP1HtfT := p1HT
if not na(p2H)
    prevP2BarT := p2BT
    prevP2HtfT := p2HT

// HTF candle flags (C1 sweep line and PSP on the model block): the same models, but Hide Setups keeps them
bool htfMarkOk  = calcOn and validTf and inTimeFilter
bool c2BuyMark  = c2BuyTrigger and showC2 and biasBuyOk and htfMarkOk
bool c3BuyMark  = c3BuyTrigger and showC3 and biasBuyOk and htfMarkOk and not c2BuyMark
bool c2SellMark = c2SellTrigger and showC2 and biasSellOk and htfMarkOk
bool c3SellMark = c3SellTrigger and showC3 and biasSellOk and htfMarkOk and not c2SellMark
markTrigger(c2BuyMark or c3BuyMark, c3BuyMark ? 3 : 2, true)
markTrigger(c2SellMark or c3SellMark, c3SellMark ? 3 : 2, false)

// Heads-up: the HTF candle closed and formed a model (C2 or C3 closure), its CISD has not come yet.
// Only in the "Add Alert" dialog list, not in "Any alert() function call".
alertcondition((c2BuyGo or c3BuyGo) and not bullReclaimed[1] and showAlerts and modelAlerts, title = 'Bullish C2/C3 Closure', message = 'Bullish C2/C3 closed on {{ticker}} ({{interval}}), waiting for CISD')
alertcondition((c2SellGo or c3SellGo) and not bearReclaimed[1] and showAlerts and modelAlerts, title = 'Bearish C2/C3 Closure', message = 'Bearish C2/C3 closed on {{ticker}} ({{interval}}), waiting for CISD')

// per-bar checks of the current models: XC2, XC4, CISD confirmation, then the older model's C4 under a newer C3.
// Both directions finish each step before the next one: a CISD confirmation reveals its model, and the reveal
// can push the other direction's model out of the history, so its XC2 / XC4 check has to run first.
if not na(buySetup) and not buySetup.dead and buySetup.phase != 0
    buySetup  := buySetup.extendAndCheck()
if not na(sellSetup) and not sellSetup.dead and sellSetup.phase != 0
    sellSetup := sellSetup.extendAndCheck()
if not na(buySetup) and not buySetup.dead and buySetup.phase == 2 and not buySetup.c3Model and not buySetup.c4Invalid and not buySetup.c4Suppressed
    buySetup  := buySetup.checkC4Invalid()
if not na(sellSetup) and not sellSetup.dead and sellSetup.phase == 2 and not sellSetup.c3Model and not sellSetup.c4Invalid and not sellSetup.c4Suppressed
    sellSetup := sellSetup.checkC4Invalid()
if not na(buySetup) and not buySetup.dead and not buySetup.cisdConfirmed
    buySetup  := buySetup.checkCisdConfirm()
if not na(sellSetup) and not sellSetup.dead and not sellSetup.cisdConfirmed
    sellSetup := sellSetup.checkCisdConfirm()

if not na(buySetup) and not na(sellSetup)
    if not buySetup.dead and buySetup.phase == 2 and not buySetup.c4Suppressed and not sellSetup.dead and sellSetup.phase == 1 and sellSetup.revealed
        buySetup  := suppressOverlappedC4(buySetup, sellSetup)
    if not sellSetup.dead and sellSetup.phase == 2 and not sellSetup.c4Suppressed and not buySetup.dead and buySetup.phase == 1 and buySetup.revealed
        sellSetup := suppressOverlappedC4(sellSetup, buySetup)

if showAlerts and modelAlerts and showC4
    if not na(buySetup) and buySetup.revealed and not buySetup.dead and not buySetup.c3Model and not buySetup.c4Suppressed and buySetup.phase == 2 and buySetup.c4Start == bar_index
        alert('Bullish Candle 4 on ' + syminfo.ticker + ', ' + modelText(), alert.freq_once_per_bar)
    if not na(sellSetup) and sellSetup.revealed and not sellSetup.dead and not sellSetup.c3Model and not sellSetup.c4Suppressed and sellSetup.phase == 2 and sellSetup.c4Start == bar_index
        alert('Bearish Candle 4 on ' + syminfo.ticker + ', ' + modelText(), alert.freq_once_per_bar)

// [SMT] a model that prints removes the SMT lines of older models whose C4 has closed. A model replaced by a
// newer one of its own direction before its C4 closed keeps them. On the bar a C4 closes, only a bullish print
// removes them (from a bearish model).
if printBar.get(0) == bar_index or printBar.get(1) == bar_index
    bool bullNow = printBar.get(0) == bar_index
    for r in setupRecords
        C2Setup o = r.setup
        if not o.dead and not o.smtGone and o.phase == 0 and not na(o.endBar)
            if o.endBar < bar_index or (bullNow and not o.isBull)
                smtClear(o)

// check every persistent dot against the current bar BEFORE new dots can form on it
icMarkTakenAll(htfOpenT, htfNum)

if not na(buySetup)
    buySetup  := buySetup.updateIc()
if not na(sellSetup)
    sellSetup := sellSetup.updateIc()

// [EARLY C2] temporary reversal SMT + dotted protected swings while C2 is still forming.
// Runs after periodChanged cleanup and after htfCandles / pair folding, so same-bar periodChanged + early CISD works cleanly.
// kept while Show Early C2 CISD is on, or (drawing nothing) for the early protected swing alert
bool earlySetupOn = showEarlyCisd or (showAlerts and earlyCisdAlerts and protAlerts)
// buyOk / sellOk: a bias or time filter that turns off while C2 forms drops the early setup too
if not bullReclaimed or not buyOk
    earlyBullArmed      := false
    earlyBullSmtAlerted := false
if not bearReclaimed or not sellOk
    earlyBearArmed      := false
    earlyBearSmtAlerted := false

if not na(earlyBuy) and (not earlySetupOn or not buyOk or not bullReclaimed or low < earlyBuy.extreme)
    deleteSetupVisuals(earlyBuy)
    earlyBuy := na
if not na(earlySell) and (not earlySetupOn or not sellOk or not bearReclaimed or high > earlySell.extreme)
    deleteSetupVisuals(earlySell)
    earlySell := na

if bullEarlyCisdFiredThisBar and barstate.isconfirmed
    earlyBullArmed      := buyOk
    earlyBullSmtAlerted := false
    if earlySetupOn and buyOk and htfCandles.size() > 1
        deleteSetupVisuals(earlyBuy)
        earlyBuy := newEarlySetup(true, htfCandles.first(), htfCandles.get(1), bullLevelFixed, bullIndexFixed, bar_index)
if bearEarlyCisdFiredThisBar and barstate.isconfirmed
    earlyBearArmed      := sellOk
    earlyBearSmtAlerted := false
    if earlySetupOn and sellOk and htfCandles.size() > 1
        deleteSetupVisuals(earlySell)
        earlySell := newEarlySetup(false, htfCandles.first(), htfCandles.get(1), bearLevelFixed, bearIndexFixed, bar_index)

if htfCandles.size() > 1
    HtfCandle eCur  = htfCandles.first()
    HtfCandle ePrev = htfCandles.get(1)
    updateEarlySmt(earlyBuy, eCur, ePrev)
    updateEarlySmt(earlySell, eCur, ePrev)
    // Early SMT alerts follow the alert toggles, independent of the visual Show Early C2 CISD toggle
    if barstate.isconfirmed and showAlerts and smtAlerts and earlyCisdAlerts and showC2 and calcOn and validTf and not hideSetups
        if earlyBullArmed and bullReclaimed and bullPeriodSweep and not earlyBullSmtAlerted
            [ed1, ed2] = earlySmtFlags(true, eCur, ePrev)
            if ed1 or ed2
                earlyBullSmtAlerted := true
                alert('Bullish Early SMT Divergence on ' + syminfo.ticker + ', ' + modelText(), alert.freq_once_per_bar_close)
        if earlyBearArmed and bearReclaimed and bearPeriodSweep and not earlyBearSmtAlerted
            [ed1, ed2] = earlySmtFlags(false, eCur, ePrev)
            if ed1 or ed2
                earlyBearSmtAlerted := true
                alert('Bearish Early SMT Divergence on ' + syminfo.ticker + ', ' + modelText(), alert.freq_once_per_bar_close)

earlyBuy  := earlyBuy.updateIc()
earlySell := earlySell.updateIc()

// a CISD inside the bar only counts on the bar's close (a wick through the level that comes back would
// alert on every bar otherwise)
if not na(buySetup) and buySetup.justConfirmed
    cisdBullFiredThisBar := barstate.isconfirmed
    buySetup.justConfirmed := false

if not na(sellSetup) and sellSetup.justConfirmed
    cisdBearFiredThisBar := barstate.isconfirmed
    sellSetup.justConfirmed := false

// the CISD already confirmed inside C2: the model shows up confirmed at the closure (no C2/C3 Closure alert then)
if (c2BuyGo or c3BuyGo) and bullReclaimed[1]
    cisdBullFiredThisBar := true
if (c2SellGo or c3SellGo) and bearReclaimed[1]
    cisdBearFiredThisBar := true

// Separate alert conditions: in TradingView's "Add Alert" dialog pick one of these
// instead of "Any alert() function call" to set the CISD alerts up on their own (C2/C3 Closure is above).
alertcondition(bullEarlyCisdFiredThisBar and barstate.isconfirmed and showAlerts and earlyCisdAlerts and not hideSetups and calcOn, title = 'Bullish Early CISD', message = 'Bullish Early CISD on {{ticker}} ({{interval}})')
alertcondition(bearEarlyCisdFiredThisBar and barstate.isconfirmed and showAlerts and earlyCisdAlerts and not hideSetups and calcOn, title = 'Bearish Early CISD', message = 'Bearish Early CISD on {{ticker}} ({{interval}})')
alertcondition(cisdBullFiredThisBar and showAlerts and modelAlerts and not hideSetups and calcOn, title = 'Bullish CISD Confirmed', message = 'Bullish CISD Confirmed on {{ticker}} ({{interval}})')
alertcondition(cisdBearFiredThisBar and showAlerts and modelAlerts and not hideSetups and calcOn, title = 'Bearish CISD Confirmed', message = 'Bearish CISD Confirmed on {{ticker}} ({{interval}})')

// vertical line at each HTF open (as many as HTF Candles)
float vLineSpan = math.max(ta.tr(true), syminfo.mintick)
if showVlines and validTf and periodChanged and calcOn
    vLines.unshift(line.new(bar_index, low - vLineSpan, bar_index, high + vLineSpan, xloc.bar_index, extend.both, lineColor, lineStyleFromStr(lineStyle), lineWidth))
    while vLines.size() > htfCandleCount
        line.delete(vLines.pop())


//#endregion


// [FORMATION LIQUIDITY] the target side of the C1 candle and of the candle before it (bullish:
// their highs, bearish: their lows). A line starts where that high / low printed and ends at the bar
// that trades through it; an untaken one runs to the last bar. Levels already taken before the swing
// are not targets. Redrawn on the last bar: the latest revealed live bull / bear model in history live (flDraw),
// older revealed live models in history with the end fixed when they formed (flLineOld).
var array<line> flLines = array.new<line>()
// Loops read these up to ~1500 bars back; reserving the history up front keeps a realtime bar
// from asking for more than the buffer chosen on historical bars (runtime error on candle close).
max_bars_back(high, 1500)
max_bars_back(low, 1500)
max_bars_back(open, 1500)
max_bars_back(close, 1500)
// Drawings anchored far back (ADR lines from the day's first bar: ~1400 bars on 1m) need the bar's
// time: without this, every new realtime bar asks one bar further than the buffer chosen on history.
max_bars_back(time, 5000)

// one live target line from bar b at px to the first bar that traded through it (or the last bar); none when
// that happened before the swing (swingBar)
flLine(float px, int b, bool isBull, int swingBar) =>
    if not na(px) and not na(b) and b < bar_index
        // untaken: runs to the last bar
        int  endB    = bar_index
        int  maxBack = math.min(bar_index - b, 1500)
        for off = maxBack - 1 to 0
            if isBull ? high[off] > px : low[off] < px
                endB := bar_index - off
                break
        if endB > nz(swingBar, b)
            flLines.push(line.new(xAnchor(b), px, endB, px, xloc = xloc.bar_index, color = flColor, style = lineStyleFromStr(flStyle), width = flWidth))

flDraw(C2Setup s) =>
    if not na(s) and s.revealed and not s.dead
        flLine(s.fl1Px, s.fl1Bar, s.isBull, s.c2BarIndex)
        flLine(s.fl0Px, s.fl0Bar, s.isBull, s.c2BarIndex)

// an older model in the history: its end (endB) was fixed when it formed (flEndNow)
flLineOld(float px, int b, int endB, int swingBar) =>
    if not na(px) and not na(b) and not na(endB) and endB > nz(swingBar, b) and endB > xAnchor(b)
        flLines.push(line.new(xAnchor(b), px, endB, px, xloc = xloc.bar_index, color = flColor, style = lineStyleFromStr(flStyle), width = flWidth))

if barstate.islast
    for ln in flLines
        line.delete(ln)
    flLines.clear()
    if showFl and validTf and setupRecords.size() > 0
        int liveBullIdx = na
        int liveBearIdx = na
        bool seenBull = false
        bool seenBear = false
        for i = setupRecords.size() - 1 to 0
            C2Setup o = setupRecords.get(i).setup
            if o.revealed
                if o.isBull and not seenBull
                    seenBull := true
                    if not o.dead
                        liveBullIdx := i
                else if not o.isBull and not seenBear
                    seenBear := true
                    if not o.dead
                        liveBearIdx := i
            if seenBull and seenBear
                break
        if not na(liveBullIdx)
            flDraw(setupRecords.get(liveBullIdx).setup)
        if not na(liveBearIdx)
            flDraw(setupRecords.get(liveBearIdx).setup)
        for i = 0 to setupRecords.size() - 1
            if (na(liveBullIdx) or i != liveBullIdx) and (na(liveBearIdx) or i != liveBearIdx)
                C2Setup o = setupRecords.get(i).setup
                if o.revealed and not o.dead
                    flLineOld(o.fl1Px, o.fl1Bar, o.fl1EndH, o.c2BarIndex)
                    flLineOld(o.fl0Px, o.fl0Bar, o.fl0EndH, o.c2BarIndex)

// [L/H LINES] each HTF candle's high and low on the chart, over that candle's own period
var array<line> lhHi = array.new<line>()
var array<line> lhLo = array.new<line>()
if showLH and validTf and calcOn and htfCandles.size() > 0
    HtfCandle cNow = htfCandles.first()
    if periodChanged or lhHi.size() == 0
        lhHi.unshift(line.new(bar_index, cNow.h, bar_index, cNow.h, xloc = xloc.bar_index, color = lhColor, style = lineStyleFromStr(lhStyle), width = lhWidth))
        lhLo.unshift(line.new(bar_index, cNow.l, bar_index, cNow.l, xloc = xloc.bar_index, color = lhColor, style = lineStyleFromStr(lhStyle), width = lhWidth))
        while lhHi.size() > htfCandleCount
            line.delete(lhHi.pop())
            line.delete(lhLo.pop())
    else
        line.set_xy1(lhHi.first(), xAnchor(line.get_x1(lhHi.first())), cNow.h)
        line.set_xy2(lhHi.first(), bar_index, cNow.h)
        line.set_xy1(lhLo.first(), xAnchor(line.get_x1(lhLo.first())), cNow.l)
        line.set_xy2(lhLo.first(), bar_index, cNow.l)

//#region [PLOT]
// Drawings refreshed on the last bar: the model HTF block (candles, HTF Open, Previous EQ, C1 sweep, block SMT,
// PSP, live sweep, title), the HTF 1 / HTF 2 blocks, Info Table, ADR+ / ADR- lines, warnings. At the end the
// chart SMT of the running models (continuation SMT and the wick breach rule), which runs on every bar.

// One horizontal line, created / moved / removed
hzLine(line ln, bool on, int x1, float y, int x2, color c, string st, int w) =>
    line l = ln
    if on and not na(x1) and not na(y) and not na(x2)
        if na(l)
            l := line.new(xAnchor(x1), y, x2, y, xloc = xloc.bar_index, color = c, style = lineStyleFromStr(st), width = w)
        else
            line.set_xy1(l, xAnchor(x1), y)
            line.set_xy2(l, x2, y)
            line.set_color(l, c)
            line.set_style(l, lineStyleFromStr(st))
            line.set_width(l, w)
    else if not na(l)
        line.delete(l)
        l := na
    l

var line prevEqLn = na

// [EXTRA HTF] drawings of the HTF 1 / HTF 2 blocks (and the timeframe titles), redrawn on the last bar.
// Pooled: each redraw moves the drawings of the previous one (in the order they are drawn) instead of
// deleting and creating them; xUsed counts the boxes / lines / labels used so far, the rest is deleted after.
var array<box>   xBoxes  = array.new<box>()
var array<line>  xLines  = array.new<line>()
var array<label> xLabels = array.new<label>()
var array<int>   xUsed   = array.from(0, 0, 0)

xLine(int x1, float y1, int x2, float y2, color c, string st, int w) =>
    int i = xUsed.get(1)
    if i < xLines.size()
        line l = xLines.get(i)
        line.set_xy1(l, x1, y1)
        line.set_xy2(l, x2, y2)
        line.set_color(l, c)
        line.set_style(l, lineStyleFromStr(st))
        line.set_width(l, w)
    else
        xLines.push(line.new(x1, y1, x2, y2, xloc = xloc.bar_index, color = c, style = lineStyleFromStr(st), width = w))
    xUsed.set(1, i + 1)

xBox(int left, float top, int right, float bot, color border, color bg) =>
    int i = xUsed.get(0)
    if i < xBoxes.size()
        box b = xBoxes.get(i)
        box.set_lefttop(b, left, top)
        box.set_rightbottom(b, right, bot)
        box.set_border_color(b, border)
        box.set_bgcolor(b, bg)
    else
        xBoxes.push(box.new(left, top, right, bot, border_color = border, border_width = 1, bgcolor = bg))
    xUsed.set(0, i + 1)

xLabel(int x, float y, string txt, string st, color tc, bool bold = false, bool big = false, string tip = '') =>
    int i = xUsed.get(2)
    if i < xLabels.size()
        label b = xLabels.get(i)
        label.set_xy(b, x, y)
        label.set_text(b, txt)
        label.set_style(b, st)
        label.set_textcolor(b, tc)
        label.set_size(b, big ? textSize(labelSize) : smallerSize(labelSize))
        label.set_text_formatting(b, bold ? text.format_bold : text.format_none)
        label.set_tooltip(b, tip)
    else
        xLabels.push(label.new(x, y, txt, xloc = xloc.bar_index, yloc = yloc.price, style = st, color = na, textcolor = tc, size = big ? textSize(labelSize) : smallerSize(labelSize), text_font_family = font.family_default, text_formatting = bold ? text.format_bold : text.format_none, tooltip = tip))
    xUsed.set(2, i + 1)

// Block title: the timeframe (bold, dark) and, under it, the time left in brackets (gray), over the block's highest
// high, under its lowest low (mirrored: time first), or both (a line lower when the time labels sit below).
// Two labels so each line keeps its own color; blank lines stack them. One size above the time labels.
// padTop / padBot: a PSP label sits at the block's high / low on that side, so the title moves one line out over it.
// openT: the forming candle's open (HTF 1 / HTF 2), for a timeframe that is not a whole number of chart bars
xTitle(int x, float top, float bot, string tf, bool padTop = false, bool padBot = false, int openT = na) =>
    string nm     = showHtfName ? tfLabel(tf) : ''
    int    tfSec  = timeframe.in_seconds(tf)
    int    nowMs  = barstate.isrealtime ? timenow : time_close
    int    candT  = not na(openT) and tfSec < 86400 ? openT + tfSec * 1000 : na
    int    closeT = not na(candT) and candT > nowMs ? candT : htfCloseTime(tf)
    string tm     = showHtfTimer ? '(' + formatRemaining(closeT - nowMs) + ')' : ''
    bool   both = nm != '' and tm != ''
    if nm != '' or tm != ''
        if htfNamePos != 'Bottom'
            string post = padTop ? '\n ' : ''
            if nm != ''
                xLabel(x, top, nm + (both ? '\n ' : '') + post, label.style_label_down, htfNameColor, true, true)
            if tm != ''
                xLabel(x, top, tm + post, label.style_label_down, htfInfoColor, false, true)
        if htfNamePos != 'Top'
            string pre = (showHtfStamps ? ' \n' : '') + (padBot ? ' \n' : '')
            if tm != ''
                xLabel(x, bot, pre + tm, label.style_label_up, htfInfoColor, false, true)
            if nm != ''
                xLabel(x, bot, pre + (both ? ' \n' : '') + nm, label.style_label_up, htfNameColor, true, true)

// HTF PSP label at the candle's high / low (under a candle the time stamp comes first). When the candle makes the
// block's high (low) and the block title sits on that side, the label is anchored at the block's high (low) and the
// title moves out over it (atTitle -> xTitle padTop / padBot), so PSP stays next to the candles and the time stays readable.
pspPlace(bool below, float y, float top, float bot) =>
    bool  titleSide = below ? htfNamePos != 'Top' : htfNamePos != 'Bottom'
    float tol       = (top - bot) * 0.06
    bool  atTitle   = titleSide and (showHtfName or showHtfTimer) and (below ? y <= bot + tol : y >= top - tol)
    string txt      = below and showHtfStamps ? ' \nPSP' : 'PSP'
    [atTitle ? (below ? bot : top) : y, txt, atTitle]

xAligned(array<int> dt, XData p) =>
    bool ok = false
    if not na(dt) and dt.size() > 0 and not na(p) and not na(p.t) and p.t.size() > 0
        for k = 0 to dt.size() - 1
            if p.t.indexof(dt.get(k)) >= 0
                ok := true
                break
    ok

// A pair's candle with the same open time (else the same position when schedules differ), flipped for an inverse pair
xPair(XData p, bool inv, int i, int t, bool aligned) =>
    float h = na
    float l = na
    float o = na
    float c = na
    if not na(p) and not na(p.t) and p.t.size() > 0
        int j = p.t.indexof(t)
        if j < 0 and not aligned and i < p.t.size()
            j := i
        if j >= 0
            h := inv ? -p.l.get(j) : p.h.get(j)
            l := inv ? -p.h.get(j) : p.l.get(j)
            o := inv ? -p.o.get(j) : p.o.get(j)
            c := inv ? -p.c.get(j) : p.c.get(j)
    [h, l, o, c]

// One block starting at bar 'left'; returns its right edge. Same look and rules as the model block:
// sweep = a candle takes the previous high / low and closes back inside (the forming one while it is back
// inside), SMT between consecutive candles, PSP on the two candles of a closed sweep.
xBlock(XData d, XData p, XData q, bool pInv, bool qInv, int left, string tf) =>
    int n     = na(d) or na(d.o) ? 0 : d.o.size()
    int right = left
    if n > 0
        bool         pAlign = xAligned(d.t, p)
        bool         qAlign = xAligned(d.t, q)
        array<int>   mids = array.new<int>(n, 0)
        array<float> cs   = d.c.copy()
        int tfSec = timeframe.in_seconds(tf)
        bool formingCur = barstate.isrealtime or tfSec >= 86400 or (d.t.get(0) + tfSec * 1000 > time_close)
        if formingCur
            cs.set(0, close)   // like the model block: the chart's last trade, not a futures settlement
        array<float> ph = array.new<float>(n, na)
        array<float> pl = array.new<float>(n, na)
        array<float> po = array.new<float>(n, na)
        array<float> pc = array.new<float>(n, na)
        array<float> qh = array.new<float>(n, na)
        array<float> ql = array.new<float>(n, na)
        array<float> qo = array.new<float>(n, na)
        array<float> qc = array.new<float>(n, na)
        float top = na
        float bot = na
        for i = n - 1 to 0
            int   mid  = left + candleSpacing * (n - 1 - i) + htfHalf
            float o    = d.o.get(i)
            float h    = d.h.get(i)
            float l    = d.l.get(i)
            float c    = cs.get(i)
            bool  bull = c >= o
            mids.set(i, mid)
            xLine(mid, h, mid, math.max(o, c), bull ? wickBull : wickBear, 'Solid', 1)
            xLine(mid, l, mid, math.min(o, c), bull ? wickBull : wickBear, 'Solid', 1)
            xBox(mid - htfHalf, math.max(o, c), mid + htfHalf, math.min(o, c), bull ? borderBull : borderBear, bull ? bullBody : bearBody)
            top := na(top) ? h : math.max(top, h)
            bot := na(bot) ? l : math.min(bot, l)
            if showHtfStamps
                xLabel(mid, l, htfStampText(d.t.get(i), tf), label.style_label_up, htfInfoColor)
            [a1, b1, c1, d1] = xPair(p, pInv, i, d.t.get(i), pAlign)
            ph.set(i, a1)
            pl.set(i, b1)
            po.set(i, c1)
            pc.set(i, d1)
            [a2, b2, c2, d2] = xPair(q, qInv, i, d.t.get(i), qAlign)
            qh.set(i, a2)
            ql.set(i, b2)
            qo.set(i, c2)
            qc.set(i, d2)
        right := mids.get(0) + htfHalf

        // no HTF Open here: only the model HTF's open is drawn
        if showPrevEq and dtHtf and n > 1
            for i = n - 1 to 1
                float eqPx = (d.h.get(i) + d.l.get(i)) / 2
                xLine(mids.get(i), eqPx, mids.get(i - 1), eqPx, prevEqColor, prevEqStyle, prevEqWidth)

        // sweeps: older candle i, newer i - 1 (i - 1 = 0 is the forming candle: live sweep)
        array<bool> pspLo = array.new<bool>(n, false)
        array<bool> pspHi = array.new<bool>(n, false)
        if n > 1
            for i = n - 1 to 1
                float oldH  = d.h.get(i)
                float oldL  = d.l.get(i)
                float newC  = cs.get(i - 1)
                bool  bullS = allowBuy and d.l.get(i - 1) < oldL and newC > oldL
                bool  bearS = allowSell and d.h.get(i - 1) > oldH and newC < oldH
                int   endX  = mids.get(i - 1) + htfHalf * 2 + 2
                if sweepOnHtf and bullS
                    xLine(mids.get(i), oldL, endX, oldL, sweepColor, sweepStyle, sweepWidth)
                if sweepOnHtf and bearS
                    xLine(mids.get(i), oldH, endX, oldH, sweepColor, sweepStyle, sweepWidth)
                // PSP once the sweeping candle has closed: C1 = i, C2 = i - 1
                if showPsp and i >= 2 and (bullS or bearS)
                    for j = i - 1 to i
                        bool chk = j == i ? pspMode != 'Candle 2' : pspMode != 'Candle 1'
                        if chk and (pspDiff(d.o.get(j), cs.get(j), po.get(j), pc.get(j)) or pspDiff(d.o.get(j), cs.get(j), qo.get(j), qc.get(j)))
                            if bullS
                                pspLo.set(j, true)
                            else
                                pspHi.set(j, true)
        bool xPadTop = false
        bool xPadBot = false
        for j = 0 to n - 1
            if pspLo.get(j) or pspHi.get(j)
                bool below = pspLo.get(j)
                [py, ptxt, pAt] = pspPlace(below, below ? d.l.get(j) : d.h.get(j), top, bot)
                if pAt
                    if below
                        xPadBot := true
                    else
                        xPadTop := true
                bool   d1  = pspDiff(d.o.get(j), cs.get(j), po.get(j), pc.get(j))
                bool   d2  = pspDiff(d.o.get(j), cs.get(j), qo.get(j), qc.get(j))
                string tip = 'PSP: ' + (d1 ? statusSym(pair1Name) : '') + (d1 and d2 ? ' + ' : '') + (d2 ? statusSym(pair2Name) : '')
                xLabel(mids.get(j), py, ptxt, below ? label.style_label_up : label.style_label_down, c2c3c4Color, tip = tip)

        // SMT between consecutive candles, per pair; hidden once a newer candle trades beyond it
        if smtOnHtf
            float newerH = na
            float newerL = na
            for i = 0 to n - 1
                float ch   = d.h.get(i)
                float cl   = d.l.get(i)
                bool  bear = false
                bool  bull = false
                if i < n - 1
                    float oh = d.h.get(i + 1)
                    float ol = d.l.get(i + 1)
                    if not na(ph.get(i)) and not na(ph.get(i + 1))
                        bear := (ch > oh and ph.get(i) < ph.get(i + 1)) or (ch < oh and ph.get(i) > ph.get(i + 1))
                        bull := (cl < ol and pl.get(i) > pl.get(i + 1)) or (cl > ol and pl.get(i) < pl.get(i + 1))
                    if not na(qh.get(i)) and not na(qh.get(i + 1))
                        bear := bear or (ch > oh and qh.get(i) < qh.get(i + 1)) or (ch < oh and qh.get(i) > qh.get(i + 1))
                        bull := bull or (cl < ol and ql.get(i) > ql.get(i + 1)) or (cl > ol and ql.get(i) < ql.get(i + 1))
                    if not na(newerH) and newerH > math.max(ch, oh)
                        bear := false
                    if not na(newerL) and newerL < math.min(cl, ol)
                        bull := false
                    if bear
                        xLine(mids.get(i + 1), oh, mids.get(i), ch, smtColorFor(true), smtStyle, smtWidth)
                    if bull
                        xLine(mids.get(i + 1), ol, mids.get(i), cl, smtColorFor(false), smtStyle, smtWidth)
                newerH := na(newerH) ? ch : math.max(newerH, ch)
                newerL := na(newerL) ? cl : math.min(newerL, cl)

        xTitle(int(math.round((left + right) / 2.0)), top, bot, tf, xPadTop, xPadBot, d.t.get(0))
    right

if barstate.islast
    xUsed.fill(0)

// where HTF 1 / HTF 2 start: right of the model block, or right of the chart when the model block is not drawn
int xStart = bar_index + candleOffset

if barstate.islast and validTf and htfCandles.size() > 0 and hideHtf
    HtfCandle cur0 = htfCandles.first()
    htfOpenLn := hzLine(htfOpenLn, showHtfOpen and dtChart, htfOpenBar, cur0.o, bar_index, htfOpenColor, htfOpenStyle, htfOpenWidth)
    float prevEqPx = htfCandles.size() > 1 ? (htfCandles.get(1).h + htfCandles.get(1).l) / 2 : na
    prevEqLn := hzLine(prevEqLn, showPrevEq and dtChart, htfOpenBar, prevEqPx, bar_index, prevEqColor, prevEqStyle, prevEqWidth)

if barstate.islast and validTf and htfCandles.size() > 0 and not hideHtf
    n = htfCandles.size()
    for i = n - 1 to 0
        htfCandles.get(i).draw(bar_index + candleOffset + candleSpacing * (n - 1 - i) + htfHalf, autoTf)
    HtfCandle cur0 = htfCandles.first()
    int blockLeft  = htfCandles.get(n - 1).midX - htfHalf
    int blockRight = cur0.midX + htfHalf

    // HTF Open (current HTF candle) by Drawings Type
    int lx1 = dtChart ? htfOpenBar : blockLeft
    int lx2 = dtHtf ? blockRight : bar_index
    htfOpenLn := hzLine(htfOpenLn, showHtfOpen, lx1, cur0.o, lx2, htfOpenColor, htfOpenStyle, htfOpenWidth)
    // Previous EQ on the chart: the middle of the last closed HTF candle, from the current candle's open
    float prevEqPx = n > 1 ? (htfCandles.get(1).h + htfCandles.get(1).l) / 2 : na
    prevEqLn := hzLine(prevEqLn, showPrevEq and dtChart, htfOpenBar, prevEqPx, bar_index, prevEqColor, prevEqStyle, prevEqWidth)


    // Previous EQ and Candle 1 Sweep on the HTF candles
    for i = n - 1 to 0
        HtfCandle c = htfCandles.get(i)
        if i > 0
            line.set_x2(c.eqLine, htfCandles.get(i - 1).midX)
        else
            line.set_color(c.eqLine, noColor)
        int sweepEndX = i > 0 ? htfCandles.get(i - 1).midX + htfHalf * 2 + 2 : na
        if sweepOnHtf and i > 0 and c.triggerBuy
            if na(c.sweepLine)
                c.sweepLine := line.new(c.midX, c.l, sweepEndX, c.l, color = sweepColor, style = lineStyleFromStr(sweepStyle), width = sweepWidth)
            else
                line.set_xy1(c.sweepLine, c.midX, c.l)
                line.set_xy2(c.sweepLine, sweepEndX, c.l)
                line.set_color(c.sweepLine, sweepColor)
                line.set_style(c.sweepLine, lineStyleFromStr(sweepStyle))
                line.set_width(c.sweepLine, sweepWidth)
        else if not na(c.sweepLine)
            line.delete(c.sweepLine)
            c.sweepLine := na
        if sweepOnHtf and i > 0 and c.triggerSell
            if na(c.sweepLineSell)
                c.sweepLineSell := line.new(c.midX, c.h, sweepEndX, c.h, color = sweepColor, style = lineStyleFromStr(sweepStyle), width = sweepWidth)
            else
                line.set_xy1(c.sweepLineSell, c.midX, c.h)
                line.set_xy2(c.sweepLineSell, sweepEndX, c.h)
                line.set_color(c.sweepLineSell, sweepColor)
                line.set_style(c.sweepLineSell, lineStyleFromStr(sweepStyle))
                line.set_width(c.sweepLineSell, sweepWidth)
        else if not na(c.sweepLineSell)
            line.delete(c.sweepLineSell)
            c.sweepLineSell := na

    // [HTF SMT] divergence between consecutive HTF candles (i = newer, i + 1 = older), per pair. Strict: one
    // makes the higher high, the other a lower high (equal is not SMT). Only the model part of the block:
    //   i = 0: the forming candle (live)
    //   i = 1: ends on a closed C2, on the C3 of a C3 closure, or on the C3 after a C2 (continuation)
    //   i = 2: ends on a C2 (C2 model in C4, or the C2 of a C3 closure in C4)
    // Later (C5 on) it is gone. Hidden once a newer candle trades beyond the C2 extreme, or when its model's
    // XC2 / XC4 / C2 wick breach removed its chart SMT.
    bool  htfSmtOn = smtOnHtf and (pair1Name != '' or pair2Name != '')
    for i = 0 to n - 1
        HtfCandle cur  = htfCandles.get(i)
        HtfCandle prev = i < n - 1 ? htfCandles.get(i + 1) : na
        bool bear1 = false
        bool bull1 = false
        bool bear2 = false
        bool bull2 = false
        if htfSmtOn and not na(prev) and i <= 2
            HtfCandle nextC = i > 0 ? htfCandles.get(i - 1) : na
            bool nextC3Bear = not na(nextC) and nextC.c3BearClosed
            bool nextC3Bull = not na(nextC) and nextC.c3BullClosed
            bool bearRev  = i == 0 or (i == 1 ? (cur.c2BearClosed or cur.c3BearClosed) : (cur.c2BearClosed or nextC3Bear))
            bool bearCont = i == 1 and prev.c2BearClosed and not cur.c2BearClosed and not cur.c3BearClosed
            bool bullRev  = i == 0 or (i == 1 ? (cur.c2BullClosed or cur.c3BullClosed) : (cur.c2BullClosed or nextC3Bull))
            bool bullCont = i == 1 and prev.c2BullClosed and not cur.c2BullClosed and not cur.c3BullClosed
            if (bearRev or bearCont) and not cur.smtBearDead
                if not na(cur.pH) and not na(prev.pH)
                    bear1 := (cur.h < prev.h and cur.pH > prev.pH) or (bearRev and cur.h > prev.h and cur.pH < prev.pH)
                if not na(cur.qH) and not na(prev.qH)
                    bear2 := (cur.h < prev.h and cur.qH > prev.qH) or (bearRev and cur.h > prev.h and cur.qH < prev.qH)
            if (bullRev or bullCont) and not cur.smtBullDead
                if not na(cur.pL) and not na(prev.pL)
                    bull1 := (cur.l > prev.l and cur.pL < prev.pL) or (bullRev and cur.l < prev.l and cur.pL > prev.pL)
                if not na(cur.qL) and not na(prev.qL)
                    bull2 := (cur.l > prev.l and cur.qL < prev.qL) or (bullRev and cur.l < prev.l and cur.qL > prev.qL)
            if i > 0 and (bear1 or bear2 or bull1 or bull2)
                float newerH = na
                float newerL = na
                for k = 0 to i - 1
                    HtfCandle nc = htfCandles.get(k)
                    newerH := na(newerH) ? nc.h : math.max(newerH, nc.h)
                    newerL := na(newerL) ? nc.l : math.min(newerL, nc.l)
                // the C2 extreme: this candle when it is the C2, else the older one (continuation)
                float c2RefH = cur.c2BearClosed or nextC3Bear ? cur.h : prev.h
                float c2RefL = cur.c2BullClosed or nextC3Bull ? cur.l : prev.l
                if newerH > c2RefH
                    bear1 := false
                    bear2 := false
                if newerL < c2RefL
                    bull1 := false
                    bull2 := false
        int   x1 = na(prev) ? cur.midX : prev.midX
        float yH = na(prev) ? cur.h : prev.h
        float yL = na(prev) ? cur.l : prev.l
        cur.smtHLine := smtHtfSeg(cur.smtHLine, bear1 or bear2, x1, yH, cur.midX, cur.h, true)
        cur.smtLLine := smtHtfSeg(cur.smtLLine, bull1 or bull2, x1, yL, cur.midX, cur.l, false)

    // block high / low (title and PSP placement)
    float mTop = na
    float mBot = na
    for i = 0 to n - 1
        mTop := na(mTop) ? htfCandles.get(i).h : math.max(mTop, htfCandles.get(i).h)
        mBot := na(mBot) ? htfCandles.get(i).l : math.min(mBot, htfCandles.get(i).l)

    bool mPadTop = false
    bool mPadBot = false
    // [PSP] on the C1 / C2 HTF candles of setups: the candle closes a different color than a pair's same candle
    for i = 0 to n - 1
        HtfCandle c = htfCandles.get(i)
        bool pspBull = false
        bool pspBear = false
        bool pspD1   = pspDiff(c.o, c.c, c.pO, c.pC)
        bool pspD2   = pspDiff(c.o, c.c, c.qO, c.qC)
        if showPsp
            // C1 carries the setup's trigger flag, C2 is the next (newer) candle
            for side = 0 to 1
                bool isBullSide = side == 0
                // this candle as C1 (its own flag) or as C2 (the older candle's flag)
                bool asC1 = i > 0 and (isBullSide ? c.triggerBuy : c.triggerSell) and pspMode != 'Candle 2'
                bool asC2 = i < n - 1 and (isBullSide ? htfCandles.get(i + 1).triggerBuy : htfCandles.get(i + 1).triggerSell) and pspMode != 'Candle 1'
                if (asC1 or asC2) and (pspD1 or pspD2)
                    if isBullSide
                        pspBull := true
                    else
                        pspBear := true
        if pspBull or pspBear
            bool  below = pspBull
            [y, txt, pAt] = pspPlace(below, below ? c.l : c.h, mTop, mBot)
            if pAt
                if below
                    mPadBot := true
                else
                    mPadTop := true
            string tip  = 'PSP: ' + (pspD1 ? statusSym(pair1Name) : '') + (pspD1 and pspD2 ? ' + ' : '') + (pspD2 ? statusSym(pair2Name) : '')
            if na(c.pspLbl)
                c.pspLbl := label.new(c.midX, y, txt, xloc = xloc.bar_index, yloc = yloc.price, style = below ? label.style_label_up : label.style_label_down, color = na, textcolor = c2c3c4Color, size = smallerSize(labelSize), text_font_family = font.family_default, tooltip = tip)
            else
                label.set_xy(c.pspLbl, c.midX, y)
                label.set_text(c.pspLbl, txt)
                label.set_tooltip(c.pspLbl, tip)
                label.set_style(c.pspLbl, below ? label.style_label_up : label.style_label_down)
                label.set_textcolor(c.pspLbl, c2c3c4Color)
        else if not na(c.pspLbl)
            label.delete(c.pspLbl)
            c.pspLbl := na

    // the forming candle's sweep only where its close could make a C2 model (same filters as the closed line)
    bool liveOk = showC2 and calcOn and validTf
    updateLiveSweeps(htfCandles, liveOk and biasBuyOk, liveOk and biasSellOk)

    // block title (HTF Label + Remaining Time); HTF 1 / HTF 2 start to its right
    xTitle(int(math.round((blockLeft + blockRight) / 2.0)), mTop, mBot, autoTf, mPadTop, mPadBot)
    xStart := blockRight + candleSpacing + 3

// [EXTRA HTF] HTF 1 / HTF 2 (also with Hide? or on a chart without a fractal)
if barstate.islast and (x1On or x2On)
    // a block that would end past the 500-bar drawing limit right of the last bar is left out
    int xLeft = xStart
    if x1On and xLeft + x1Count * candleSpacing + 12 <= bar_index + 495
        xLeft := xBlock(x1D, x1P, x1Q, pair1InvOn, pair2InvOn, xLeft, x1Tf) + candleSpacing + 3
    if x2On and xLeft + x2Count * candleSpacing + 12 <= bar_index + 495
        xBlock(x2D, x2P, x2Q, pair1InvOn, pair2InvOn, xLeft, x2Tf)

// [EXTRA HTF] pooled drawings this redraw did not use
if barstate.islast
    while xBoxes.size() > xUsed.get(0)
        box.delete(xBoxes.pop())
    while xLines.size() > xUsed.get(1)
        line.delete(xLines.pop())
    while xLabels.size() > xUsed.get(2)
        label.delete(xLabels.pop())

// NY trading day start (see [NY DAY]), used only by the ADR+ / ADR- lines
var int adrDayStartBar = na
if adrLinesShow and nyNewDay(dayStartH, dayIsCrypto)
    adrDayStartBar := bar_index

fmtPts(float v) =>
    adrIsFx ? str.tostring(v / adrPip, '#.0') + ' pips' : str.tostring(v, format.mintick) + ' pts'

// [INFO TABLE] one centered column, a few short rows
tbl_sz        = textSize(tbl_text_size)
tbl_dim_color = color.new(tbl_text_color, 45)
tblBg         = tbl_style == 'Text' ? noColor : tbl_bg_color
tblFrame      = tbl_border ? color.new(tbl_text_color, 75) : noColor

var table infoTbl = na
if barstate.islast
    // layout:  ES1! (1H) / 1H-1D Model / 01:00:00 / Bias: Neutral / SMT(Auto): NQ1!, YM1!  (+ ADR, date)
    array<string> rows = array.new<string>()
    array<color>  clrs = array.new<color>()
    array<string> szs  = array.new<string>()
    string head = tbl_asset ? syminfo.ticker : ''
    if tbl_ctf
        head := head == '' ? tfLabel(curTfCode()) : head + ' (' + tfLabel(curTfCode()) + ')'
    if head != ''
        rows.push(head)
        clrs.push(tblHeadColor)
        szs.push(tbl_sz)
    if tbl_fractal
        rows.push(validTf ? tfLabel(ltfCode()) + '-' + tfLabel(autoTf) + ' Model' : 'No Model')
        clrs.push(validTf ? tbl_text_color : tbl_dim_color)
        szs.push(tbl_sz)
    if tbl_ttc and validTf
        rows.push(formatHms(htfCloseTime(autoTf) - (barstate.isrealtime ? timenow : time_close)))
        clrs.push(tblHeadColor)
        szs.push(biggerSize(tbl_text_size))
    if tbl_bias
        bool   bullish = biasNow == 'Bullish'
        bool   bearish = biasNow == 'Bearish'
        rows.push('Bias: ' + biasNow + (abSteps > 0 ? ' (AB' + str.tostring(abSteps) + ' ' + tfLabel(abLtf) + '-' + tfLabel(abHtf) + ')' : ''))
        clrs.push(bullish ? cisdBullColor : bearish ? cisdBearColor : biasNow == 'None' ? tbl_dim_color : tbl_text_color)
        szs.push(tbl_sz)
    if tbl_tfilter and useTimeFilter
        rows.push('Filter: ' + (not timeFilterActive ? 'not used' : inTimeFilter ? 'open' : 'closed'))
        clrs.push(timeFilterActive and inTimeFilter ? tbl_text_color : tbl_dim_color)
        szs.push(tbl_sz)
    if tbl_smt
        string smtTxt = ''
        if pair1Name != ''
            smtTxt := statusSym(pair1Name) + (pair1Seen ? '' : ' (no data)')
        if pair2Name != ''
            smtTxt := (smtTxt == '' ? '' : smtTxt + ', ') + statusSym(pair2Name) + (pair2Seen ? '' : ' (no data)')
        bool smtOff = not show_smt and not showPsp
        // a symbol without automatic pairs (DXY, 6J, a stock) shows no SMT row
        if smtOff or smtCustom or smtTxt != ''
            rows.push('SMT(' + (smtCustom ? 'Custom' : 'Auto') + '): ' + (smtOff ? 'Off' : smtTxt == '' ? 'n/a' : smtTxt))
            clrs.push(smtOff or smtTxt == '' ? tbl_dim_color : tbl_text_color)
            szs.push(tbl_sz)
    // ADR 655.3 pts · 62%  (the % is today's range, CDR, as a share of ADR)
    if adrShow and not na(adrVal) and adrVal > 0 and not na(adrDayH) and not na(adrDayL)
        rows.push('ADR ' + fmtPts(adrVal) + ' · ' + str.tostring((adrDayH - adrDayL) / adrVal * 100, '0') + '%')
        clrs.push(tbl_text_color)
        szs.push(tbl_sz)
    if tbl_date
        rows.push(str.format_time(time_close, 'MMM dd yyyy', syminfo.timezone))
        clrs.push(tbl_text_color)
        szs.push(tbl_sz)

    if not na(infoTbl)
        table.delete(infoTbl)
        infoTbl := na
    if tbl_show and rows.size() > 0
        infoTbl := table.new(tablePosition(tbl_pos_vert, tbl_pos_horiz), 1, rows.size(), bgcolor = tblBg, border_color = noColor, border_width = 0, frame_color = tblFrame, frame_width = tbl_border ? 1 : 0)
        for r = 0 to rows.size() - 1
            table.cell(infoTbl, 0, r, rows.get(r), text_color = clrs.get(r), bgcolor = tblBg, text_size = szs.get(r), text_halign = text.align_center, text_font_family = font.family_default, text_formatting = r == 0 and head != '' ? text.format_bold : text.format_none)

var line  adrUpLn  = na
var line  adrDnLn  = na
var label adrUpLbl = na
var label adrDnLbl = na
if barstate.islast
    bool adrLnOk = adrLinesShow and not na(adrVal) and adrVal > 0 and not na(adrDayStartBar) and not na(adrDayH) and not na(adrDayL)
    if adrLnOk
        float upPx = adrDayL + adrVal
        float dnPx = adrDayH - adrVal
        int   x2   = bar_index + candleOffset - 3
        // an HTF block starts right of x2: the label sits above the line's end instead of running into the block
        bool  blk  = (validTf and htfCandles.size() > 0 and not hideHtf) or x1On or x2On
        lblSt      = blk ? label.style_label_lower_right : label.style_label_left
        if na(adrUpLn)
            adrUpLn  := line.new(xAnchor(adrDayStartBar), upPx, x2, upPx, xloc = xloc.bar_index, color = adrLineColor, style = lineStyleFromStr(adrLineStyle))
            adrDnLn  := line.new(xAnchor(adrDayStartBar), dnPx, x2, dnPx, xloc = xloc.bar_index, color = adrLineColor, style = lineStyleFromStr(adrLineStyle))
            adrUpLbl := label.new(x2, upPx, 'ADR+', xloc = xloc.bar_index, style = lblSt, color = na, textcolor = adrLineColor, size = size.small, text_font_family = font.family_default)
            adrDnLbl := label.new(x2, dnPx, 'ADR-', xloc = xloc.bar_index, style = lblSt, color = na, textcolor = adrLineColor, size = size.small, text_font_family = font.family_default)
        else
            line.set_xy1(adrUpLn, xAnchor(adrDayStartBar), upPx)
            line.set_xy2(adrUpLn, x2, upPx)
            line.set_xy1(adrDnLn, xAnchor(adrDayStartBar), dnPx)
            line.set_xy2(adrDnLn, x2, dnPx)
            label.set_xy(adrUpLbl, x2, upPx)
            label.set_xy(adrDnLbl, x2, dnPx)
            label.set_style(adrUpLbl, lblSt)
            label.set_style(adrDnLbl, lblSt)
    else if not na(adrUpLn)
        line.delete(adrUpLn)
        line.delete(adrDnLn)
        label.delete(adrUpLbl)
        label.delete(adrDnLbl)
        adrUpLn  := na
        adrDnLn  := na
        adrUpLbl := na
        adrDnLbl := na


// [WARNINGS] short message at the top of the chart
var table warnTbl = na
if barstate.islast
    string msg = ''
    if not validTf
        string mLbl = modelType == 'Custom' ? modelText() : modelType
        msg := 'Fractal ' + mLbl + ' does not work on the ' + tfLabel(curTfCode()) + ' chart.'
    if (show_smt or showPsp) and pair1Name == '' and pair2Name == ''
        msg := (msg == '' ? '' : msg + '\n') + 'No correlated pair for ' + syminfo.ticker + '. Set one in Asset Correlation > Custom.'
    if (show_smt or showPsp) and pair1Name != '' and not pair1Seen
        msg := (msg == '' ? '' : msg + '\n') + 'No data for ' + statusSym(pair1Name) + '.'
    if (show_smt or showPsp) and pair2Name != '' and not pair2Seen
        msg := (msg == '' ? '' : msg + '\n') + 'No data for ' + statusSym(pair2Name) + '.'
    if not na(warnTbl)
        table.delete(warnTbl)
        warnTbl := na
    if showWarn and msg != ''
        warnTbl := table.new(position.top_center, 1, 1, bgcolor = color.new(color.red, 85), frame_color = color.new(color.red, 50), frame_width = 1)
        table.cell(warnTbl, 0, 0, msg, text_color = color.red, text_size = size.small, text_font_family = font.family_default)

// ============================================================
// [SMT] ON CHART: continuation SMT inside a live setup
// ============================================================
// SMT on the chart belongs to a setup: the reversal SMT (C1 -> C2) is drawn when the model reveals. The
// continuation SMT: after the C2 candle a pair goes beyond its own C2 candle's extreme while we stay
// inside ours (bullish: a pair makes a lower low, we a higher low). The line joins our C2 extreme and our
// bar at that moment; from then the end slides to our further extremes (still not beyond C2).
// One line per setup, live until the setup ends.
// the alert works without the chart drawing (SMT Display = HTF Candles); drawing stays with smtOnChart
bool smtAlertOn = show_smt and showAlerts and smtAlerts and not hideSetups
bool smtBufOn   = (smtOnChart or smtAlertOn) and (pair1Name != '' or pair2Name != '')
smt_on = smtBufOn and calcOn

// only a fresh pair bar counts: a repeated old bar (the pair closed, our symbol trading) is not new data
float p1BarH = p1Fresh ? p1H : na
float p1BarL = p1Fresh ? p1L : na
float p2BarH = p2Fresh ? p2H : na
float p2BarL = p2Fresh ? p2L : na
// The pairs' bar highs / lows of the last bars, kept in arrays: a function that only runs on some bars
// cannot read a series' history (it would see the values of its earlier calls).
SMT_BUF = 400
var array<float> pBuf1H = array.new<float>()
var array<float> pBuf1L = array.new<float>()
var array<float> pBuf2H = array.new<float>()
var array<float> pBuf2L = array.new<float>()
// only filled when the chart SMT can use them (warm-up included, so the replay sees the same bars)
if smtBufOn
    pBuf1H.push(p1BarH)
    pBuf1L.push(p1BarL)
    pBuf2H.push(p2BarH)
    pBuf2L.push(p2BarL)
    if pBuf1H.size() > SMT_BUF
        pBuf1H.shift()
        pBuf1L.shift()
        pBuf2H.shift()
        pBuf2L.shift()

// beyond = further in the setup's direction of the extreme (bearish: higher, bullish: lower)
f_beyond(bool isHigh, float a, float b) =>
    not na(a) and not na(b) and (isHigh ? a > b : a < b)

// one bar of the continuation SMT check: the pairs' run since C2, and from the first bar where a pair
// is beyond its C2-time extreme while we are not, our extreme (the line's end)
f_csStep(C2Setup s, bool isHigh, float own, int ownBar, float v1, float v2) =>
    if na(s.csRun1) or f_beyond(isHigh, v1, s.csRun1)
        s.csRun1 := v1
    if na(s.csRun2) or f_beyond(isHigh, v2, s.csRun2)
        s.csRun2 := v2
    bool ok = not na(own) and not f_beyond(isHigh, own, s.extreme) and own != s.extreme
    if not s.csDiv and not na(own) and not ok
        s.csTook := true
    // our own extreme since csStart (not only since the divergence bar): the line ends there, then slides on
    if ok and (s.csDiv or not s.csTook) and (na(s.csOwnPx) or f_beyond(isHigh, own, s.csOwnPx))
        s.csOwnPx  := own
        s.csOwnBar := ownBar
    if not s.csDiv and ok and not s.csTook and (f_beyond(isHigh, s.csRun1, s.c2P1) or f_beyond(isHigh, s.csRun2, s.c2P2))
        s.csDiv := true
    s

// Every bar for the current bull / bear model: on its first bar replays the bars since csStart from the pBuf
// arrays, then one step per bar while in C3; once a pair diverged it alerts once and draws / slides the line.
f_smtCont(C2Setup s) =>
    if smt_on and not na(s) and not s.dead and not s.smtGone and s.phase != 0 and not na(s.c2BarIndex) and not na(s.extreme)
        bool isHigh = not s.isBull
        int  start  = s.csStart
        if not na(start) and bar_index >= start
            // The check runs over C3 only (C2 -> C3, like the HTF candles); C4 adds no new step.
            if not s.csInit
                // first bar of the check: replay the bars since the C2 candle closed (C3 model: C3, up to the bar
                // before C4 opened)
                int n    = pBuf1H.size()
                int endX = s.c3Model ? bar_index - 1 : bar_index
                if endX >= start
                    for x = math.max(start, bar_index - n + 1) to endX
                        int   off = bar_index - x
                        float v1  = (isHigh ? pBuf1H : pBuf1L).get(n - 1 - off)
                        float v2  = (isHigh ? pBuf2H : pBuf2L).get(n - 1 - off)
                        f_csStep(s, isHigh, isHigh ? high[off] : low[off], x, v1, v2)
                s.csInit := true
            else if s.phase == 1
                f_csStep(s, isHigh, isHigh ? high : low, bar_index, isHigh ? p1BarH : p1BarL, isHigh ? p2BarH : p2BarL)
            bool d1 = s.csDiv and f_beyond(isHigh, s.csRun1, s.c2P1)
            bool d2 = s.csDiv and f_beyond(isHigh, s.csRun2, s.c2P2)
            if s.revealed and (d1 or d2)
                string txt = smtNames(d1, d2)
                if not s.csAlerted
                    s.csAlerted := true
                    if smtAlertOn
                        alert((isHigh ? 'Bearish' : 'Bullish') + ' SMT Divergence on ' + syminfo.ticker + ', ' + modelText(), alert.freq_once_per_bar_close)
                if smtOnChart and na(s.csLn)
                    smtDrawOn(s, s.c2BarIndex, s.extreme, s.csOwnBar, s.csOwnPx, isHigh, txt)
                    s.csLn := s.smtLns.last()
                    s.csLb := txt != '' and s.smtLbls.size() > 0 ? s.smtLbls.last() : na
                else if smtOnChart
                    int ax2 = xAnchor(s.csOwnBar)
                    if line.get_x2(s.csLn) != ax2 or line.get_y2(s.csLn) != s.csOwnPx
                        line.set_xy2(s.csLn, ax2, s.csOwnPx)
                        if not na(s.csLb)
                            label.set_xy(s.csLb, int(math.round((xAnchor(s.c2BarIndex) + ax2) / 2.0)), (s.extreme + s.csOwnPx) / 2)
                    if not na(s.csLb) and label.get_text(s.csLb) != txt
                        label.set_text(s.csLb, txt)
    s

// The first wick beyond a setup's C2 extreme, from the setup until the end of C5 (C3 model: from C4), removes
// all its SMT lines (reversal and continuation); the label stays unless the close goes through too (XC2).
// Checked inline (a function call per record and bar was a hot spot): the history records, then the current
// models, which may have left the history while still running (their block SMT goes too).
if show_smt
    if setupRecords.size() > 0
        for r in setupRecords
            C2Setup s = r.setup
            if not s.smtGone and not na(s.smtHtf0) and not na(s.extreme) and htfNum - s.smtHtf0 < (s.c3Model ? 2 : 3)
                if s.isBull ? low < s.extreme : high > s.extreme
                    smtClear(s)
    if not na(buySetup) and not buySetup.smtGone and not na(buySetup.smtHtf0) and not na(buySetup.extreme) and htfNum - buySetup.smtHtf0 < (buySetup.c3Model ? 2 : 3)
        if low < buySetup.extreme
            smtClear(buySetup)
    if not na(sellSetup) and not sellSetup.smtGone and not na(sellSetup.smtHtf0) and not na(sellSetup.extreme) and htfNum - sellSetup.smtHtf0 < (sellSetup.c3Model ? 2 : 3)
        if high > sellSetup.extreme
            smtClear(sellSetup)

if smt_on
    if not na(buySetup) and not buySetup.dead and not buySetup.smtGone and buySetup.phase != 0
        f_smtCont(buySetup)
    if not na(sellSetup) and not sellSetup.dead and not sellSetup.smtGone and sellSetup.phase != 0
        f_smtCont(sellSetup)

//#endregion
